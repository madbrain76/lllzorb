class Error(Exception):
    pass


class LockBusy(Error):
    pass


def lock_directory():
    LOCK_DIRECTORY.mkdir(mode=0o700,exist_ok=True)
    info=LOCK_DIRECTORY.lstat()
    require(stat.S_ISDIR(info.st_mode) and info.st_uid==os.geteuid() and not info.st_mode & 0o077,
            'Unsafe lock directory: '+str(LOCK_DIRECTORY))
    return LOCK_DIRECTORY


@contextlib.contextmanager
def file_lock(path,shared=False,wait=False,description='Resource',reentrant=False):
    key=str(path)
    held=[mode for path,mode in ACTIVE_LOCKS.values() if path==key]
    if reentrant and held:
        require(shared or not any(held),description+' is already open for shared use')
        yield
        return
    fd=os.open(path,os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW|os.O_CLOEXEC,0o600)
    try:
        require(stat.S_ISREG(os.fstat(fd).st_mode),'Lock is not a regular file: '+key)
        try:
            fcntl.flock(fd,(fcntl.LOCK_SH if shared else fcntl.LOCK_EX)|(0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            raise LockBusy(description+' is in use by another operation') from None
        ACTIVE_LOCKS[fd]=(key,shared)
        try:yield
        finally:ACTIVE_LOCKS.pop(fd,None)
    finally:
        # Do not unlock explicitly: a surviving child must retain its lease.
        os.close(fd)


def local_lock(key,**kwargs):
    name=hashlib.sha256(key.encode()).hexdigest()+'.lock'
    return file_lock(lock_directory()/name,**kwargs)


def device_lock(device,shared=False):
    # Resolve every hardware alias to the same preferred ID for locking only.
    identity=stable_device(os.path.realpath(device))
    return local_lock('device:'+identity,shared=shared,reentrant=True,description='Disk '+str(device))


def backup_writer_lock(device):
    identity=stable_device(os.path.realpath(device))
    return local_lock('backup-writer:'+identity,description='Backup disk '+str(device))


@contextlib.contextmanager
def restore_target_lock(device):
    if RESTORE_LOCKS is not None:
        RESTORE_LOCKS.enter_context(device_lock(device))
        yield
    else:
        with device_lock(device):yield


def lock_fds():
    return {'pass_fds':tuple(sorted(ACTIVE_LOCKS))} if ACTIVE_LOCKS else {}


def locked_popen(*args,**kwargs):
    return subprocess.Popen(*args,**lock_fds(),**kwargs)


def locked_run(*args,**kwargs):
    return subprocess.run(*args,**lock_fds(),**kwargs)


class Cancelled(Exception):
    pass


class ReinitializeDestroyedPool(Error):
    """Destroyed pool identified; caller must require destructive confirmation."""
    pass


def require(condition, message):
    if not condition:
        raise Error(message)


def run(*args, check=True, combined=False, live=False, **kw):
    args = [str(x) for x in args]
    if args[0] in ('zfs','zpool','umount','ssh'):
        UNREAPED_TRANSFERS[:] = [p for p in UNREAPED_TRANSFERS if p.poll() is None]
        require(not UNREAPED_TRANSFERS, 'Transfer processes have not exited; leaving pools imported. '
                'Skipping '+shlex.join(args))
    if LOG:
        LOG.write('+ ' + ' '.join(args) + '\n')
        LOG.flush()
    with diagnostic_command(args):
        result = locked_run(args, stdout=None if live else subprocess.PIPE,
                                stderr=None if live else subprocess.PIPE,
                                env={**os.environ, 'LC_ALL': 'C'}, **kw)
        diagnostic_event(f'command exit={result.returncode}: {shlex.join(args)[:2048]}')
        if result.stderr:
            diagnostic_event('command stderr: '+result.stderr.decode(errors='replace').strip())
    if check and result.returncode:
        detail=(result.stderr or b'').decode(errors='replace').strip() or f'exit status {result.returncode}'
        raise Error(f"{' '.join(args)}: {detail}")
    # Linux filenames and device metadata may contain non-UTF-8 bytes.
    # Preserve them losslessly rather than rejecting output or changing identities.
    return ((result.stdout or b'') + ((result.stderr or b'') if combined else b'')).decode('utf-8',errors='surrogateescape')


def commands(names):
    missing = [x for x in names.split() if not shutil.which(x)]
    require(not missing, 'Missing required commands: ' + ', '.join(missing))


def compression_method(value):
    methods={'on','off','lz4','lzjb','zle','gzip','zstd','zstd-fast'}
    methods.update('gzip-'+str(i) for i in range(1,10))
    methods.update('zstd-'+str(i) for i in range(1,20))
    methods.update('zstd-fast-'+str(i) for i in [*range(1,11),*range(20,101,10),500,1000])
    if value not in methods:
        raise argparse.ArgumentTypeError('Invalid ZFS compression method: '+value)
    return value


def compression_feature(method):
    if method=='lz4':return 'lz4_compress'
    if method and method.startswith('zstd'):return 'zstd_compress'
    return None


def check_compression_pool(method,pool,execute=None):
    execute=execute or run
    feature=compression_feature(method)
    if feature:
        require(execute('zpool','get','-H','-o','value','feature@'+feature,pool).strip() in ('enabled','active'),
                f'Pool {pool} does not enable {feature}; cannot use --compression {method}')


def check_compression_streams(method,pools):
    if method:
        require(not any(p['encrypted'] for p in pools),
                '--compression cannot recompress raw encrypted backup streams; omit --compression')


def receive_compression(command,method):
    if method:command[-1:-1]=['-o','compression='+method]
    return command


def boot_pool_names(manifest):
    root=manifest['root_dataset'].split('/')[0]
    return {p['name'] for p in manifest['pools'] if p['name']=='bpool' and p['name']!=root}|{
        m['source'].split('/')[0] for m in manifest.get('mounts',[])
        if m['target']=='/boot' and m['source'].split('/')[0]!=root}


def show_boot_compression_exemptions(manifest,method):
    if not method:return
    for pool in manifest['pools']:
        if pool['name'] not in boot_pool_names(manifest):continue
        settings=sorted({val(ps,'compression') for name,ps in pool['datasets'].items()
                         if '@' not in name}-{'-'})
        saved=' ('+', '.join(settings)+')' if settings else ''
        print(f'  {pool["name"]}: --compression {method} skipped for boot compatibility; '
              f'keeping saved per-dataset compression{saved}.')


def report_destination_compression(operation,datasets,execute=None,compression=None):
    execute=execute or run
    totals={}
    method_suffix=' | compression: '+compression if compression is not None else ''
    print(f'{diag_stamp()} {operation} destination sizes and compression (including retained snapshots):')
    for name,dataset in datasets:
        sizes={};ratio='unavailable'
        try:
            output=execute('zfs','list','-H','-p','-r','-t','filesystem,volume','-o',
                           'name,usedbydataset,usedbysnapshots,logicalused,compressratio',dataset)
            rows=[line.split('\t') for line in output.splitlines()]
            require(rows and all(len(row)==5 for row in rows),'Invalid destination space statistics')
            root=next((row for row in rows if row[0]==dataset),None)
            require(root is not None,'Missing destination dataset statistics')
            # Count allocated data once, excluding unused reservations.
            allocated=[value for row in rows for value in row[1:3]]
            if all(re.fullmatch(r'\d+',value) for value in allocated):
                sizes['compressed']=sum(map(int,allocated))
            if re.fullmatch(r'\d+',root[3]):sizes['uncompressed']=int(root[3])
            match=re.fullmatch(r'(\d+(?:\.\d+)?)x?',root[4])
            if match:ratio=match[1]+'x'
        except (Error,OSError) as exc:
            diagnostic_event(f'Destination space statistics unavailable for {dataset}: {exc}')
        print(f'  {name}: {dataset_size_text(sizes,prefix="")} | ratio {ratio}'+method_suffix)
        for kind in ('compressed','uncompressed'):
            previous=totals.get(kind,0);current=sizes.get(kind)
            totals[kind]=previous+current if previous is not None and current is not None else None
    compressed=totals.get('compressed');uncompressed=totals.get('uncompressed')
    ratio='unavailable'
    if compressed is not None and uncompressed is not None:
        if compressed>0:ratio=f'{uncompressed/compressed:.2f}x'
        elif uncompressed==0:ratio='1.00x'
    print(f'  Overall: {dataset_size_text(totals,prefix="")} | ratio {ratio}'+method_suffix)


def transfer_snapshot_inventory(dataset,execute=None):
    execute=execute or run
    try:
        rows={}
        output=execute('zfs','list','-H','-p','-r','-t','filesystem,volume,snapshot','-o',
                       'name,type,guid,createtxg,referenced,origin',dataset)
        for line in output.splitlines():
            fields=line.split('\t')
            require(len(fields)==6,'Invalid transfer space statistics')
            name,kind,guid,txg,referenced,origin=fields
            require(name==dataset or name.startswith((dataset+'/',dataset+'@')),
                    'Unexpected dataset in transfer space statistics')
            require(kind in ('filesystem','volume','snapshot') and
                    all(re.fullmatch(r'\d+',v) for v in (guid,txg,referenced)),
                    'Invalid transfer space statistics')
            rows[name]=dict(type=kind,guid=guid,txg=int(txg),referenced=int(referenced),origin=origin)
        require(dataset in rows,'Missing transfer dataset statistics')
        return rows
    except (Error,OSError) as exc:
        diagnostic_event(f'Transfer space statistics unavailable for {dataset}: {exc}')
        return None


def received_compressed_bytes(dataset,before,execute=None):
    execute=execute or run
    if before is None:return None
    after=transfer_snapshot_inventory(dataset,execute)
    if after is None:return None
    known={row['guid'] for row in before.values() if row['type']=='snapshot'}
    total=0
    try:
        for name,row in after.items():
            if row['type']=='snapshot':continue
            snapshots=sorted((item['txg'],snap,item) for snap,item in after.items()
                             if item['type']=='snapshot' and snap.split('@')[0]==name)
            previous=row['origin'] if row['origin']!='-' else None
            for _,snap,item in snapshots:
                if item['guid'] not in known:
                    # written@ counts replacement blocks without subtracting freed data.
                    if previous:
                        value=execute('zfs','get','-H','-p','-o','value','written@'+previous,snap).strip()
                        require(re.fullmatch(r'\d+',value),'Invalid written space statistic')
                        total+=int(value)
                    else:
                        total+=item['referenced']
                previous=snap
        return total
    except (Error,OSError) as exc:
        diagnostic_event(f'Compressed transfer statistics unavailable for {dataset}: {exc}')
        return None


class TransferTotals:
    def __init__(self):
        self.stream=0
        self.compressed=0
        self.uncompressed=0
        self.compression=None

    def record(self,count,dataset,before,execute=None,raw=False):
        self.stream+=count
        self.uncompressed=None if raw or self.uncompressed is None else self.uncompressed+count
        compressed=received_compressed_bytes(dataset,before,execute) if count else 0
        self.compressed=None if self.compressed is None or compressed is None else self.compressed+compressed


def report_operation_rates(operation,transferred,elapsed):
    totals=[];rates=[]
    for kind in ('compressed','uncompressed'):
        count=getattr(transferred,kind)
        totals.append(kind+' '+(f'{count/1000000:.3f} MB' if count is not None else 'unavailable'))
        rates.append(kind+' '+(f'{count/elapsed/1000000:.3f} MB/s' if count is not None and elapsed>0 else 'unavailable'))
    print(f'{diag_stamp()} {operation} total: {duration(elapsed)} | transferred: '+', '.join(totals)
          +' | average: '+', '.join(rates)
          +(' | compression: '+transferred.compression if transferred.compression is not None else ''),flush=True)


def restore_compression(manifest,method):
    for pool in manifest['pools']:pool.pop('_restore_compression',None)
    boot=boot_pool_names(manifest)
    targets=[p for p in manifest['pools'] if p['name'] not in boot]
    check_compression_streams(method,targets)
    for pool in targets:
        if method:
            feature=compression_feature(method)
            require(not feature or val(pool['properties'],'feature@'+feature) in ('enabled','active'),
                    f'{pool["name"]}: saved pool features do not support --compression {method}')
            pool['_restore_compression']=method
    if method:
        print('Restore target dataset compression: '+method)
        show_boot_compression_exemptions(manifest,method)


# Sent as Python code over SSH; no installation of this tool is needed remotely.
# Only metadata files use this protocol. ZFS streams travel directly over SSH.
REMOTE_FILES = r'''
import fcntl, hashlib, json, os, re, shutil, sys
from pathlib import Path
a=json.loads(sys.argv[1]); root=Path(a['root'])
def check(ok, message):
    if not ok: raise RuntimeError(message)
check(root.is_absolute() and root.is_dir() and root.resolve()==root, 'Unsafe repository mountpoint')
def path(relative):
    p=Path(relative)
    check(relative and not p.is_absolute() and '..' not in p.parts and str(p)==relative, 'Unsafe metadata path')
    current=root
    for name in p.parts:
        current=current/name
        check(not current.is_symlink(), 'Symlink in metadata path')
    return current
def syncdir(p):
    fd=os.open(p,os.O_RDONLY|os.O_DIRECTORY)
    try: os.fsync(fd)
    finally: os.close(fd)
op=a['op']
if op=='index':
    entries=[]; hosts=path('hosts')
    for host in sorted(hosts.iterdir()) if hosts.exists() else []:
        check(not host.is_symlink(), 'Symlinked host')
        if not host.is_dir(): continue
        check(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*',host.name), 'Invalid host')
        for point in sorted(host.iterdir()):
            if not re.fullmatch(r'backup-\d{8}-\d{6}',point.name): continue
            point=path(str(point.relative_to(root)))
            if not point.is_dir(): continue
            manifest=path(str((point/'manifest.json').relative_to(root)))
            sums=path(str((point/'SHA256SUMS').relative_to(root)))
            if manifest.is_file() and sums.is_file():
                check(manifest.stat().st_size <= 64*1024*1024 and sums.stat().st_size <= 8*1024*1024, 'Metadata index too large')
                entries.append(dict(host=host.name,point=point.name,manifest=manifest.read_text(),sums=sums.read_text()))
    print(json.dumps(entries))
elif op=='get':
    p=path(a['relative']); check(p.is_file(), 'Missing metadata file')
    with open(p,'rb') as f: shutil.copyfileobj(f,sys.stdout.buffer,1024*1024)
elif op=='mkdir':
    p=path(a['relative']); p.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    path(a['relative']); p.mkdir(mode=0o700)
elif op=='put':
    p=path(a['relative']); p.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    path(a['relative'])
    with open(p,'xb') as f:
        shutil.copyfileobj(sys.stdin.buffer,f,1024*1024); f.flush(); os.fsync(f.fileno())
elif op=='publish':
    point=path(a['relative']); destination=path(a['destination'])
    check(not destination.exists(), 'Recovery point already exists')
    sums=path(a['relative']+'/SHA256SUMS'); seen=set()
    for line in sums.read_text().splitlines():
        match=re.fullmatch(r'([0-9a-f]{64})  (.+)',line)
        check(match is not None, 'Malformed checksums')
        digest,name=match.groups(); check(name not in seen and name!='SHA256SUMS', 'Duplicate checksum')
        seen.add(name); p=path(a['relative']+'/'+name)
        check(p.is_file() and p.is_relative_to(point), 'Missing artifact')
        h=hashlib.sha256()
        with open(p,'rb') as f:
            for block in iter(lambda:f.read(4*1024*1024),b''): h.update(block)
        check(h.hexdigest()==digest, 'Uploaded artifact checksum mismatch: '+name)
    check({'manifest.json','disk/gpt.bin','disk/first-megabyte.bin'}<=seen, 'Required metadata missing')
    for p in sorted(point.rglob('*'),key=lambda p:len(p.parts),reverse=True):
        check(not p.is_symlink(), 'Symlinked uploaded artifact')
        if p.is_dir(): syncdir(p)
    syncdir(point); os.rename(point,destination); syncdir(destination.parent)
elif op=='lock':
    fd=os.open(path('.backup.lock'),os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
    fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
    print('LOCKED',flush=True)
    while sys.stdin.buffer.read(1): pass
elif op=='access':
    check(os.access(root,os.R_OK|os.X_OK|(os.W_OK if a.get('write') else 0)),
          'Repository permissions do not allow this SSH user to access metadata')
else: raise RuntimeError('Unknown metadata operation')
'''


class RemoteRepository:
    def __init__(self,host,pool=None,port=None,executor=None):
        require(isinstance(host,str) and re.fullmatch(r'(?:[A-Za-z0-9_][A-Za-z0-9_.-]*@)?[A-Za-z0-9][A-Za-z0-9_.:-]*',host),
                'Remote must be an SSH host or user@host (SSH config aliases are supported)')
        require(port is None or 1<=port<=65535,'Invalid SSH port')
        require(executor is None or (executor.startswith('/') and '\0' not in executor and '\n' not in executor),
                'Remote executor must be an absolute executable path')
        self.host=host;self.pool=pool;self.executor=executor
        self.ssh=['ssh','-T','-o','BatchMode=yes','-o','StrictHostKeyChecking=yes',
                  '-o','ConnectTimeout=15','-o','ServerAliveInterval=15','-o','ServerAliveCountMax=3']
        if port is not None:self.ssh+=['-p',str(port)]
        self.ssh+=[host]
        self.lock_process=None;self.cache=None;self.hydrated=set()

    def command(self,*args):
        args=[str(a) for a in args]
        if self.executor and args[0] in ('zfs','zpool','setfacl'):
            args.insert(0,self.executor)
        return self.ssh+['env LC_ALL=C '+shlex.join(args)]

    def run(self,*args,**kwargs):
        self.check_lock()
        return run(*self.command(*args),**kwargs)

    def check_lock(self):
        if self.lock_process is not None:
            require(self.lock_process.poll() is None,'Remote repository lock connection was lost; operation stopped')

    def file_command(self,op,**kwargs):
        return self.command('python3','-c',REMOTE_FILES,json.dumps(dict(op=op,root=self.mountpoint,**kwargs)))

    def files(self,op,**kwargs):
        self.check_lock()
        return run(*self.file_command(op,**kwargs))

    def select(self,write=False,forbidden_guids=(),unattended=False,require_existing=False):
        rows=self.run('zpool','list','-H','-p','-o','name,size,free,health,guid').splitlines()
        pools=[]
        for row in rows:
            name,size,free,health,guid=row.split('\t')
            pools.append(dict(name=name,size=int(size),free=int(free),health=health,guid=guid))
        require(pools,'No imported ZFS pools found on remote server')
        print(f'\nZFS pools on {self.host}:')
        for i,p in enumerate(pools,1):
            print(f'{i}. {p["name"]}  {p["size"]/GIB:.1f} GiB  free {p["free"]/GIB:.1f} GiB  {p["health"]}')
        if self.pool is None:
            require(not unattended,'Unattended backup: remote pool selection would require a prompt; specify --pool')
            answer=input('Remote destination pool (name or number): ' if write else 'Remote backup pool (name or number): ').strip()
            self.pool=pools[int(answer)-1]['name'] if answer.isdigit() and 1<=int(answer)<=len(pools) else answer
        matches=[p for p in pools if p['name']==self.pool]
        require(len(matches)==1,'Remote pool not found')
        require(re.fullmatch(r'[A-Za-z][A-Za-z0-9_.:-]*',self.pool),'Invalid remote pool name')
        selected=matches[0];self.guid=selected['guid']
        require(selected['health']=='ONLINE','Remote pool must be ONLINE')
        require(self.guid not in forbidden_guids,'Remote destination pool is a source OS pool')
        self.dataset=self.pool+'/linux_os_backup_repository'
        existing=set(self.run('zfs','list','-H','-o','name').splitlines())
        if self.dataset not in existing:
            require(not require_existing,'--incremental requires an existing remote backup repository; no matching base is available')
            require(not unattended,'Unattended backup requires an existing remote backup repository; initialize it interactively first')
            require(write,'Selected pool has no remote backup repository')
            require(self.run('zfs','get','-H','-o','value','encryption',self.pool).strip()=='off',
                    'Remote metadata repository requires an unencrypted parent pool')
            mountpoint='/var/lib/lllzorb/repositories/'+self.pool
            print(f'Creating remote repository dataset: {self.host}:{self.dataset}')
            self.run('zfs','create','-o','mountpoint='+mountpoint,'-o','canmount=on',
                     '-o','sharenfs=off','-o','sharesmb=off','-o','volmode=none',
                     '-o','org.linux-os-backup:repository=on',self.dataset)
            uid=self.run('id','-u').strip()
            require(uid.isdigit(),'Cannot determine remote SSH user identity')
            if uid!='0' and self.executor:
                self.run('zfs','set','acltype=posixacl',self.dataset)
                self.run('setfacl','-m','u:'+uid+':rwx',mountpoint)
        require(self.run('zfs','get','-H','-o','value','org.linux-os-backup:repository',self.dataset).strip()=='on',
                'Remote repository dataset is not managed by this tool')
        require(self.run('zfs','get','-H','-o','value','encryption',self.dataset).strip()=='off',
                'Remote metadata repository must be unencrypted')
        require(self.run('zfs','get','-H','-o','value','mounted',self.dataset).strip()=='yes',
                'Remote repository must be mounted by the server')
        self.mountpoint=self.run('zfs','get','-H','-o','value','mountpoint',self.dataset).strip()
        require(self.mountpoint.startswith('/'),'Remote repository needs an absolute mountpoint')
        visible=json.loads(self.run('findmnt','-J','-T',self.mountpoint))['filesystems'][0]
        require(visible['fstype']=='zfs' and visible['source']==self.dataset and visible['target']==self.mountpoint,
                'Remote repository mount identity mismatch')
        # The lock file also requires metadata access during restores.
        self.files('access',write=True)

    @contextlib.contextmanager
    def lock(self):
        with tempfile.TemporaryFile() as errors:
            process=locked_popen(self.file_command('lock'),stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=errors)
            try:
                require(process.stdout.readline()==b'LOCKED\n','Cannot acquire remote repository lock (another operation or permission failure)')
                self.lock_process=process
                yield
                self.check_lock()
            finally:
                self.lock_process=None
                process.stdin.close();process.stdout.close()
                try: process.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    process.terminate()
                    try: process.wait(timeout=5)
                    except subprocess.TimeoutExpired: process.kill();process.wait()

    def index(self,cache):
        self.cache=Path(cache).resolve()
        for entry in json.loads(self.files('index')):
            host=valid_hostname(entry['host']);point=entry['point']
            require(re.fullmatch(r'backup-\d{8}-\d{6}',point),'Invalid remote recovery point')
            m=json.loads(entry['manifest']);validate(m)
            require(m.get('storage')=='native' and m.get('hostname')==host,'Remote manifest host/storage mismatch')
            self.check_manifest(m)
            target=self.cache/'hosts'/host/point;target.mkdir(parents=True,mode=0o700)
            (target/'manifest.json').write_text(entry['manifest'])
            (target/'SHA256SUMS').write_text(entry['sums'])

    def check_manifest(self,m):
        require(m['storage_pool_guid']==self.guid and m['native_root'].startswith(self.dataset+'/linux_os_backup/'),
                'Remote manifest refers to a different storage repository')

    def hydrate(self,base):
        base=Path(base).resolve()
        if base in self.hydrated:return
        relative=base.relative_to(self.cache)
        require(len(relative.parts)==3 and relative.parts[0]=='hosts','Invalid staged recovery-point path')
        expected={}
        for line in (base/'SHA256SUMS').read_text().splitlines():
            match=re.fullmatch(r'([0-9a-f]{64})  (.+)',line)
            require(match is not None,'Malformed remote checksums')
            h,name=match.groups();safe_rel(name)
            require(name not in expected and name!='SHA256SUMS','Invalid remote checksum entry')
            expected[name]=h
        for name,h in expected.items():
            local=base/name
            if name=='manifest.json':
                require(digest(local)==h,'Remote manifest checksum mismatch')
                continue
            local.parent.mkdir(parents=True,exist_ok=True)
            self.check_lock()
            with open(local,'xb') as output:
                result=locked_run(self.file_command('get',relative=str(relative/name)),stdout=output,stderr=subprocess.PIPE)
            require(result.returncode==0,'Remote metadata download failed: '+result.stderr.decode(errors='replace'))
            require(digest(local)==h,'Remote artifact checksum mismatch: '+name)
        self.hydrated.add(base)

    def publish(self,out):
        relative=Path(out).resolve().relative_to(self.cache)
        incoming=relative.parent/('.incoming-'+uuid.uuid4().hex)
        self.files('mkdir',relative=str(incoming))
        for p in sorted(Path(out).rglob('*')):
            if not p.is_file():continue
            require(not p.is_symlink(),'Symlinked local backup artifact')
            self.check_lock()
            with open(p,'rb') as source:
                result=locked_run(self.file_command('put',relative=str(incoming/p.relative_to(out))),stdin=source,
                                      stdout=subprocess.PIPE,stderr=subprocess.PIPE)
            require(result.returncode==0,'Remote metadata upload failed: '+result.stderr.decode(errors='replace'))
        self.files('publish',relative=str(incoming),destination=str(relative))

    def available(self):
        return int(self.run('zfs','get','-H','-p','-o','value','available',self.dataset).strip())

    def journal(self):
        root=Path('/var/lib/lllzorb/restore-journals')
        root.mkdir(parents=True,exist_ok=True,mode=0o700)
        require(root.resolve()==root,'Unsafe restore journal directory')
        return root/('restore-guid-'+uuid.uuid4().hex+'.json')


@contextlib.contextmanager
def remote_storage(args,write=False,source=None):
    commands('ssh')
    remote=RemoteRepository(args.remote,getattr(args,'pool',None),getattr(args,'ssh_port',None),getattr(args,'remote_executor',None))
    remote.select(write,forbidden_guids={p['guid'] for p in source['pools']} if source else (),
                  **({'require_existing':True} if write and getattr(args,'incremental',False) else {}),
                  **({'unattended':True} if getattr(args,'unattended',False) else {}))
    with remote.lock(),tempfile.TemporaryDirectory(prefix='lllzorb-remote-') as cache:
        remote.index(cache)
        yield Path(cache),remote


def tree_nodes(nodes):
    for n in nodes:
        yield n
        yield from tree_nodes(n.get('children', []))


DISK_IDS = Path('/dev/disk/by-id')
HARDWARE_ID_PREFIXES = ('wwn-', 'nvme-eui.', 'nvme-uuid.', 'ata-', 'scsi-',
                        'nvme-', 'usb-', 'mmc-', 'ieee1394-', 'cciss-', 'pmem-', 'memstick-')


def device_ids():
    """Index hardware IDs only: filesystem/partition UUIDs are cloned on restore."""
    aliases = {}
    for path in DISK_IDS.glob('*'):
        if path.name.startswith(HARDWARE_ID_PREFIXES) and path.is_symlink() and path.is_block_device():
            aliases.setdefault(os.path.realpath(path), []).append(str(path))
    return aliases


def stable_device(device, aliases=None):
    """Bind a kernel name once; never resolve the returned ID for device I/O."""
    path = os.path.abspath(os.path.expanduser(str(device)))
    aliases = device_ids() if aliases is None else aliases
    resolved = os.path.realpath(path)
    matches = aliases.get(resolved, [])
    require(matches, f'{device}: no persistent hardware device ID in {DISK_IDS}; '
            'refusing to use a changing kernel device name')
    # Preserve an explicitly selected ID for the entire operation, including
    # failure if that ID disappears. Do not switch to another disk/alias.
    if Path(path).parent == DISK_IDS:
        require(path in matches, f'Persistent device ID is unavailable: {path}')
        return path
    def preference(alias):
        name = Path(alias).name
        base = re.sub(r'-part\d+$', '', name)
        # Prefer namespace-qualified NVMe serial IDs over their obsolete aliases.
        obsolete = name.startswith('nvme-') and any(
            re.fullmatch(re.escape(base) + r'_\d+', re.sub(r'-part\d+$', '', Path(other).name))
            for other in matches)
        return next((i for i, prefix in enumerate(HARDWARE_ID_PREFIXES) if name.startswith(prefix)), len(HARDWARE_ID_PREFIXES)), obsolete, name
    selected = min(matches, key=preference)
    require(os.path.realpath(selected) == resolved, f'Device identity changed while selecting {device}')
    return selected


def inventory():
    inv = json.loads(run('lsblk', '-b', '-O', '-J'))
    aliases = device_ids()
    for node in tree_nodes(inv['blockdevices']):
        if node['type'] not in ('disk', 'part') or is_zvol(node):
            continue
        try:
            node['path'] = stable_device(node['path'], aliases)
        except Error as error:
            # Keep unidentified disks visible, especially for unattended target
            # ambiguity checks. They must never become operational paths.
            node['device_id_error'] = str(error)
    return inv


def node_for(device, inv=None):
    device = os.path.realpath(device)
    matches = [n for n in tree_nodes((inv or inventory())['blockdevices'])
               if os.path.realpath(n['path']) == device]
    require(bool(matches), f'Block device not found: {device}')
    return matches[0]


def disk_for(device):
    n = node_for(device)
    require(n['type'] in ('disk', 'part'), f'Unsupported storage layer: {n["type"]}')
    return stable_device('/dev/' + n['pkname'].removeprefix('/dev/') if n['type'] == 'part' else n['path'])


def signatures(device):
    return json.loads(run('wipefs', '--no-act', '--json', device)).get('signatures', [])


def validate_source_signatures(disk, geometry, pools):
    # Whole-device probing can find a partition's trailing ZFS labels.
    # Accept only matching pool identities at that partition's label locations.
    label_size = 256 * 1024
    sector = geometry['logical_sector_size']
    for sig in signatures(disk):
        if sig['type'] in ('gpt', 'PMBR'):
            continue
        matched = False
        if sig['type'] == 'zfs_member':
            offset = int(sig['offset'], 0)
            for part in geometry['partitions']:
                if part['kind'] != 'zfs':
                    continue
                start = part['start_lba'] * sector
                size = part['size_bytes'] // label_size * label_size
                relative = offset - start
                locations = (0, label_size, size - 2 * label_size, size - label_size)
                if (sig.get('uuid') == pools[part['pool']]['guid'] and
                        any(base <= relative < base + label_size for base in locations)):
                    matched = True
        require(matched, f'{disk}: unsupported or conflicting {sig["type"]} signature at {sig.get("offset", "unknown offset")}')


def pool_leaves(pool):
    status = run('zpool', 'status', '-P', pool)
    body = status.split('config:', 1)[-1].split('errors:', 1)[0]
    rows = [line.split() for line in body.splitlines() if line.strip()]
    rows = [r for r in rows if r[0] != 'NAME']
    require(rows and rows[0][:2] == [pool, 'ONLINE'], f'Pool {pool} is not ONLINE')
    leaves = []
    for row in rows[1:]:
        require(len(row) >= 2 and row[0].startswith('/') and row[1] == 'ONLINE',
                f'{pool}: only ordinary single-disk leaf vdevs are supported (no mirror/raidz/log/cache/special/spare)')
        require(all(x == '0' for x in row[2:5]), f'{pool}: pool reports errors')
        leaves.append(stable_device(row[0]))
    require(leaves and len({os.path.realpath(p) for p in leaves}) == len(leaves), f'Invalid pool topology: {pool}')
    require(len({disk_for(x) for x in leaves}) == 1, f'Multi-disk pool unsupported: {pool}')
    return leaves


def pool_ashift(leaves, guid):
    # Read the actual vdev labels without relying on zdb's pool/cache lookup.
    ashifts = set()
    for device in leaves:
        labels = run('zdb', '-l', device)
        guids = set(re.findall(r'^\s*pool_guid:\s+(\d+)\s*$', labels, re.M))
        values = {int(x) for x in re.findall(r'^\s*ashift:\s+(\d+)\s*$', labels, re.M)}
        require(guids == {str(guid)}, f'{device}: ZFS label pool GUID mismatch')
        require(values and all(9 <= x <= 16 for x in values),
                f'{device}: missing or invalid ashift in ZFS labels')
        ashifts.update(values)
    require(len(ashifts) == 1, 'Cannot determine uniform ashift from ZFS labels')
    return ashifts.pop()


def props(program, name, recursive=False):
    args = [program, 'get', '-H', '-p'] + (['-r'] if recursive else [])
    raw = run(*args, '-o', 'name,property,value,source', 'all', name)
    out = {}
    for line in raw.splitlines():
        obj, prop, value, source = line.split('\t', 3)
        out.setdefault(obj, {})[prop] = {'value': value, 'source': source}
    return out


def val(properties, key, default='-'):
    return properties.get(key, {}).get('value', default)


def read_gpt(device, sector, size):
    """Read and cross-check both GPT copies rather than parsing sgdisk prose."""
    with open(device, 'rb', buffering=0) as f:
        mbr = f.read(512)
        require(mbr[510:512] == b'\x55\xaa', 'Invalid MBR signature')
        types = [mbr[446 + i*16 + 4] for i in range(4)]
        require(types.count(0xee) == 1 and all(t in (0, 0xee) for t in types),
                'Only protective MBR + GPT is supported; legacy/hybrid MBR is rejected')
        def header(lba):
            f.seek(lba * sector)
            h = f.read(sector)
            require(h[:8] == b'EFI PART', 'Missing GPT header')
            length, crc = struct.unpack_from('<II', h, 12)
            require(92 <= length <= sector, 'Invalid GPT header size')
            hc = bytearray(h[:length]); hc[16:20] = b'\0'*4
            require(zlib.crc32(hc) == crc, 'GPT header CRC mismatch')
            current, other, first, last = struct.unpack_from('<QQQQ', h, 24)
            table, count, entry_size, table_crc = struct.unpack_from('<QIII', h, 72)
            require(current == lba and 0 < count <= 4096 and entry_size == 128,
                    'Unsupported GPT table dimensions')
            require(table*sector + count*entry_size <= size, 'GPT entries outside disk')
            f.seek(table*sector); entries = f.read(count*entry_size)
            require(zlib.crc32(entries) == table_crc, 'GPT entry CRC mismatch')
            return dict(current=current, other=other, first=first, last=last,
                        guid=str(uuid.UUID(bytes_le=h[56:72])), count=count, entries=entries)
        primary = header(1)
        require(primary['other'] == size//sector-1, 'Backup GPT is not at disk end')
        secondary = header(primary['other'])
        require(secondary['other'] == 1 and all(primary[k] == secondary[k] for k in
                ('first', 'last', 'guid', 'count', 'entries')), 'GPT copies disagree')
        parts = []
        for i in range(primary['count']):
            e = primary['entries'][i*128:(i+1)*128]
            if e[:16] == b'\0'*16:
                continue
            start, end, attrs = struct.unpack_from('<QQQ', e, 32)
            require(primary['first'] <= start <= end <= primary['last'], 'Invalid partition bounds')
            parts.append(dict(number=i+1, start_lba=start, end_lba=end,
                              size_bytes=(end-start+1)*sector,
                              type_guid=str(uuid.UUID(bytes_le=e[:16])),
                              partuuid=str(uuid.UUID(bytes_le=e[16:32])),
                              name=e[56:128].decode('utf-16-le').rstrip('\0'), attributes=attrs))
        ordered = sorted(parts, key=lambda x: x['start_lba'])
        require(all(a['end_lba'] < b['start_lba'] for a,b in zip(ordered, ordered[1:])),
                'Overlapping partitions')
        return dict(table_type='gpt', guid=primary['guid'], entry_count=primary['count'],
                    size_bytes=size, logical_sector_size=sector, partitions=ordered)


def partition_device(disk, number):
    disk = stable_device(disk)
    require(node_for(disk)['type'] == 'disk', f'Not a whole disk: {disk}')
    require(isinstance(number, int) and number > 0, 'Invalid partition number')
    requested=f'{disk}-part{number}'
    # udev can expose the new kernel partition briefly before creating its
    # persistent by-id alias. Wait for that alias rather than rejecting a
    # partition created by this restore.
    last_error=None
    for attempt in range(21):
        try:
            partition=stable_device(requested)
            break
        except Error as exc:
            last_error=exc
            if attempt<20:
                time.sleep(0.1)
    else:
        raise last_error
    node = node_for(partition)
    require(node['type'] == 'part' and
            os.path.realpath(disk_for(partition)) == os.path.realpath(disk),
            f'Partition ID does not belong to selected disk: {partition}')
    kernel_name = Path(os.path.realpath(partition)).name
    require(int(Path('/sys/class/block', kernel_name, 'partition').read_text()) == number,
            f'Partition ID has wrong partition number: {partition}')
    return partition


def discover():
    mount = json.loads(run('findmnt', '-J', '-T', '/'))['filesystems'][0]
    require(mount['fstype'] == 'zfs', 'The running root filesystem must be ZFS')
    root = mount['source']; rootpool = root.split('/')[0]
    disk = disk_for(pool_leaves(rootpool)[0]); n = node_for(disk)
    g = read_gpt(disk, int(n['log-sec']), int(n['size']))
    g.update(device=disk, physical_sector_size=int(n['phy-sec']), model=n.get('model'), serial=n.get('serial'))
    imported = run('zpool', 'list', '-H', '-o', 'name').splitlines()
    pools = {}; esp_count = 0
    allparts = [x for x in tree_nodes([n]) if x['type'] == 'part']
    require(len(allparts) == len(g['partitions']), 'Kernel partition map disagrees with GPT')
    for p in g['partitions']:
        dev = partition_device(disk, p['number']); pn = node_for(dev)
        require(not pn.get('children'), f'Unsupported layered device on {dev}')
        p['source_device'] = dev
        sig = {s['type'] for s in signatures(dev)}
        if p['type_guid'] == BIOS:
            require(not pn.get('fstype') and not sig and not any(pn.get('mountpoints') or []),
                    f'BIOS boot partition contains a filesystem/signature or is mounted: {dev}')
            p['kind']='bios_boot'; p['image']=f'disk/bios-boot-{p["number"]}.bin'
        elif p['type_guid'] == ESP:
            require(pn['fstype'] == 'vfat' and sig == {'vfat'}, f'ESP is not exclusively FAT: {dev}')
            esp_count += 1; p['kind'] = 'esp'
            p['fat_uuid'] = pn['uuid']; p['fat_label'] = pn.get('label') or ''
            with open(dev, 'rb') as f:
                boot = f.read(512)
            require(len(boot)==512 and boot[510:512]==b'\x55\xaa', 'Invalid FAT boot sector')
            bps=struct.unpack_from('<H',boot,11)[0]; spc=boot[13]
            require(bps in (512,1024,2048,4096) and spc>0, 'Invalid FAT geometry')
            reserved=struct.unpack_from('<H',boot,14)[0]; fats=boot[16]
            roots=struct.unpack_from('<H',boot,17)[0]
            total=struct.unpack_from('<H',boot,19)[0] or struct.unpack_from('<I',boot,32)[0]
            fatsize=struct.unpack_from('<H',boot,22)[0] or struct.unpack_from('<I',boot,36)[0]
            clusters=(total-reserved-fats*fatsize-(roots*32+bps-1)//bps)//spc
            p['fat_bits'] = 12 if clusters<4085 else 16 if clusters<65525 else 32; p['archive'] = f'efi/esp-{p["number"]}.tar.zst'
            p['mountpoints'] = [m for m in pn.get('mountpoints', []) if m]
        elif p['type_guid'] == SWAP:
            require(pn.get('fstype') == 'swap' and sig == {'swap'}, f'Invalid plain swap partition: {dev}')
            label = dict(line.split('=',1) for line in run('blkid','-p','-o','export',dev).splitlines() if '=' in line)
            require(label.get('TYPE') == 'swap' and label.get('VERSION') == '1', f'Unsupported swap format: {dev}')
            p.update(kind='swap',swap_uuid=label.get('UUID'),swap_label=label.get('LABEL',''),swap_version=1)
        elif p['type_guid'] in (ZFS, LINUX_FS):
            require(pn['fstype'] == 'zfs_member' and sig == {'zfs_member'}, f'Invalid ZFS partition: {dev}')
            p['kind'] = 'zfs'
            label = dict(line.split('=',1) for line in run('blkid','-p','-o','export',dev).splitlines() if '=' in line)
            pool = label.get('LABEL')
            require(pool in imported, f'Pool on {dev} must be imported for snapshot backup')
            if pool not in pools:
                leaves = pool_leaves(pool)
                require(all(disk_for(x) == disk and node_for(x)['type'] == 'part' for x in leaves),
                        f'{pool} uses unsupported storage')
                pp = props('zpool',pool)[pool]; dp = props('zfs',pool,True)
                require(val(dp[pool], 'encryption') == 'off',
                        f'{pool}: encrypted pool-root datasets cannot be recreated in place; encrypted child datasets are supported')
                ashift = pool_ashift(leaves, val(pp,'guid'))
                pools[pool] = dict(name=pool, guid=val(pp,'guid'), leaves=leaves, ashift=ashift,
                    properties=pp, datasets=dp, bootfs=val(pp,'bootfs'), topology='stripe',
                    encrypted=any(val(v,'encryption','off') != 'off' for v in dp.values()),
                    allocated_bytes=int(val(pp,'allocated')), used_bytes=int(val(dp[pool],'used')),
                    logicalused_bytes=int(val(dp[pool],'logicalused')),
                    referenced_bytes=int(val(dp[pool],'referenced')), stream=f'zfs/{pool}.zfs')
            p['pool'] = pool
        else:
            raise Error(f'Unsupported partition type {p["type_guid"]} on {dev}; nothing has been changed')
    require(esp_count > 0 and rootpool in pools, 'Need at least one ESP and the root pool')
    for pool in pools.values():
        numbers = [p['number'] for p in g['partitions'] if p.get('pool') == pool['name']]
        devices = {p['source_device'] for p in g['partitions'] if p.get('pool') == pool['name']}
        require({os.path.realpath(p) for p in devices} == {os.path.realpath(p) for p in pool['leaves']},
                'Some pool vdevs are not supported disk partitions')
        pool['partitions'] = numbers
    validate_source_signatures(disk, g, pools)
    mounted = list(tree_nodes(json.loads(run('findmnt','-J'))['filesystems']))
    # findmnt uses the same children convention as lsblk.
    for m in mounted:
        if m.get('fstype') == 'zfs' and m['source'].split('/')[0] in pools:
            require('[' not in m['source'], 'ZFS bind mounts require manual recovery')
    result = dict(version=SCHEMA, backup_type='full', disk=g, pools=list(pools.values()),
                root_dataset=root, mounts=[m for m in mounted if m.get('fstype') == 'zfs'
                                          and m['source'].split('/')[0] in pools])
    validate_pool_layout(result)
    return result


def validate_pool_layout(manifest):
    """One root pool, optionally a distinct /boot pool, one partition per pool."""
    parts=[p for p in manifest['disk']['partitions'] if p['kind']=='zfs']
    pools=manifest['pools']
    names={p['name'] for p in pools}
    root=manifest['root_dataset'].split('/')[0]
    require(root in names and len(pools) == len(names) and 1 <= len(pools) <= 2,
            'Support requires a root pool and at most one separate boot pool')
    require(len(parts) == len(pools), 'Each pool must occupy exactly one ZFS partition')
    for pool in pools:
        mapped=[p['number'] for p in parts if p['pool']==pool['name']]
        require(len(mapped)==1 and pool['partitions']==mapped,
                'Each pool must occupy exactly one ZFS partition')
    if len(pools)==2:
        boot=[m['source'].split('/')[0] for m in manifest['mounts'] if m['target']=='/boot']
        require(len(boot)==1 and boot[0] != root and set(boot)|{root} == names,
                'The second ZFS pool must contain the mounted /boot filesystem')
    return root


def align(n, unit=MIB):
    return ((n+unit-1)//unit)*unit


def current_dataset_bytes(pool):
    # Sum live referenced data, excluding bytes retained only by old snapshots.
    # Independent clone copies may require more space than shared source blocks.
    return sum(max(int(val(ps,'referenced','0')),int(val(ps,'logicalreferenced','0')))
               for name,ps in pool['datasets'].items() if '@' not in name)


def dataset_sizes(properties):
    properties=list(properties)
    result={}
    for label,prop in (('compressed','referenced'),('uncompressed','logicalreferenced')):
        values=[val(item,prop) for item in properties]
        result[label]=sum(map(int,values)) if values and all(v.isdigit() for v in values) else None
    return result


def saved_snapshot_sizes(pools,snapshot):
    return dataset_sizes(pool['datasets'].get(name+'@'+snapshot,{})
                         for pool in pools for name in pool['datasets'] if '@' not in name)


def dataset_size_text(sizes,prefix='datasets: '):
    return prefix+', '.join(label+' '+(f'{sizes[label]/GIB:.3f} GiB'
        if sizes.get(label) is not None else 'unavailable') for label in ('compressed','uncompressed'))


def snapshot_dataset_sizes(snapshots):
    names=sorted(set(snapshots));properties={}
    try:
        for start in range(0,len(names),128):
            batch=names[start:start+128]
            output=run('zfs','list','-H','-p','-t','snapshot','-o','name,referenced,logicalreferenced',*batch)
            for line in output.splitlines():
                name,compressed,uncompressed=line.split('\t')
                require(name in batch and name not in properties,'Unexpected snapshot size row')
                properties[name]={'referenced':{'value':compressed},'logicalreferenced':{'value':uncompressed}}
        return dataset_sizes(properties.get(name,{}) for name in names)
    except (Error,OSError,ValueError):
        return dataset_sizes([])


def choose_restore_swap_sizes(manifest):
    sizes={}
    for part in sorted(manifest['disk']['partitions'],key=lambda p:p['start_lba']):
        if part['kind']!='swap':continue
        original=part['size_bytes']
        default=f'{original/MIB:.12f}'.rstrip('0').rstrip('.')
        print('Swap size: 1 MB = 1,048,576 bytes (MiB). Press Enter to keep the original size.')
        while True:
            answer=input(f'Swap partition p{part["number"]} size in MB [{default}]: ').strip()
            if not answer:
                sizes[part['number']]=original
                break
            if not re.fullmatch(r'[0-9]{1,18}',answer) or int(answer)<1:
                print(f'Enter a positive whole number of MB, or press Enter to keep {default} MB.')
                continue
            sizes[part['number']]=int(answer)*MIB
            break
    return sizes


def solve(manifest, target_size, sector, swap_sizes=None,allow_estimated_overflow=False):
    require(sector == manifest['disk']['logical_sector_size'], 'Different logical sector sizes are unsupported')
    swap_sizes=swap_sizes or {}
    swaps={p['number']:p for p in manifest['disk']['partitions'] if p['kind']=='swap'}
    require(swap_sizes.keys()<=swaps.keys(),'Swap size specified for a non-swap partition')
    for number,size in swap_sizes.items():
        require(type(size) is int and (size>=MIB or size==swaps[number]['size_bytes']) and size%sector==0,
                'Requested swap size must preserve the original size or be at least 1 MiB, aligned to sectors')
    parts=sorted(({**p,'size_bytes':swap_sizes.get(p['number'],p['size_bytes'])}
                  for p in manifest['disk']['partitions']),key=lambda p:p['start_lba'])
    root=validate_pool_layout(manifest)
    # Capacity check only: no requested free-space reserve. Stream size and
    # allocation are conservative estimates; include reservations and metadata.
    estimates={};warnings=[]
    for pool in manifest['pools']:
        allocation=max(pool['allocated_bytes'],pool['used_bytes'],pool['logicalused_bytes'],
                       pool['estimated_send_bytes'],pool['stream_bytes'])
        if manifest.get('snapshot_history')=='current':
            allocation=max(current_dataset_bytes(pool),pool['estimated_send_bytes'],pool['stream_bytes'])
        allocation+=sum(max(int(val(d,'reservation','0')) if val(d,'reservation','0').isdigit() else 0,
                        int(val(d,'refreservation','0')) if val(d,'refreservation','0').isdigit() else 0)
                    for d in pool['datasets'].values())
        required=max(128*MIB,align(allocation+64*MIB))
        estimates[pool['name']]=dict(allocation_bytes=allocation,minimum_partition_bytes=required)
        if pool['name'] != root:
            fixed_part=next(p for p in parts if p.get('pool')==pool['name'])
            require(fixed_part['size_bytes']>=128*MIB,
                    f'{pool["name"]}: preserved boot-pool partition is below the minimum ZFS size')
            if fixed_part['size_bytes']<required:
                warnings.append(f'{pool["name"]}: estimated data exceeds the preserved boot-pool partition size '
                                f'({required/GIB:.2f} GiB estimated, {fixed_part["size_bytes"]/GIB:.2f} GiB available)')
    required=estimates[root]['minimum_partition_bytes']
    overhead=align(2*sector+manifest['disk']['entry_count']*128)
    tail=sector+manifest['disk']['entry_count']*128
    end_limit=(target_size-tail)//MIB*MIB
    fixed=sum(align(p['size_bytes']) for p in parts if p.get('pool')!=root)
    available=end_limit-overhead-fixed
    minimum=overhead+fixed+required+align(tail)
    require(available>=128*MIB,
            'Target too small for fixed boot/swap partitions, GPT, and a minimum-sized root ZFS partition')
    if available<required:
        warnings.append(f'Target too small by the conservative estimate: estimated minimum {minimum/GIB:.2f} GiB '
                        f'for data and disk/filesystem metadata; target is {target_size/GIB:.2f} GiB')
    require(allow_estimated_overflow or not warnings,warnings[0] if warnings else '')
    layout=[]; cursor=overhead
    for p in parts:
        size=available if p.get('pool')==root else p['size_bytes']
        layout.append({**p,'start_lba':cursor//sector,'end_lba':(cursor+size)//sector-1,'size_bytes':size})
        cursor+=align(size)
    return dict(partitions=layout,minimum_bytes=minimum,pools=estimates,capacity_warnings=warnings)


def confirm_restore_capacity(plan,args):
    warnings=plan.get('capacity_warnings',[])
    if not warnings:return
    for warning in warnings:print(f'{diag_stamp()} WARNING: {warning}',flush=True)
    print(f'{diag_stamp()} Compression may allow this restore to fit. Dataset compression settings apply during receive. '
          'The restore can still fail if space runs out or reservations cannot be satisfied.',flush=True)
    if args.dry_run:return
    if getattr(args,'allow_small_target',False):
        print(f'{diag_stamp()} Estimated capacity shortfall accepted with --allow-small-target.',flush=True)
        return
    require(not getattr(args,'unattended',False),
            'Estimated capacity shortfall requires confirmation; use --allow-small-target for unattended restore')
    require(input('Attempt restore despite the estimated capacity shortfall? [y/N]: ').strip().lower() in ('y','yes'),
            'Estimated capacity shortfall was not accepted; restore aborted')


def safe_rel(name):
    p = Path(name)
    require(isinstance(name,str) and name and not p.is_absolute() and '..' not in p.parts
            and str(p)==name and '\n' not in name and '\\' not in name, 'Unsafe artifact path')
    return p


def digest(path):
    h = hashlib.sha256()
    with open(path,'rb') as f:
        for block in iter(lambda:f.read(4*MIB),b''):
            h.update(block)
    return h.hexdigest()


def validate(m):
    require((m['version']==1 and m['backup_type']=='full') or
            (m['version'] in (2,3,4,5) and m['backup_type'] in ('full','incremental')), 'Unsupported backup version/type')
    require(m.get('storage')!='native' or m['version'] in (4,5), 'Native storage requires version 4 or 5')
    if m['version']>=3 or 'hostname' in m:
        valid_hostname(m.get('hostname'))
    if m['backup_type']=='incremental' and m.get('storage')!='native':
        require(re.fullmatch(r'backup-\d{8}-\d{6}',m['parent']), 'Invalid incremental parent')
        require(re.fullmatch(r'[0-9a-f]{64}',m['parent_manifest_sha256']), 'Invalid parent manifest hash')
        require(re.fullmatch(SNAPSHOT_PATTERN,m['base_snapshot']), 'Invalid base snapshot')
    if m['version'] in (4,5):
        require(m.get('snapshot_history','history') in ('current','history'),'Invalid snapshot history policy')
        require(m.get('storage')=='native', 'Version 4/5 requires native storage')
        require(re.fullmatch(r'[A-Za-z][A-Za-z0-9_.:/-]*/linux_os_backup/[a-f0-9]{16}/[A-Za-z0-9_.-]+/'+SNAPSHOT_PATTERN,m['native_root']), 'Invalid native root')
        require(str(m['storage_pool_guid']).isdigit(), 'Invalid storage pool GUID')
    validate_fstab(m['boot']['fstab'])
    require(m['boot'].get('manager','ubuntu-grub') in ('ubuntu-grub','proxmox-grub'), 'Unsupported boot manager')
    require(m['boot']['architecture']=='x86_64' and m['boot']['signed_efi'] is True, 'Unsupported EFI boot configuration')
    require(m['disk']['table_type']=='gpt', 'Only GPT manifests are supported')
    require(m['disk']['logical_sector_size'] in (512,4096), 'Unsupported logical sector size')
    require(1 <= m['disk']['entry_count'] <= 4096, 'Invalid GPT entry count')
    uuid.UUID(m['disk']['guid'])
    require(re.fullmatch(SNAPSHOT_PATTERN,m['snapshot']), 'Invalid backup snapshot name')
    names = set(); numbers = set(); used_paths = set()
    require(m['pools'] and m['disk']['partitions'], 'Empty manifest')
    for pool in m['pools']:
        name = pool['name']
        require(re.fullmatch(r'[A-Za-z][A-Za-z0-9_.:-]*',name) and name not in names, 'Invalid/duplicate pool name')
        names.add(name)
        require(pool['topology']=='stripe' and pool['partitions'], 'Unsupported pool topology')
        require(pool.get('replication_type',m['backup_type']) in ('full','incremental'),'Invalid pool replication type')
        require(9 <= pool['ashift'] <= 16, 'Invalid ashift')
        require(val(pool['datasets'][name],'encryption')=='off', 'Encrypted pool-root unsupported')
        for k in ('allocated_bytes','used_bytes','logicalused_bytes','referenced_bytes','estimated_send_bytes','stream_bytes'):
            require(type(pool[k]) is int and pool[k]>=0, 'Invalid pool size')
        if m.get('storage')!='native':
            require(pool['stream']==f'zfs/{name}.zfs', 'Invalid stream path')
        require(pool['stream_bytes']>0, 'Empty stream')
        if m.get('storage')=='native':
            native=pool['native_dataset']
            require(isinstance(native,str) and re.fullmatch(r'[A-Za-z][A-Za-z0-9_.:/-]*',native)
                    and '..' not in native.split('/') and native.startswith(m['native_root']+'/'), 'Invalid native dataset')
        else:
            used_paths.add(pool['stream'])
        for dataset, ps in pool['datasets'].items():
            require(dataset==name or dataset.startswith(name+'/') or dataset.startswith(name+'@'), 'Dataset outside pool')
            require(not any(c in dataset for c in '\n\r\0'), 'Invalid dataset name')
            require(isinstance(ps,dict), 'Invalid properties')
        require(pool['bootfs']=='-' or pool['bootfs'] in pool['datasets'], 'Unknown bootfs')
    parts = sorted(m['disk']['partitions'],key=lambda p:p['start_lba'])
    last = 1
    for p in parts:
        require(type(p['number']) is int and 1<=p['number']<=m['disk']['entry_count'] and p['number'] not in numbers, 'Invalid partition number')
        numbers.add(p['number']); uuid.UUID(p['partuuid'])
        require(isinstance(p['source_device'],str) and p['source_device'].startswith('/dev/')
                and not any(c in p['source_device'] for c in '\n\r\0'), 'Invalid source partition path')
        require(type(p['attributes']) is int and 0<=p['attributes']<2**64, 'Invalid GPT attributes')
        require(isinstance(p['name'],str) and len(p['name'].encode('utf-16-le'))<=72 and '\0' not in p['name'], 'Invalid GPT name')
        require(p['start_lba']>last and p['end_lba']>=p['start_lba'], 'Overlapping/invalid source geometry')
        last=p['end_lba']
        require(p['size_bytes']==(p['end_lba']-p['start_lba']+1)*m['disk']['logical_sector_size'], 'Invalid partition size')
        if p['kind']=='esp':
            require(p['type_guid']==ESP and p['fat_bits'] in (12,16,32), 'Unsupported ESP')
            require(re.fullmatch(r'[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}',p['fat_uuid']), 'Invalid FAT UUID')
            require(isinstance(p['fat_label'],str) and len(p['fat_label'].encode())<=11, 'Invalid FAT label')
            require(p['archive']==f'efi/esp-{p["number"]}.tar.zst', 'Invalid ESP archive')
            require(isinstance(p['mountpoints'],list) and all(isinstance(x,str) and x.startswith('/')
                    and '..' not in Path(x).parts and x!='/'
                    and not any(x==r or x.startswith(r+'/') for r in ('/dev','/proc','/sys','/run')) for x in p['mountpoints']), 'Invalid ESP mountpoints')
            used_paths.add(p['archive'])
        elif p['kind']=='bios_boot':
            require(p['type_guid']==BIOS and p['image']==f'disk/bios-boot-{p["number"]}.bin', 'Invalid BIOS boot metadata')
            used_paths.add(p['image'])
        elif p['kind']=='zfs':
            require(p['type_guid'] in (ZFS,LINUX_FS) and p['pool'] in names, 'Unsupported ZFS partition')
        elif p['kind']=='swap':
            require(p['type_guid']==SWAP and p.get('swap_version')==1, 'Unsupported swap partition')
            uuid.UUID(p['swap_uuid'])
            require(isinstance(p['swap_label'],str) and len(p['swap_label'].encode())<=15
                    and not any(c in p['swap_label'] for c in '\0\n\r'), 'Invalid swap label')
        else:
            raise Error('Unsupported partition/storage type in manifest')
    require(any(p['kind']=='esp' for p in parts), 'No ESP')
    require(last < m['disk']['size_bytes']//m['disk']['logical_sector_size']-1, 'Partition exceeds source disk')
    points=[x['target'] for x in m['mounts']] + [x for p in parts if p['kind']=='esp' for x in p['mountpoints']]
    require(len(points)==len(set(points)), 'Duplicate/overmounted mountpoints are unsupported')
    for pool in m['pools']:
        require(sorted(pool['partitions'])==sorted(p['number'] for p in parts if p.get('pool')==pool['name']), 'Pool/vdev mapping mismatch')
    validate_pool_layout(m)
    require(m['root_dataset'] in next(p['datasets'] for p in m['pools'] if p['name']==m['root_dataset'].split('/')[0]), 'Unknown root dataset')
    for mount in m['mounts']:
        require(mount['source'] in next(p['datasets'] for p in m['pools'] if p['name']==mount['source'].split('/')[0]), 'Unknown mounted dataset')
        target = mount['target']
        require(target not in ('/dev','/proc','/sys','/run') and not any(target.startswith(x+'/') for x in ('/dev','/proc','/sys','/run')), 'Persistent mount under a runtime filesystem is unsupported')
        require(target.startswith('/') and '..' not in Path(target).parts and '\0' not in target, 'Unsafe mountpoint')
    require(any(x['target']=='/' and x['source']==m['root_dataset'] for x in m['mounts']), 'Root mount missing')
    for f in used_paths:
        safe_rel(f)
    return used_paths


def verify_backup(base,read_native=True,remote=None):
    base=Path(base).resolve()
    if remote:remote.hydrate(base)
    require(base.is_dir(), 'Backup directory missing')
    require(not (base/'manifest.json').is_symlink() and not (base/'SHA256SUMS').is_symlink(), 'Symlinked manifest/checksums')
    m=json.loads((base/'manifest.json').read_text())
    artifacts=validate(m)
    expected={}
    for line in (base/'SHA256SUMS').read_text().splitlines():
        match=re.fullmatch(r'([0-9a-f]{64})  (.+)',line)
        require(match is not None, 'Malformed checksum file')
        h,name=match.groups(); safe_rel(name)
        require(name not in expected and name!='SHA256SUMS', 'Duplicate/invalid checksum')
        expected[name]=h
    required=artifacts|{'manifest.json','disk/gpt.bin','disk/first-megabyte.bin'}
    require(required<=expected.keys(), 'Required artifact missing from checksums')
    print(f'{diag_stamp()} Checking recovery-point artifact checksums…',flush=True)
    for name,h in expected.items():
        p=base/name
        require(p.is_file() and not any(x.is_symlink() for x in [p,*p.parents] if x!=base.parent)
                and p.resolve().is_relative_to(base), 'Unsafe/missing backup artifact')
        require(digest(p)==h, f'SHA-256 mismatch: {name}')
    for p in m['disk']['partitions']:
        if p['kind']=='bios_boot':
            require((base/p['image']).stat().st_size==p['size_bytes'], 'BIOS metadata image size mismatch')
    if m.get('storage')=='native':
        print(f'{diag_stamp()} Checking native snapshot identities…',flush=True)
        verify_native(base,m,read_streams=read_native,**({'remote':remote} if remote else {}))
    for pool in m['pools'] if m.get('storage')!='native' else []:
        require((base/pool['stream']).stat().st_size==pool['stream_bytes'], 'Stream size mismatch')
        # Decode/check stream records before a destructive action (also rejects truncation).
        with open(base/pool['stream'],'rb') as f:
            result=locked_run(['zstream','dump'],stdin=f,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE)
            require(result.returncode==0, 'Invalid ZFS stream: '+result.stderr.decode(errors='replace'))
    for p in m['disk']['partitions']:
        if p['kind']=='esp':
            print(f'{diag_stamp()} Checking ESP archive: {p["archive"]}…',flush=True)
            inspect_tar(base/p['archive'])
    return m


def zfs_repository(path):
    fs=json.loads(run('findmnt','-J','-T',str(path)))['filesystems'][0]
    require(fs['fstype']=='zfs' and '[' not in fs['source'], 'Backup destination must be a locally mounted ZFS filesystem')
    dataset=fs['source']
    require(run('zfs','get','-H','-o','value','encryption',dataset).strip()=='off',
            'Native storage requires an unencrypted destination dataset; raw encrypted source children remain encrypted')
    guid=run('zpool','get','-H','-o','value','guid',dataset.split('/')[0]).strip()
    return dataset,guid


def ensure_native_parent(root,remote=None):
    execute=remote.run if remote else run
    # Quarantine all ancestors before receiving anything; never reuse arbitrary data.
    prefix,tail=root.split('/linux_os_backup/',1)
    current=prefix+'/linux_os_backup'
    existing=set(execute('zfs','list','-H','-o','name').splitlines())
    paths=[current]
    for component in tail.split('/'):
        current+='/'+component; paths.append(current)
    require(root not in existing, 'Native generation already exists; choose a new snapshot name')
    for dataset in paths:
        if dataset in existing:
            require(execute('zfs','get','-H','-o','value','org.linux-os-backup:managed',dataset).strip()=='on',
                    'Refusing to use an unmanaged native namespace: '+dataset)
        else:
            execute('zfs','create','-o','mountpoint=none','-o','canmount=off',
                '-o','sharenfs=off','-o','sharesmb=off','-o','volmode=none',
                '-o','org.linux-os-backup:managed=on',dataset)


def native_receive(dataset,volume=False,compression=None):
    if volume:
        command=['zfs','receive','-u','-o','readonly=on','-o','volmode=none',dataset]
    else:
        command=['zfs','receive','-u','-o','readonly=on','-o','canmount=off',
                 '-x','mountpoint','-x','sharenfs','-x','sharesmb','-x','volmode',dataset]
    return receive_compression(command,compression)


def native_dataset_names(pool,remote=None):
    execute=remote.run if remote else run
    native=pool['native_dataset']
    names=set(execute('zfs','list','-H','-r','-t','filesystem,volume','-o','name',native).splitlines())
    require(native in names and all(n==native or n.startswith(native+'/') for n in names),
            'Invalid native dataset inventory')
    return names


def native_expected_names(pool):
    native=pool['native_dataset']
    expected={native+n[len(pool['name']):] for n in pool['datasets'] if '@' not in n}
    # Include structural parents even in older manifests that omitted them.
    expected |= {n.rsplit('/',i)[0] for n in list(expected)
                 for i in range(1,n.count('/')-native.count('/')+1)}
    return expected


def native_send_argv(pool,snapshot,remote=None):
    if remote:require(pool['native_dataset'].startswith(remote.dataset+'/linux_os_backup/'),'Dataset outside remote repository')
    # Preserve source properties, excluding overrides used only for backup storage.
    argv=['zfs','send','-R','-b']+(['-w'] if pool['encrypted'] else [])+[pool['native_dataset']+'@'+snapshot]
    if 'datasets' in pool:
        native=pool['native_dataset']
        expected=native_expected_names(pool)
        actual=native_dataset_names(pool,remote)
        require(expected<=actual,'Missing datasets required by selected recovery point')
        excluded=actual-expected
        roots=sorted(n for n in excluded if n.rsplit('/',1)[0] not in excluded)
        argv[-1:-1]=[arg for name in roots for arg in ('-X',name)]
    return argv


def native_send(pool,snapshot,remote=None):
    argv=native_send_argv(pool,snapshot,remote)
    if remote:
        remote.check_lock()
        require(pool['native_dataset'].startswith(remote.dataset+'/linux_os_backup/'),'Dataset outside remote repository')
        return remote.command(*argv)
    return argv


def full_restore_streams(pool,snapshot,remote=None,stack=True):
    recursive=native_send_argv(pool,snapshot,remote)
    if stack:return [('',recursive)]
    result=[]
    for name in sorted(native_expected_names(pool),key=lambda n:(n.count('/'),n)):
        relative=name[len(pool['native_dataset']):]
        original=pool['name']+relative
        properties=pool['datasets'].get(original,{})
        encrypted=val(properties,'encryption','on' if pool['encrypted'] else 'off')!='off'
        if encrypted:
            require(val(properties,'encryptionroot')==original and val(properties,'origin')=='-',
                    'Selected-only restore cannot preserve inherited encryption or encrypted clones; use --stack')
        result.append((relative,['zfs','send','-p','-b']+(['-w'] if encrypted else [])+[name+'@'+snapshot]))
    return result


def estimate_native_send(pool,snapshot,remote=None,stack=True):
    execute=remote.run if remote else run
    total=0
    for _,sender in full_restore_streams(pool,snapshot,remote,stack):
        output=execute(*sender[:2],'-n','-P',*sender[2:],combined=True)
        match=re.search(r'^size\s+(\d+)\s*$',output,re.M)
        require(match is not None,'Could not parse full restore stream estimate')
        total+=int(match[1])
    return total


def receive_full_restore(pool,snapshot,receiver,stack,remote=None):
    streams=full_restore_streams(pool,snapshot,remote,stack)
    count=0
    def progress(size):
        nonlocal count
        count+=size
    with transfer_progress('Restore '+pool['name'],lambda:count,pool['estimated_send_bytes']):
        for relative,sender in streams:
            if remote:
                remote.check_lock();sender=remote.command(*sender)
            target=receiver[-1]+relative
            options=receiver[:-1]
            if val(pool['datasets'].get(pool['name']+relative,{}),'type')=='volume':
                options=[arg for i,arg in enumerate(options)
                         if not (arg in ('canmount=off','sharenfs=off','sharesmb=off') or
                                 (arg=='-o' and options[i+1] in ('canmount=off','sharenfs=off','sharesmb=off')))]
            pipe_transfer(sender,options+[target],None,'Restore '+pool['name']+relative,on_bytes=progress)
    return count


def assert_native_tip(pool,snapshot,remote=None):
    execute=remote.run if remote else run
    native=pool['native_dataset']
    def refuse(reason):
        raise Error(f'{native}: {reason}. Incremental backup stopped; automatic backup branches are unsupported. '
                    'Existing backups are preserved. Resolve the incomplete/newer backup state, or explicitly '
                    'use --full to start a new full generation.')
    pending=execute('zfs','get','-H','-o','value','org.linux-os-backup:pending',native.rsplit('/',1)[0]).strip()
    if pending!='-':
        refuse(f'Native generation has an incomplete backup (pending: {pending})')
    resume=execute('zfs','get','-H','-o','value','receive_resume_token',native).strip()
    if resume!='-':
        refuse('Incomplete native receive')
    names=execute('zfs','list','-H','-r','-t','snapshot','-o','name','-s','createtxg',native).splitlines()
    roots=[n.split('@',1)[1] for n in names if n.split('@',1)[0]==native and re.fullmatch(SNAPSHOT_PATTERN,n.split('@',1)[1])]
    latest=max((snapshot_stamp(n) for n in roots),default=None)
    if [n for n in roots if snapshot_stamp(n)==latest]!=[snapshot]:
        refuse('Native backup has an uncommitted or newer snapshot')
    by_dataset={}
    for name in names:
        dataset,snap=name.split('@',1)
        by_dataset.setdefault(dataset,[]).append(snap)
    if any(snapshot in snaps and snaps[-1]!=snapshot for snaps in by_dataset.values()):
        refuse('Native backup has newer snapshots after the common base')


def verify_native(base,m,read_streams=False,remote=None):
    execute=remote.run if remote else run
    dataset,guid=(remote.dataset,remote.guid) if remote else zfs_repository(base)
    require(guid==m['storage_pool_guid'] and m['native_root'].startswith(dataset+'/linux_os_backup/'),
            'Native data is not on the metadata repository ZFS filesystem/pool')
    for pool in m['pools']:
        for source,properties in pool['datasets'].items():
            if '@' in source:
                continue
            original=pool['datasets'].get(source+'@'+m['snapshot'],{})
            expected=val(original,'guid')
            target=pool['native_dataset']+source[len(pool['name']):]+'@'+m['snapshot']
            actual=execute('zfs','get','-H','-o','value','guid',target).strip()
            require(expected!='-' and actual==expected, 'Missing/mismatched native snapshot: '+target)
        if read_streams:
            # ZFS checks data block integrity as it reads; zstream verifies stream records.
            # Drain a generated full stream before any restore destination writes.
            size=pipe_transfer(native_send(pool,m['snapshot'],**({'remote':remote} if remote else {})),['zstream','dump'],
                          pool['estimated_send_bytes'],'Verify '+pool['name'])
            # Use the complete selected restore stream for capacity planning,
            # not the bytes transferred in the last incremental.
            pool['estimated_send_bytes']=size; pool['stream_bytes']=size


def restore_mount_properties(pool):
    datasets=sorted(((n,p) for n,p in pool['datasets'].items() if '@' not in n),
                    key=lambda item:(item[0].count('/'),item[0]))
    for name,properties in datasets:
        if val(properties,'type')=='filesystem' or val(properties,'mountpoint')!='-':
            require(val(properties,'canmount') in ('on','off','noauto'),
                    'Missing/invalid saved canmount property: '+name)
    # Import -N / receive -u only suppress mounting during those commands.
    # Setting OR inheriting mount/share properties can subsequently mount a
    # dataset, including descendants. Keep the entire tree disabled until all
    # such properties are restored, even when the selected snapshot is already
    # present and no receive has installed temporary property overrides.
    filesystems=[(n,p) for n,p in datasets if val(p,'canmount')!='-']
    for name,_ in reversed(filesystems):
        run('zfs','set','canmount=off',name)
    for name,properties in datasets:
        for prop in ('mountpoint','sharenfs','sharesmb','volmode','readonly'):
            value=val(properties,prop)
            if value!='-':
                source=properties[prop].get('source','local')
                if source.startswith('inherited from'):
                    run('zfs','inherit',prop,name)
                else:
                    run('zfs','set',prop+'='+value,name)
    # canmount is not inherited. Enabling it does not mount the filesystem.
    for name,properties in filesystems:
        run('zfs','set','canmount='+val(properties,'canmount'),name)


def finish_restore_writes(pool,alias):
    for name,properties in sorted(pool['datasets'].items(),key=lambda item:(item[0].count('/'),item[0])):
        if '@' in name:continue
        target=alias+name[len(pool['name']):]
        saved=properties.get('sync',{'value':'standard','source':'default'})
        require(saved['value'] in ('standard','always','disabled'),'Invalid saved sync property: '+name)
        if saved.get('source','').startswith('inherited from'):
            run('zfs','inherit','sync',target)
        else:
            run('zfs','set','sync='+saved['value'],target)
    run('zpool','sync',alias)


def transfer_stderr(stream):
    try:
        size=os.fstat(stream.fileno()).st_size
        return os.pread(stream.fileno(),65536,max(0,size-65536)).decode(errors='replace').strip()
    except OSError:return ''


def stop_transfer_processes(processes,receiver=None):
    """Allow EOF cleanup, then terminate with bounded waits, including after SIGKILL."""
    processes=[p for p in processes if p is not None]
    # Block pool operations even if cleanup itself is interrupted or fails.
    for process in processes:
        if process.poll() is None and process not in UNREAPED_TRANSFERS:
            UNREAPED_TRANSFERS.append(process)
    def wait(process,timeout):
        try:
            process.wait(timeout=timeout)
            diagnostic_event(f'cleanup child pid={process.pid} exit={process.returncode}')
            return True
        except subprocess.TimeoutExpired:
            diagnostic_event(f'cleanup wait timed out: '+diagnostic_process(process.pid))
            return False
        except OSError as exc:
            diagnostic_event(f'cleanup wait pid={process.pid}: {exc}')
            return False
    def signal_group(process,sig):
        diagnostic_event(f'cleanup signal {sig.name} to process group {process.pid}')
        try:os.killpg(process.pid,sig)
        except ProcessLookupError:pass
        except OSError as exc:
            with contextlib.suppress(OSError):
                print(f'WARNING: Could not signal transfer process {process.pid}: {exc}',file=sys.stderr,flush=True)
    try:
        if receiver is not None and receiver.poll() is None:
            diagnostic_event(f'cleanup waiting up to {TRANSFER_EOF_TIMEOUT}s for receiver EOF handling')
            wait(receiver,TRANSFER_EOF_TIMEOUT)
        pending=[p for p in processes if p.poll() is None]
        for process in pending:signal_group(process,signal.SIGTERM)
        stubborn=[p for p in pending if not wait(p,TRANSFER_TERM_TIMEOUT)]
        for process in stubborn:signal_group(process,signal.SIGKILL)
        for process in stubborn:
            if not wait(process,TRANSFER_KILL_TIMEOUT) and process.poll() is None:
                with contextlib.suppress(OSError):
                    print(f'WARNING: Transfer process {process.pid} has not exited after SIGKILL; '
                          'leaving pools imported and stopping further ZFS commands.',file=sys.stderr,flush=True)
    finally:
        UNREAPED_TRANSFERS[:]=[p for p in UNREAPED_TRANSFERS if p.poll() is None]


def pipe_transfer(sender,receiver,total,label,on_bytes=None):
    # Unbuffered pipes cannot flush pending stream data during failure cleanup.
    count=0;started=time.monotonic();last_progress=started;stage='starting'
    diagnostic_event(f'{label}: pipeline starting')
    diagnostic_event(f'{label}: sender={shlex.join(sender)}; receiver={shlex.join(receiver)}')
    with tempfile.TemporaryFile() as senderr, tempfile.TemporaryFile() as recverr, tempfile.TemporaryFile() as iostat:
        send=None;recv=None;iostat_process=None;monitor_thread=None;failure=None
        monitor_stop=threading.Event()
        def phase(value):
            nonlocal stage
            stage=value
            diagnostic_event(f'{label}: stage={stage}; bytes={count}')
        def monitor():
            previous=0;previous_time=time.monotonic();positions={}
            while not monitor_stop.wait(DIAGNOSTIC_INTERVAL):
                now=time.monotonic()
                diagnostic_event(f'{label}: stage={stage}; bytes={count}; '
                    f'rate={(count-previous)/max(now-previous_time,1e-9)/MIB:.1f} MiB/s; '
                    f'no progress for {duration(now-last_progress)}')
                for role,process in (('sender',send),('receiver',recv),('iostat',iostat_process)):
                    if process is not None:
                        diagnostic_event(f'{label}: {role} exit={process.poll()}; '+diagnostic_process(process.pid))
                for role,stream in (('sender stderr',senderr),('receiver stderr',recverr),('zpool iostat',iostat)):
                    try:
                        offset=positions.get(role,0)
                        size=os.fstat(stream.fileno()).st_size
                        data=os.pread(stream.fileno(),65536,max(offset,size-65536))
                        positions[role]=size
                        if data:diagnostic_event(f'{label}: {role}: '+data.decode(errors='replace').strip())
                    except OSError:pass
                previous=count;previous_time=now
        def check_children():
            sc=send.poll();rc=recv.poll()
            require(sc in (None,0),f'Sender exited with status {sc}')
            require(rc is None,f'Receiver exited before stream EOF with status {rc}')
        try:
            send=locked_popen(sender,stdout=subprocess.PIPE,stderr=senderr,bufsize=0,start_new_session=True)
            recv=locked_popen(receiver,stdin=subprocess.PIPE,stdout=subprocess.DEVNULL,stderr=recverr,
                                  bufsize=0,start_new_session=True)
            os.set_blocking(send.stdout.fileno(),False);os.set_blocking(recv.stdin.fileno(),False)
            diagnostic_event(f'{label}: sender pid={send.pid}; receiver pid={recv.pid}')
            if DIAGNOSTIC:
                pools=list(dict.fromkeys(args[-1].split('/',1)[0].split('@',1)[0]
                    for args,verb in ((sender,'send'),(receiver,'receive')) if args[:2]==['zfs',verb]))
                if pools and shutil.which('zpool'):
                    try:
                        iostat_process=locked_popen(['zpool','iostat','-Hp',*pools,'5'],
                            stdout=iostat,stderr=iostat,start_new_session=True)
                    except OSError as exc:diagnostic_event(f'{label}: iostat unavailable: {exc}')
                monitor_thread=threading.Thread(target=monitor,name='zfs-transfer-monitor',daemon=True)
                monitor_thread.start()
            with (transfer_progress(label,lambda:count,total) if on_bytes is None else contextlib.nullcontext()):
                while True:
                    stage='reading sender'
                    check_children()
                    if not select.select([send.stdout],[],[],1)[0]:continue
                    try:block=os.read(send.stdout.fileno(),MIB)
                    except BlockingIOError:continue
                    if not block:break
                    pending=memoryview(block)
                    while pending:
                        stage='writing receiver'
                        check_children()
                        if not select.select([],[recv.stdin],[],1)[1]:continue
                        try:written=os.write(recv.stdin.fileno(),pending)
                        except BlockingIOError:continue
                        require(written>0,'Receiver pipe accepted no data')
                        pending=pending[written:];count+=written;last_progress=time.monotonic()
                        if on_bytes is not None:on_bytes(written)
                phase('closing receiver input')
                recv.stdin.close()
                while True:
                    sc=send.poll();rc=recv.poll()
                    require(sc in (None,0),f'Sender exited with status {sc}')
                    require(rc in (None,0),f'Receiver exited with status {rc}')
                    if sc==0 and rc==0:break
                    waiting='waiting for sender exit' if sc is None else 'waiting for receiver exit'
                    if stage!=waiting:phase(waiting)
                    try:(send if sc is None else recv).wait(timeout=1)
                    except subprocess.TimeoutExpired:pass
                phase('transfer complete')
        except BaseException as exc:
            failure=exc
            diagnostic_event(f'{label}: transfer failed: {type(exc).__name__}: {exc}')
        finally:
            phase('cleanup')
            try:
                for stream in (send.stdout if send else None,recv.stdin if recv else None):
                    if stream is not None:
                        try:stream.close()
                        except OSError as exc:diagnostic_event(f'{label}: pipe close failed: {exc}')
            finally:
                try:stop_transfer_processes((send,recv,iostat_process),recv)
                finally:
                    monitor_stop.set()
                    if monitor_thread is not None:monitor_thread.join(timeout=1)
            for role,process,stream in (('sender',send,senderr),('receiver',recv,recverr)):
                diagnostic_event(f'{label}: {role} exit={process.poll() if process else "not started"}; '
                                 f'stderr={transfer_stderr(stream)}')
            if iostat_process is not None:
                diagnostic_event(f'{label}: final zpool iostat: '+transfer_stderr(iostat))
            diagnostic_event(f'{label}: cleanup finished')
        if failure is not None:
            if isinstance(failure,(Error,OSError)):
                details='; '.join(x for x in (str(failure),transfer_stderr(senderr),transfer_stderr(recverr)) if x)
                raise Error('Native transfer failed: '+details) from failure
            raise failure
        require(not UNREAPED_TRANSFERS,'Transfer cleanup incomplete; pools left imported')
    diagnostic_event(f'{label}: pipeline finished in {duration(time.monotonic()-started)} '
                     f'({count/GIB:.3f} GiB)')
    return count


def valid_hostname(hostname):
    require(isinstance(hostname,str) and len(hostname)<=253 and
            re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9_.-]*[A-Za-z0-9])?',hostname) is not None,
            'Hostname must be a safe, nonempty host name (letters, digits, dots, underscores, hyphens)')
    return hostname


def host_repository(repository,hostname):
    valid_hostname(hostname)
    repository=Path(repository).resolve()
    hosts=repository/'hosts'
    require(not hosts.is_symlink(), 'Unsafe hosts directory')
    hosts.mkdir(exist_ok=True,mode=0o700)
    path=hosts/hostname
    require(not path.is_symlink(), 'Unsafe host directory')
    path.mkdir(exist_ok=True,mode=0o700)
    return path


def select_host_repository(path,host=None,unattended=False):
    path=Path(path).resolve()
    if host is not None:
        valid_hostname(host)
    # Explicit recovery-point and per-host paths already identify their host.
    if (path/'manifest.json').is_file():
        m=json.loads((path/'manifest.json').read_text())
        require(host is None or m.get('hostname')==host, 'Requested host does not match this backup')
        return path
    hosts=path/'hosts'
    if hosts.exists():
        require(hosts.is_dir() and not hosts.is_symlink(), 'Unsafe hosts directory')
        choices=[]
        for directory in sorted(hosts.iterdir()):
            require(not directory.is_symlink(), 'Symlinked host directory is unsupported')
            if directory.is_dir():
                valid_hostname(directory.name)
                entries=catalog(directory)
                if entries:
                    require(all(m.get('hostname')==directory.name for _,m in entries), 'Backup host identity disagrees with its directory')
                    choices.append(directory.name)
        require(choices, 'No hosts with complete backups found')
        if host is None:
            for i,name in enumerate(choices,1):
                print(f'{i}. {name}')
            if len(choices)==1:
                host=choices[0]
                print(f'Automatically selected host: {host}')
            else:
                require(not unattended,'Non-interactive restore requires --host when multiple hosts are available')
                answer=input('Restore host (name or number): ').strip()
                host=choices[int(answer)-1] if answer.isdigit() and 1<=int(answer)<=len(choices) else answer
        require(host in choices, 'Requested host has no complete backups on this target')
        return hosts/host
    entries=catalog(path)
    if host is not None:
        require(entries and all(m.get('hostname')==host for _,m in entries),
                'Requested host does not match this directory or its hostname is not recorded')
    elif entries:
        identities={m.get('hostname') for _,m in entries}
        require(len(identities)==1, 'Mixed-host directory; use the hosts/<hostname> repository structure')
    return path


def catalog(repository):
    result=[]
    for path in sorted(Path(repository).glob('backup-*')):
        if path.is_dir() and not path.is_symlink() and (path/'manifest.json').is_file() and (path/'SHA256SUMS').is_file():
            m=json.loads((path/'manifest.json').read_text())
            validate(m)
            result.append((path,m))
    return result


def local_snapshot_time(timestamp):
    return dt.datetime.fromtimestamp(timestamp,dt.timezone.utc).astimezone().strftime('%Y-%m-%d %H:%M:%S %Z (%z)')


def select_backup(path, snapshot=None, listing=False, host=None, show_sizes=False,remote=None,snapshot_index=None,unattended=False,stack=True):
    path=select_host_repository(path,host,unattended)
    entries=[(path,json.loads((path/'manifest.json').read_text()))] if (path/'manifest.json').is_file() else catalog(path)
    require(entries, 'No complete backups found')
    if show_sizes:
        print('Estimating full ZFS restore sizes (not incremental transfer sizes)…')
    for i,(entry,m) in enumerate(entries,1):
        size_text=''
        if show_sizes:
            if m.get('storage')=='native':
                try:
                    total=sum(estimate_native_send(pool,m['snapshot'],stack=stack,**({'remote':remote} if remote else {})) for pool in m['pools'])
                    size_text=f'  |  ZFS restore: ~{total/GIB:.3f} GiB'
                except (Error,OSError) as exc:
                    size_text=f'  |  ZFS restore size unavailable: {exc}'
            else:
                size_text='  |  ZFS restore size unavailable'
            size_text+='  |  Saved snapshot '+dataset_size_text(saved_snapshot_sizes(m['pools'],m['snapshot']))
        created=dt.datetime.strptime(snapshot_stamp(m['snapshot']),'%Y%m%d-%H%M%S').replace(tzinfo=dt.timezone.utc)
        print(f'{i}. {m["snapshot"]}  {local_snapshot_time(created.timestamp())}  {m["backup_type"]}  {entry.name}{size_text}')
    if show_sizes:
        print('Sizes estimate full ZFS streams; EFI/BIOS data and destination filesystem overhead are additional.')
        print('Dataset sizes describe the selected source snapshot, excluding other history; destination allocation can differ.')
    if listing:
        return None
    if snapshot:
        found=[entry for entry,m in entries if snapshot in (m['snapshot'],entry.name)]
        require(len(found)==1, 'Snapshot selection is missing or ambiguous')
        return found[0]
    if snapshot_index is not None:
        require(1<=snapshot_index<=len(entries),'Snapshot index is outside the available recovery points')
        return entries[-snapshot_index][0]
    if len(entries)==1:
        return entries[0][0]
    if unattended:
        return entries[-1][0]
    answer=input(f'Restore snapshot [latest: {len(entries)}]: ').strip()
    index=int(answer) if answer else len(entries)
    require(1<=index<=len(entries), 'Invalid snapshot selection')
    return entries[index-1][0]


def chain_identity(m):
    return (m.get('hostname'),m['disk']['guid'], sorted((p['name'],p['guid'],p['partitions']) for p in m['pools']))


def verify_chain(base,read_native=True,remote=None):
    chain=[]; seen=set(); path=Path(base).resolve(); repository=path.parent
    while True:
        require(path not in seen, 'Incremental chain cycle')
        seen.add(path)
        kwargs={'remote':remote} if remote else {}
        m=verify_backup(path,**kwargs) if read_native else verify_backup(path,read_native=False,**kwargs)
        chain.append((path,m))
        if m['backup_type']=='full' or m.get('storage')=='native':
            break
        parent=repository/m['parent']
        require(parent.is_dir() and not parent.is_symlink(), 'Missing/unsafe incremental base')
        require(digest(parent/'manifest.json')==m['parent_manifest_sha256'], 'Incremental parent manifest changed')
        path=parent
    chain.reverse()
    for (_,a),(_,b) in zip(chain,chain[1:]):
        require(b['base_snapshot']==a['snapshot'] and chain_identity(a)==chain_identity(b), 'Incremental chain identity mismatch')
        require(snapshot_stamp(b['snapshot'])>snapshot_stamp(a['snapshot']), 'Incremental snapshots are not chronological')
    return chain


def replication_flags(pool,m):
    flags=['-R']+(['-w'] if pool['encrypted'] else [])
    if m['backup_type']=='incremental':
        flags+=['-I',pool['name']+'@'+m['base_snapshot']]
    return flags


def backup_streams(pool,m,previous=None):
    """Parent-first sends; --stack selects history for this operation only."""
    stacked=m.get('snapshot_history','history')=='history'
    full=m['backup_type']=='full' or pool.get('replication_type')=='full'
    if stacked and full:
        return [dict(source=pool['name'],destination=pool['native_dataset'],
                     flags=replication_flags(pool,dict(m,backup_type='full')))]
    prior=set() if previous is None else {n for n in previous['datasets'] if '@' not in n}
    streams=[]
    for name in sorted((n for n in pool['datasets'] if '@' not in n),key=lambda n:(n.count('/'),n)):
        properties=pool['datasets'][name]
        encrypted=val(properties,'encryption','off')!='off'
        incremental=not full and name in prior
        if encrypted and not incremental:
            require(val(properties,'encryptionroot')==name and val(properties,'origin')=='-',
                    f'{name}: a standalone full send cannot preserve inherited encryption or encrypted clone relationships; use --full --stack')
        flags=['-p']+(['-w'] if encrypted else [])
        entry=dict(source=name,destination=pool['native_dataset']+name[len(pool['name']):],
                   volume=val(properties,'type')=='volume',snapshot=m['snapshot'])
        if incremental:
            flags+=['-I' if stacked else '-i',name+'@'+m['base_snapshot']]
        elif stacked:
            # Newly added datasets have no backup base. Seed their oldest snapshot
            # then send the remaining history, without depending on clone origins.
            snapshots=[]
            for snap,ps in pool['datasets'].items():
                if snap.startswith(name+'@'):
                    txg=val(ps,'createtxg')
                    require(txg.isdigit(),'Missing snapshot creation order: '+snap)
                    snapshots.append((int(txg),snap.split('@',1)[1]))
            current=next((txg for txg,snap in snapshots if snap==m['snapshot']),None)
            eligible=[(txg,snap) for txg,snap in snapshots if current is None or txg<=current]
            if eligible:
                oldest=min(eligible)[1]
                if oldest!=m['snapshot']:
                    streams.append(dict(entry,flags=list(flags),snapshot=oldest))
                    flags+=['-I',name+'@'+oldest]
        streams.append(dict(entry,flags=flags))
    return streams


def select_snapshot_history(args):
    return 'history' if getattr(args,'stack',False) else 'current'


def incremental_parent(repository,m,explicit=None,full=False,native_only=False,remote=None,required=False):
    require(not (full and required),'--full and --incremental cannot be combined')
    if full:
        return None
    candidates=[(p,old) for p,old in catalog(repository)
                if chain_identity(old)==chain_identity(m)
                and snapshot_stamp(old['snapshot'])<=snapshot_stamp(m['snapshot'])
                and (not native_only or old.get('storage')=='native')]
    if explicit:
        candidates=[(p,old) for p,old in candidates if explicit in (p.name,old['snapshot'])]
        require(len(candidates)==1, 'Requested incremental base is missing or belongs to another source')
    if not candidates:
        require(not required,'--incremental: no matching backup base found; aborted without starting a full backup')
        return None
    selected=None
    for parent,old in reversed(candidates):
        changes=[]
        for pool in m['pools']:
            prev=next(p for p in old['pools'] if p['name']==pool['name'])
            current={d for d in pool['datasets'] if '@' not in d}
            previous={d for d in prev['datasets'] if '@' not in d}
            replacements=[]
            usable=True
            for dataset in sorted(current & previous):
                before=val(prev['datasets'][dataset],'guid')
                after=val(pool['datasets'][dataset],'guid')
                origin=val(prev['datasets'][dataset],'origin')
                if ((before!='-' and after!='-' and before!=after) or
                        (origin!='-' and origin!=val(pool['datasets'][dataset],'origin'))):
                    replacements.append(dataset)
                    continue
                snap=dataset+'@'+old['snapshot']
                expected=val(prev['datasets'].get(snap,{}),'guid')
                actual=run('zfs','get','-H','-o','value','guid',snap,check=False).strip()
                if expected=='-' or actual!=expected:
                    usable=False
                    break
            if not usable:
                break
            if required:
                if replacements:
                    break
                added=current-previous
                if added:
                    stored=native_dataset_names(prev,remote)
                    if any(prev['native_dataset']+n[len(pool['name']):] in stored for n in added):
                        break
            changes.append((pool,prev,sorted(current-previous),sorted(previous-current),replacements))
        else:
            selected=(parent,old,changes)
            break
    if selected is None:
        require(not required,'--incremental: no usable matching base for every source pool; aborted without starting a full backup')
        require(not explicit,'Requested incremental base has no usable common source snapshot')
        print('No usable common snapshot found; starting a full backup.')
        return None
    parent,old,changes=selected
    verify_chain(parent,read_native=not native_only,**({'remote':remote} if remote else {}))
    print(f'{diag_stamp()} Incremental base: '+old['snapshot'])
    for pool,prev,added,removed,replacements in changes:
        if added:
            stored=native_dataset_names(prev,remote)
            replacements += [n for n in added if prev['native_dataset']+n[len(pool['name']):] in stored]
        if replacements:
            require(not required,'--incremental: dataset identities changed; refusing to replace a pool with a full copy')
            pool['replication_type']='full'
            print('Automatically creating a fresh copy of '+pool['name']+' for changed identities or reused names: '+', '.join(sorted(replacements)))
        if removed:
            print('Removed datasets retained only in earlier recovery points: '+', '.join(removed))
        if added:
            print('New datasets included in replication: ' + ', '.join(added))
    return parent,old


@contextlib.contextmanager
def repository_lock(repository,shared=False,name='.backup.lock'):
    with file_lock(Path(repository)/name,shared=shared,description='Backup repository '+str(repository)):
        yield


@contextlib.contextmanager
def repository_reader(repository,host=None,unattended=False):
    with repository_lock(repository,shared=True,name='.readers.lock'):
        selected=select_host_repository(repository,host,unattended)
        hostdir=selected.parent if (selected/'manifest.json').is_file() else selected
        with repository_lock(hostdir,shared=True,name='.host.lock'):
            yield selected


@contextlib.contextmanager
def pool_search_directory(member):
    # Directory scanning works across OpenZFS versions and avoids a broad /dev scan.
    # Keep the directory until export because ZFS may retain this path in memory.
    with tempfile.TemporaryDirectory(prefix='lllzorb-import-') as directory:
        member = stable_device(member)
        (Path(directory)/Path(member).name).symlink_to(member)
        yield directory


def check_import_discovery(directory,guid,name,member):
    listing=run('zpool','import','-d',directory,combined=True)
    def found(text):
        return guid in re.findall(r'^\s*id:\s*(\d+)\s*$',text,re.M)
    if found(listing):
        return []
    destroyed=run('zpool','import','-D','-d',directory,combined=True)
    if found(destroyed):
        print(f'Previously destroyed ZFS pool found on {member}: {name} (GUID {guid}).')
        print('Preparing a fresh backup pool; disk erasure still requires destructive confirmation.')
        raise ReinitializeDestroyedPool('Destroyed pool identified; initialize only after confirmation')
    raise Error(
        f'Backup pool {name} (GUID {guid}) has a label on {member}, but OpenZFS '
        f'did not discover it as normal or destroyed. No disk initialization was attempted. '
        f'Inspect with: zpool import -d /dev/disk/by-id; zdb -l {member}. '
        f'Discovery output: {listing.strip() or "(none)"}; destroyed: {destroyed.strip() or "(none)"}')


def import_backup_pool(directory,guid,name):
    """Import a recognized backup pool, repairing only a stale host-id marker."""
    command=['zpool','import','-N','-o','cachefile=none','-d',directory,guid]
    try:
        run(*command)
    except Error as exc:
        if 'pool was previously in use from another system' not in str(exc):
            raise
        print(f'Backup pool {name} was last used by another system; force-importing it once.')
        run('zpool','import','-N','-f','-o','cachefile=none','-d',directory,guid)


def mount_zfs_at(dataset,target):
    # Managed datasets require zfsutil when mounted at a temporary recovery path.
    # Keep their stored mountpoint property intact; legacy datasets use normal mount.
    mountpoint=run('zfs','get','-H','-o','value','mountpoint',dataset).strip()
    require(mountpoint=='legacy' or mountpoint.startswith('/'),
            f'Dataset {dataset} has no mountable filesystem mountpoint: {mountpoint}')
    options=[] if mountpoint=='legacy' else ['-o','zfsutil']
    run('mount','-t','zfs',*options,dataset,target)


def private_storage_namespace():
    global PRIVATE_STORAGE_NAMESPACE
    if PRIVATE_STORAGE_NAMESPACE:return
    # Keep temporary backup mounts out of other operations' mount namespaces.
    if ctypes.CDLL(None,use_errno=True).unshare(0x00020000)!=0:
        code=ctypes.get_errno()
        raise OSError(code,os.strerror(code))
    run('mount','--make-rprivate','/')
    PRIVATE_STORAGE_NAMESPACE=True


@contextlib.contextmanager
def backup_pool_usage(device,member,name,guid,source):
    state_path=lock_directory()/('pool-'+guid+'.json')
    search=lock_directory()/('pool-'+guid+'-devices')
    with contextlib.ExitStack() as users:
        admitted=False
        try:
            with local_lock('pool-gate:'+guid,wait=True):
                users.enter_context(local_lock('pool-users:'+guid,shared=True))
                admitted=True
                imported=name in run('zpool','list','-H','-o','name').splitlines()
                if not imported:
                    target_idle(device,[source] if source is not None else [])
                    search.mkdir(mode=0o700,exist_ok=True)
                    link=search/Path(member).name
                    if link.is_symlink():link.unlink()
                    link.symlink_to(member)
                    check_import_discovery(str(search),guid,name,member)
                    state=dict(name=name,guid=guid,member=member)
                    pending=state_path.with_suffix('.pending')
                    pending.write_text(json.dumps(state)+'\n')
                    os.replace(pending,state_path)
                    import_backup_pool(str(search),guid,name)
                require(val(props('zpool',name)[name],'guid')==guid and
                        [os.path.realpath(p) for p in pool_leaves(name)]==[os.path.realpath(member)],
                        'Backup pool identity mismatch')
            yield
        finally:
            if admitted:
                with local_lock('pool-gate:'+guid,wait=True):
                    users.close()
                    try:
                        last=local_lock('pool-users:'+guid)
                        last.__enter__()
                    except LockBusy:
                        pass
                    else:
                        try:
                            if state_path.exists():
                                state=json.loads(state_path.read_text())
                                require(state['name']==name and state['guid']==guid and
                                        os.path.realpath(state['member'])==os.path.realpath(member),
                                        'Backup pool ownership record mismatch')
                                if name in run('zpool','list','-H','-o','name').splitlines():
                                    require(val(props('zpool',name)[name],'guid')==guid and
                                            [os.path.realpath(p) for p in pool_leaves(name)]==[os.path.realpath(member)],
                                            'Backup pool identity changed before export')
                                    run('zpool','export',name)
                                state_path.unlink()
                                shutil.rmtree(search)
                        finally:
                            last.__exit__(None,None,None)


@contextlib.contextmanager
def existing_store(device,source):
    private_storage_namespace()
    with device_lock(device,shared=True):
        with existing_store_locked(device,source) as repository:
            yield repository


@contextlib.contextmanager
def existing_store_locked(device,source):
    device=stable_device(device)
    require(source is None or os.path.realpath(device)!=os.path.realpath(source), 'Backup destination is the source disk')
    disk=node_for(device)
    require(disk['type']=='disk','Backup storage must be a whole disk device')
    require(not is_zvol(disk), 'Backup storage cannot be a ZFS virtual disk')
    nodes=list(tree_nodes([disk]))
    # A whole-disk signature is not an additional partition.
    members=[n for n in nodes if n.get('type')=='part' and n.get('fstype')=='zfs_member']
    require(len(members)==1, 'Existing backup disk must have exactly one backup-storage ZFS partition '
            f'(found {len(members)})')
    member=dict(members[0],path=stable_device(members[0]['path']))
    label=dict(line.split('=',1) for line in run('blkid','-p','-o','export',member['path']).splitlines() if '=' in line)
    name=label.get('LABEL',''); guid=label.get('UUID','')
    require(name.startswith(('linux_os_backup_','baremetal_store_')) and guid.isdigit(),
            'Existing disk is not a recognized backup-storage pool; select a recognized backup disk')
    with backup_pool_usage(device,member['path'],name,guid,source):
        # Each operation owns its mount, independently of other mount namespaces.
        with recovery_directory('lllzorb-store-') as tmp:
            mount_zfs_at(name,tmp)
            try:
                yield tmp
            finally:
                run('umount',tmp)


def inspect_tar(path):
    proc=locked_popen(['zstd','-dc',str(path)],stdout=subprocess.PIPE)
    try:
        with tarfile.open(fileobj=proc.stdout,mode='r|') as archive:
            for member in archive:
                name=member.name
                require(not name.startswith('/') and '..' not in Path(name).parts,
                        'Unsafe ESP archive member')
                require(member.isfile() or member.isdir(), 'ESP archive contains links or special files')
        # tar stops at its end markers before consuming trailing record padding.
        # Drain stdout before wait: zstd can otherwise block on a full pipe while
        # the parent waits forever for zstd to exit. Also detects late zstd errors.
        while proc.stdout.read(1024*1024):
            pass
        require(proc.wait()==0, 'Invalid compressed ESP archive')
    finally:
        proc.stdout.close()
        if proc.poll() is None:
            proc.terminate(); proc.wait()


def is_zvol(node):
    name = node.get('kname') or os.path.realpath(node.get('path', ''))
    return re.fullmatch(r'zd\d+(?:p\d+)?', Path(name).name) is not None


def print_disk_choices(choices):
    if not choices:return
    fields=[('model','model'),('serial','serial')]
    fields += [(key,label) for key,label in (('wwn','WWN'),('tran','connection'))
               if any((node.get(key) or '').strip() for node,_ in choices)]
    rows=[]
    for node,status in choices:
        rows.append([node['path'],f'{int(node["size"])/GIB:.1f} GiB',
                     *(label+': '+((node.get(key) or '').strip() or 'unavailable') for key,label in fields),status])
    widths=[max(len(row[i]) for row in rows) for i in range(len(rows[0])-1)]
    number_width=len(str(len(rows)))
    for number,row in enumerate(rows,1):
        disk=f'{row[0]:<{widths[0]}}  {row[1]:>{widths[1]}}'
        details=[f'{row[i]:<{widths[i]}}' for i in range(2,len(row)-1)]
        print(f'{number:>{number_width}}. '+'  |  '.join([disk,*details,row[-1]]))


def require_target_not_imported(device,nodes):
    # Check actual device membership.
    selected={os.path.realpath(n['path']) for n in nodes}|{os.path.realpath(device)}
    status=run('zpool','status','-LP')
    paths=re.findall(r'^\s+(/\S+)\s',status,re.M)
    require(not any(os.path.realpath(path) in selected for path in paths),
            'Target belongs to an imported pool')


def target_idle(device, forbidden=()):
    n=node_for(device)
    require(not is_zvol(n), 'ZFS virtual disks cannot be backup or restore destinations')
    device=stable_device(device)
    require(n['type']=='disk' and stat.S_ISBLK(os.stat(device).st_mode), 'Target must be a whole disk')
    require(os.path.realpath(device) not in {os.path.realpath(x) for x in forbidden}, 'Target is a protected disk')
    require(not n.get('ro'), 'Target is read-only')
    nodes=list(tree_nodes([n]))
    swaps={os.path.realpath(line.split()[0]) for line in Path('/proc/swaps').read_text().splitlines()[1:]}
    for x in nodes:
        require(x['type'] in ('disk','part'), 'Target has active storage layers')
        x['path']=stable_device(x['path'])
        require(not any(x.get('mountpoints') or []) and os.path.realpath(x['path']) not in swaps,
                f'Target is mounted or used as swap: {x["path"]}')
        holders=Path('/sys/class/block',Path(os.path.realpath(x['path'])).name,'holders')
        require(holders.is_dir() and not list(holders.iterdir()), f'Target has holders: {x["path"]}')
    require_target_not_imported(device,nodes)
    # O_EXCL asks the kernel to reject block devices held by active users.
    fd=os.open(device,os.O_RDONLY|os.O_EXCL); os.close(fd)
    return n


def cleanup_orphan_restore_pools(device):
    """Called with the selected target locked; leave other disks untouched."""
    members=None
    rows=run('zpool','list','-H','-o','name,altroot,health',check=False).splitlines()
    for row in rows:
        fields=row.split('\t')
        if len(fields)!=3:continue
        name,altroot,health=fields
        if re.fullmatch(r'(?:restore|incremental)_[0-9a-f]{16}',name) and altroot.startswith('/tmp/lllzorb-target-'):
            if members is None:
                members={os.path.realpath(n['path']) for n in tree_nodes([node_for(device)])}
            leaves={os.path.realpath(p) for p in pool_leaves(name)}
            if not leaves or not leaves<=members:continue
            require(health!='SUSPENDED',
                    f'Interrupted restore pool {name} is suspended; reconnect its disk or reboot before retrying')
            print(f'Cleaning up interrupted restore pool: {name}')
            run('zpool','export',name)


def protected_path(path):
    m=json.loads(run('findmnt','-J','-T',str(path)))['filesystems'][0]
    if m['fstype']=='zfs':
        return {disk_for(p) for p in pool_leaves(m['source'].split('/')[0])}
    if m['source'].startswith('/dev/'):
        # Walk inverse lsblk dependencies; covers storage used to hold the backup.
        inv=json.loads(run('lsblk','-s','-p','-J','-o','NAME,TYPE',m['source'].split('[')[0]))
        return {stable_device(x['name']) for x in tree_nodes(inv['blockdevices']) if x['type']=='disk'}
    return set()


def choose_destination(prompt, forbidden=(), allow_path=False, unattended=False):
    # Include unmounted standalone disks as well as existing backup disks.
    while True:
        candidates=[]
        for n in inventory()['blockdevices']:
            if n['type']!='disk' or is_zvol(n):
                continue
            if os.path.realpath(n['path']) in {os.path.realpath(p) for p in forbidden}:
                continue
            if any(x.get('device_id_error') for x in tree_nodes([n])):
                # Unidentified disks still count toward unattended ambiguity.
                if unattended and not n.get('ro') and not any(any(x.get('mountpoints') or []) for x in tree_nodes([n])):
                    candidates.append((True,n))
                continue
            try:
                target_idle(n['path'],forbidden)
            except (Error,OSError):
                if allow_path and any(x.get('fstype')=='zfs_member' and
                        (x.get('label') or '').startswith(('linux_os_backup_','baremetal_store_'))
                        for x in tree_nodes([n])):
                    candidates.append((True,n))
                continue
            empty=not n.get('children') and not signatures(n['path'])
            candidates.append((not empty,n))
        if candidates:
            break
        require(not unattended,'Unattended backup: no available destination; interactive selection would be required')
        print('No available destination. Attach a disk or unmount an eligible disk.')
        while True:
            answer=input('Press Enter to refresh, or q to quit: ').strip().lower()
            if answer=='q':
                raise Cancelled('Destination selection cancelled.')
            if not answer:
                break
            print('Press Enter to refresh, or type q to quit.')
    candidates.sort(key=lambda pair:(pair[0],pair[1]['path']))
    backups=[n for _,n in candidates if any(x.get('fstype')=='zfs_member' and
             (x.get('label') or '').startswith(('linux_os_backup_','baremetal_store_'))
             for x in tree_nodes([n]))] if allow_path else []
    default=backups[0]['path'] if len(backups)==1 else (candidates[0][1]['path'] if candidates and not candidates[0][0] else None)
    print('\nAvailable backup targets:' if allow_path else '\nAvailable restore destinations:')
    choices=[]
    for nonempty,n in candidates:
        status='contains data' if nonempty else 'empty'
        if allow_path:
            status='Existing backup disk' if n in backups else 'Other disk; '+status
        if any(x.get('device_id_error') for x in tree_nodes([n])):
            status+='; persistent ID unavailable (cannot use)'
        if n['path']==default:
            status+=' (default)'
        choices.append((n,status))
    print_disk_choices(choices)
    if allow_path and len(candidates)==1:
        disk=candidates[0][1]
        require(not any(x.get('device_id_error') for x in tree_nodes([disk])),
                'Destination has no persistent device ID; cannot use this disk')
        if any(x.get('fstype')=='zfs_member' and
               (x.get('label') or '').startswith(('linux_os_backup_','baremetal_store_'))
               for x in tree_nodes([disk])):
            print(f'Automatically selected existing backup disk: {disk["path"]}')
            return disk['path']
    require(not unattended,'Unattended backup: destination selection would require a prompt; an existing backup disk must be the only eligible target, or specify --destination')
    default_number=next((i for i,(_,n) in enumerate(candidates,1) if n['path']==default),None)
    answer=input(f'{prompt}'+(' (disk or number)' if allow_path else ' (disk or number)')+
                 (f' [{default_number}]' if default_number else '')+': ').strip()
    if not answer and default:
        return default
    if answer.isdigit() and 1<=int(answer)<=len(candidates):
        return candidates[int(answer)-1][1]['path']
    require(bool(answer), 'No destination selected')
    return answer


def destruction_target(device,node=None):
