def print_existing_layout(device,node):
    """Show the same lsblk inventory used to check the selected target."""
    def cell(value):
        if value is None or value=='':return '-'
        return ''.join(c if c.isprintable() else '?' for c in str(value))
    rows=[['DEVICE','SIZE','START','TYPE','FILESYSTEM','LABEL','PARTITION NAME','PARTITION TYPE']]
    def append(current,depth=0):
