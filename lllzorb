def create_layout(device, layout, count):
    device=stable_device(device)
    geometry=node_for(device)
    sector=int(geometry['log-sec']);size=int(geometry['size'])
    # Clear conflicting old signatures before creating the complete new GPT.
    run('wipefs','--all','--force',device)
    command=['sgdisk','--clear',f'--resize-table={count}','--set-alignment=1']
    for p in layout:
        n=p['number']
        command.extend([f'--new={n}:{p["start_lba"]}:{p["end_lba"]}',
            f'--typecode={n}:{p["type_guid"]}',f'--change-name={n}:{p["name"]}',
            f'--partition-guid={n}:{p["partuuid"]}',f'--attributes={n}:=:0x{p["attributes"]:016x}'])
    run(*command,device)
    # Read both headers/tables and check CRCs and exact planned geometry before
    # any caller can format an ESP, write boot metadata, or create a pool.
    actual=read_gpt(device,sector,size)
    require(actual['entry_count']==count,'Written GPT table size differs from plan')
    observed={p['number']:p for p in actual['partitions']}
    require(set(observed)=={p['number'] for p in layout},'Written GPT partition numbers differ from plan')
    for p in layout:
        for key in ('start_lba','end_lba','type_guid','partuuid','name','attributes'):
            expected=p[key]
            value=observed[p['number']][key]
            if key in ('type_guid','partuuid'):
                expected=expected.lower();value=value.lower()
            require(value==expected,f'Written GPT p{p["number"]} {key} differs from plan')
    run('partprobe',device); run('udevadm','settle')


@contextlib.contextmanager
def mounted(device, options='ro'):
    with recovery_directory('lllzorb-esp-') as temp:
        run('mount','-t','vfat','-o',options,device,temp)
        try:
            yield Path(temp)
        finally:
            run('umount',temp)


def duration(seconds):
    seconds=max(0,int(seconds))
    return f'{seconds//3600:02d}:{seconds//60%60:02d}:{seconds%60:02d}'


def diag_stamp():
    elapsed=0 if DIAGNOSTIC_STARTED is None else time.monotonic()-DIAGNOSTIC_STARTED
    wall=dt.datetime.now().astimezone().strftime('%Y-%m-%d %H:%M:%S %z')
    return f'[{wall} +{duration(elapsed)}]'


def diagnostic_event(message):
    if not DIAGNOSTIC:return
    line=f'{diag_stamp()} {message}\n'
    with DIAGNOSTIC_LOCK:
        try:print(line,end='',file=sys.stderr,flush=True)
        except (OSError,ValueError):pass
        if DIAGNOSTIC_LOG is not None:
            try:
                DIAGNOSTIC_LOG.write(line);DIAGNOSTIC_LOG.flush()
            except (OSError,ValueError):
                pass  # A diagnostic write failure must not interrupt cleanup.


def diagnostic_process(pid):
    try:
        root=Path(f'/proc/{pid}')
        status=dict(line.split(':',1) for line in (root/'status').read_text().splitlines())
        state=status.get('State','unknown').strip()
        wait=(root/'wchan').read_text().strip()
        return f'pid={pid} state={state} wchan={wait} io={proc_io(pid)}'
    except (OSError,ValueError):
        return f'pid={pid} exited or unavailable'


@contextlib.contextmanager
def diagnostic_command(args):
    if not DIAGNOSTIC:
        yield;return
    label=shlex.join(args)[:2048];started=time.monotonic();stop=threading.Event()
    diagnostic_event('command start: '+label)
    def monitor():
        while not stop.wait(DIAGNOSTIC_INTERVAL):
            diagnostic_event(f'command still running ({duration(time.monotonic()-started)}): '+label)
            try:
                children=Path(f'/proc/self/task/{os.getpid()}/children').read_text().split()
                for pid in children:diagnostic_event('command child: '+diagnostic_process(int(pid)))
            except (OSError,ValueError):pass
    worker=threading.Thread(target=monitor,name='command-diagnostics',daemon=True)
    worker.start()
    try:
        yield
    except BaseException as exc:
        diagnostic_event(f'command raised {type(exc).__name__}: {exc}')
        raise
    finally:
        stop.set();worker.join(timeout=1)
        diagnostic_event(f'command finished after {duration(time.monotonic()-started)}: '+label)


@contextlib.contextmanager
def diagnostic_session():
    global DIAGNOSTIC_LOG
    if not DIAGNOSTIC:
        yield;return
    stamp=dt.datetime.now().strftime('%Y%m%d-%H%M%S')
    path=Path.cwd()/f'lllzorb-diagnostic-{stamp}-{os.getpid()}.log'
    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    with os.fdopen(fd,'w',encoding='utf-8',errors='backslashreplace') as log:
        DIAGNOSTIC_LOG=log
        try:
            diagnostic_event(f'Diagnostic log: {path}')
            diagnostic_event(f'kernel={os.uname().release}; worker pid={os.getpid()}')
            try:diagnostic_event('loaded ZFS module: '+Path('/sys/module/zfs/version').read_text().strip())
            except OSError:pass
            yield
        except BaseException as exc:
            diagnostic_event(f'operation failed: {type(exc).__name__}: {exc}')
            raise
        finally:
            diagnostic_event('diagnostic session ended')
            DIAGNOSTIC_LOG=None


def start_restore_timeline():
    global DIAGNOSTIC_STARTED
    DIAGNOSTIC_STARTED=time.monotonic()
    print(f'{diag_stamp()} Restore started',flush=True)


def proc_io(pid):
    """Return Linux process read/write byte counters, or None if unavailable."""
    try:
        values={}
        for line in Path(f'/proc/{pid}/io').read_text().splitlines():
            key,value=line.split(':',1)
            if key in ('read_bytes','write_bytes'):
                values[key]=int(value.strip())
        return values.get('read_bytes',0),values.get('write_bytes',0)
    except (OSError,ValueError):
        return None


@contextlib.contextmanager
def timed_phase(label):
    """Report elapsed time for restore phases without byte progress."""
    started=time.monotonic()
    print(f'{diag_stamp()} {label}…',flush=True)
    try:
        yield
    except BaseException:
        print(f'{diag_stamp()} {label}: failed after {duration(time.monotonic()-started)}',flush=True)
        raise
    else:
        print(f'{diag_stamp()} {label}: {duration(time.monotonic()-started)}',flush=True)


@contextlib.contextmanager
def transfer_progress(label,counter,total=None):
    """Observe an existing descriptor; never copy or buffer the replication stream."""
    started=time.monotonic(); previous_time=started; previous_bytes=0
    stop=threading.Event(); terminal=sys.stderr.isatty() and not DIAGNOSTIC
    def report(state=None):
        nonlocal previous_time,previous_bytes
        now=time.monotonic(); count=counter(); elapsed=max(now-started,1e-9)
        rate=max(0,count-previous_bytes)/max(now-previous_time,1e-9)
        average=count/elapsed
        eta=duration(max(0,total-count)/average) if total and average>0 and count<total else '--:--:--'
        amount=f'{count/GIB:.3f} GiB'
        if state:
            amount+=' transferred'
            if total:
                amount+=f' | estimated {total/GIB:.3f} GiB'
        elif total:
            amount+=f' / ~{total/GIB:.3f} GiB ({min(100,count/total*100):.1f}%)'
        suffix=f' | {state}' if state else ''
        throughput=(f'avg {average/MIB:.1f} MiB/s' if state else
                    f'{rate/MIB:.1f} MiB/s (avg {average/MIB:.1f})')
        line=(f'{label}: {amount} | {throughput} | elapsed {duration(elapsed)} | ETA {eta}{suffix}')
        line=diag_stamp()+' '+line
        print(('\r' if terminal else '')+line+('\x1b[K' if terminal else ''),
              end='\n' if state or not terminal else '',file=sys.stderr,flush=True)
        previous_time=now; previous_bytes=count
    def monitor():
        while not stop.wait(1):
            if terminal or DIAGNOSTIC:report()
    if terminal or DIAGNOSTIC:report()
    worker=threading.Thread(target=monitor,name='transfer-progress',daemon=True)
    worker.start(); state='failed/interrupted'
    try:
        yield
        state='complete'
    finally:
        stop.set(); worker.join()
        report(state)


def stream_file(args,path,total=None):
    with open(path,'xb') as f:
        with transfer_progress('Send '+Path(path).name,lambda:os.fstat(f.fileno()).st_size,total):
            result=locked_run(args,stdout=f)
            require(result.returncode==0, f'Stream failed: {args[0]}')
            f.flush(); os.fsync(f.fileno())


def receive_file(path,pool):
    with open(path,'rb') as f:
        with transfer_progress('Receive '+pool,lambda:os.lseek(f.fileno(),0,os.SEEK_CUR),os.fstat(f.fileno()).st_size):
            run('zfs','receive','-u','-F',pool,stdin=f)


@contextlib.contextmanager
def esp_backup_mount(device):
    identity=node_for(device)['maj:min']
    columns='TARGET,SOURCE,FSTYPE,MAJ:MIN,FSROOT'
    mounts=list(tree_nodes(json.loads(run('findmnt','-J','-o',columns))['filesystems']))
    matches=[m for m in mounts if m.get('maj:min')==identity]
    if not matches:
        with mounted(device) as path:
            yield path
        return
    roots=[m for m in matches if m.get('fstype')=='vfat' and m.get('fsroot')=='/']
    require(roots,f'{device}: no complete FAT filesystem mount available for backup')
    path=Path(roots[0]['target'])
    # Check the filesystem actually visible here, including any overmounts.
    visible=json.loads(run('findmnt','-J','-R','-T',path,'-o',columns))['filesystems']
    require(len(visible)==1 and visible[0].get('maj:min')==identity
            and visible[0].get('fstype')=='vfat' and visible[0].get('fsroot')=='/'
            and visible[0].get('target')==str(path) and not visible[0].get('children'),
            f'{device}: EFI mount changed or contains nested mounts: {path}')
    print(f'{diag_stamp()} Archiving EFI partition {device} from existing mount {path}')
    yield path  # This mount belongs to the running OS; leave it untouched.


def pack_esp(device,path):
    with esp_backup_mount(device) as mount:
        with open(path,'xb') as output:
            tar=locked_popen(['tar','--acls','--xattrs','--numeric-owner','-C',str(mount),'-cf','-','.'],stdout=subprocess.PIPE)
            compressor=locked_popen(['zstd','-T0'],stdin=tar.stdout,stdout=output)
            tar.stdout.close()
            cr=compressor.wait(); tr=tar.wait()
            require(cr==0 and tr==0,'ESP archive failed')
            output.flush(); os.fsync(output.fileno())


def choose_unattended_backup_destination(source):
    # Use exactly the interactive candidate rules; do not discard blank/data
    # disks merely because one existing backup disk is present.
    return choose_destination('Backup destination',[source],True,unattended=True)


@contextlib.contextmanager
def backup_destination(destination, source, needed,unattended=False,require_existing=False):
    path=Path(destination).expanduser()
    require(path.exists() and stat.S_ISBLK(path.stat().st_mode),
            'Backup destination must be a whole disk device; directory inputs are not supported')
    with backup_writer_lock(destination):
        with backup_destination_locked(destination,source,needed,unattended,require_existing) as repository:
            yield repository


@contextlib.contextmanager
def backup_destination_locked(destination,source,needed,unattended=False,require_existing=False):
    p=Path(destination).expanduser()
    if p.exists() and stat.S_ISBLK(p.stat().st_mode):
        p=Path(stable_device(p))
        members=[x for x in tree_nodes([node_for(str(p))]) if x.get('fstype')=='zfs_member']
        if members and any(not x.get('label') or x['label'].startswith(('linux_os_backup_','baremetal_store_'))
                           for x in members):
            try:
                with existing_store(str(p),source) as repository:
                    yield repository
                return
            except ReinitializeDestroyedPool:
                # Only a positively identified destroyed pool can reach the
                # initialization confirmation. Normal import errors never do.
                pass
        require(not require_existing,'--incremental requires an existing usable backup disk; no matching base is available')
        require(not unattended,
                'Unattended backup will not initialize or erase a disk; select an existing usable backup disk')
        with device_lock(str(p)):
            n=target_idle(str(p),[source]); sector=int(n['log-sec']); size=int(n['size'])
            require(size>needed+67*MIB,'Backup destination disk has insufficient estimated capacity')
            print_existing_layout(str(p),n)
            print(f'Backup destination: {p}, {size/GIB:.1f} GiB. A new ZFS backup storage pool will be created.')
            confirm(str(p)); fresh=target_idle(str(p),[source])
            require(all(fresh.get(k)==n.get(k) for k in ('size','log-sec','phy-sec','serial','wwn','maj:min')),
                    'Backup target identity changed during confirmation')
            pool='linux_os_backup_'+uuid.uuid4().hex[:10]
            private_storage_namespace()
            with recovery_directory('lllzorb-store-') as tmp:
                partition=dict(number=1,start_lba=MIB//sector,end_lba=(size-MIB)//sector-1,
                               type_guid=ZFS,name='Bare metal backups',partuuid=str(uuid.uuid4()),attributes=0)
                create_layout(str(p),[partition],128)
                run('zpool','create','-f','-o','cachefile=none','-O',f'mountpoint={tmp}',pool,partition_device(str(p),1))
                try:
                    yield Path(tmp)
                finally:
                    run('zpool','export',pool)
            print(f'Backup storage pool: {pool}. Import later with zpool import -N {pool}, then set a mountpoint and mount it (see README).')
    else:
        raise Error('Backup destination must be a whole disk device; directory inputs are not supported')


def snapshot_source_pools(pools,snapshot):
    # Snapshot transactions cannot span pools. Finish each recursive snapshot
    # before any replication starts; the pools have slightly different times.
    completed=[]
    try:
        for pool in pools:
            name=pool['name']+'@'+snapshot
            run('zfs','snapshot','-r',name)
            completed.append(name)
    except BaseException:
        if completed:
            print('Source snapshots already created and retained: '+', '.join(completed),file=sys.stderr)
        raise


def source_snapshot_choices(pools):
    choices=None
    for pool in pools:
        names=[]
        for line in run('zfs','list','-H','-t','snapshot','-o','name','-s','creation','-r',pool).splitlines():
            if line.startswith(pool+'@'):
                names.append(line.split('@',1)[1])
        current=set(names)
        choices=current if choices is None else choices & current
    return sorted(choices or (), key=snapshot_stamp)


def choose_source_snapshot(pools,args):
    requested=getattr(args,'snapshot_name',None)
    if requested is None and getattr(args,'snapshot_index',None) is None:
        return 'system-backup-'+dt.datetime.now(dt.timezone.utc).strftime('%Y%m%d-%H%M%S'),False
    choices=source_snapshot_choices(pools)
    if requested:
        require(requested in choices,'Requested source snapshot is not present on every source pool')
        return requested,True
    index=getattr(args,'snapshot_index',None)
    if index is not None:
        require(choices and 1<=index<=len(choices),'Source snapshot index is outside the available snapshots')
        return choices[-index],True
    raise Error('Source snapshot selection is ambiguous')


@contextlib.contextmanager
def backup_storage(args,manifest,needed):
    if getattr(args,'remote',None):
        with remote_storage(args,write=True,source=manifest) as pair:
            yield pair
    else:
        unattended=getattr(args,'unattended',False)
        source=manifest['disk']['device']
        dest=args.destination or (choose_unattended_backup_destination(source) if unattended else
                                  choose_destination('Backup destination',[source],True))
        with backup_destination(dest,source,needed,
                                **({'require_existing':True} if getattr(args,'incremental',False) else {}),
                                **({'unattended':True} if unattended else {})) as repository,repository_lock(repository):
            yield repository,None


def backup(args):
    global LOG
    forced_incremental=bool(getattr(args,'incremental',False))
    require(not (forced_incremental and getattr(args,'full',False)),'--full and --incremental cannot be combined')
    commands('lsblk blkid findmnt sgdisk zpool zfs zdb zstream wipefs mount umount tar zstd partprobe udevadm')
    m=discover()
    compression=getattr(args,'compression',None)
    check_compression_streams(compression,m['pools'])
    m['hostname']=valid_hostname(getattr(args,'host',None) or socket.gethostname())
    validate_pool_layout(m)
    m['snapshot'],existing_source_snapshot=choose_source_snapshot(m['pools'],args)
    m['created_utc']=dt.datetime.now(dt.timezone.utc).isoformat()
    m['boot']={'fstab':Path('/etc/fstab').read_text(), 'architecture':os.uname().machine,
               'signed_efi':all(Path(p).is_file() for p in ('/usr/lib/shim/shimx64.efi.signed',
                   '/usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed'))}
    m['boot']['manager']='proxmox-grub' if Path('/usr/sbin/proxmox-boot-tool').is_file() else 'ubuntu-grub'
    if any(p['kind']=='bios_boot' for p in m['disk']['partitions']):
        require(Path('/usr/lib/grub/i386-pc/modinfo.sh').is_file(), 'BIOS restore requires installed GRUB i386-pc modules')
    validate_fstab(m['boot']['fstab'])
    require(m['boot']['architecture']=='x86_64' and m['boot']['signed_efi'],
            'Backup requires x86_64 Ubuntu with shim-signed and grub-efi-amd64-signed installed')
    # Run complete structural validation before any snapshots or destination changes.
    for pool in m['pools']:
        pool['estimated_send_bytes']=0; pool['stream_bytes']=1
    validate(m)
    # Capacity estimate before initializing a backup storage disk. Snapshot stream estimates follow.
    needed=sum(max(p['used_bytes'],p['logicalused_bytes']) for p in m['pools'])
    if not getattr(args,'stack',False):
        needed=sum(current_dataset_bytes(p) for p in m['pools'])
    needed+=sum(p['size_bytes'] for p in m['disk']['partitions'] if p['kind'] in ('esp','bios_boot'))+GIB
    if existing_source_snapshot and not getattr(args,'stack',False):
        source_choices=source_snapshot_choices(m['pools'])
        selected_index=source_choices.index(m['snapshot']) if m['snapshot'] in source_choices else -1
        newer_choices=source_choices[selected_index+1:] if selected_index >= 0 else []
        if newer_choices:
            message=('Intermediate source snapshots will not be included in this backup: '
                     +', '.join(newer_choices)+'.')
            require(not getattr(args,'unattended',False),message+' Use --stack or select the latest snapshot.')
            require(input(message+' Type BACKUP SNAPSHOT to continue: ').strip()=='BACKUP SNAPSHOT',
                    'Backup cancelled')
    with backup_storage(args,m,needed) as (repository,remote):
        remote_kw={'remote':remote} if remote else {}
        storage_run=remote.run if remote else run
        parent=host_repository(repository,m['hostname'])
        with repository_lock(parent,name='.host.lock') if remote is None else contextlib.nullcontext():
            location=f'{remote.host}:{remote.dataset}/hosts/{m["hostname"]}' if remote else str(parent)
            print(f'{diag_stamp()} Backup host: {m["hostname"]}; repository: {location}')
            storage_dataset,storage_guid=(remote.dataset,remote.guid) if remote else zfs_repository(repository)
            if compression:
                check_compression_pool(compression,storage_dataset.split('/')[0],storage_run)
                print(f'{diag_stamp()} Backup target dataset compression: '+compression)
            previous=incremental_parent(parent,m,None,args.full,native_only=True,
                                        **({'required':True} if forced_incremental else {}),**remote_kw)
            require(not forced_incremental or (previous and all(p.get('replication_type')!='full' for p in m['pools'])),
                    '--incremental requires a usable matching base for every source pool; full backup fallback is disabled')
            m['version']=5; m['storage']='native'; m['storage_pool_guid']=storage_guid
            if previous:
                previous_path,previous_manifest=previous
                m.update(backup_type='incremental',parent=previous_path.name,
                         parent_manifest_sha256=digest(previous_path/'manifest.json'),base_snapshot=previous_manifest['snapshot'])
            else:
                m['backup_type']='full'
                print(f'{diag_stamp()} Starting a new native full generation.')
            m['snapshot_history']=select_snapshot_history(args)
            print(f'{diag_stamp()} Snapshot history: '+('current backup snapshot only' if m['snapshot_history']=='current' else 'include source snapshot history'))
            if previous:
                m['native_root']=previous_manifest['native_root']
                require(previous_manifest['storage_pool_guid']==storage_guid, 'Native storage identity changed')
                for pool in m['pools']:
                    pool['native_dataset']=next(p['native_dataset'] for p in previous_manifest['pools'] if p['name']==pool['name'])
                    assert_native_tip(pool,previous_manifest['snapshot'],**remote_kw)
                    if pool.get('replication_type')=='full':
                        pool['native_dataset']=m['native_root']+'/'+pool['name']+'-'+m['snapshot']
            if not previous:
                relative='.' if remote else str(Path(repository).resolve().relative_to(Path(json.loads(run('findmnt','-J','-T',repository))['filesystems'][0]['target']).resolve()))
                key=hashlib.sha256(relative.encode()).hexdigest()[:16]
                m['native_root']=f'{storage_dataset}/linux_os_backup/{key}/{m["hostname"]}/{m["snapshot"]}'
                for pool in m['pools']:
                    pool['native_dataset']=m['native_root']+'/'+pool['name']
            # Preflight unsupported encryption relationships before snapshot creation.
            for pool in m['pools']:
                prior=next((p for p in previous[1]['pools'] if p['name']==pool['name']),None) if previous else None
                backup_streams(pool,m,prior)
            out=parent/('backup-'+snapshot_stamp(m['snapshot']))
            out.mkdir(mode=0o700)
            for directory in ('disk','efi','zfs'):
                (out/directory).mkdir()
            LOG=open(out/'backup.log','w')
            try:
                print(f'{diag_stamp()} Backing up {m["disk"]["device"]} to {out}')
                # All pool snapshots are established before the first stream starts.
                if not existing_source_snapshot:
                    snapshot_source_pools(m['pools'],m['snapshot'])
                streams={}
                for pool in m['pools']:
                    name=pool['name']; pool['datasets']=props('zfs',name,True)
                    prior=next((p for p in previous[1]['pools'] if p['name']==name),None) if previous else None
                    streams[name]=backup_streams(pool,m,prior)
                    estimates=[]
                    for stream in streams[name]:
                        estimate=run('zfs','send','-n','-P',*stream['flags'],stream['source']+'@'+stream.get('snapshot',m['snapshot']),combined=True)
                        estimates.append(estimate)
                        match=re.search(r'^size\s+(\d+)\s*$',estimate,re.M)
                        require(match is not None,'Could not parse ZFS replication estimate')
                        stream['estimate']=int(match[1])
                    (out/f'zfs/{name}-send-estimate.txt').write_text('\n'.join(estimates))
                    pool['estimated_send_bytes']=sum(s['estimate'] for s in streams[name])
                    if m['snapshot_history']=='current':
                        pool['datasets']={n:ps for n,ps in pool['datasets'].items() if '@' not in n or n.endswith('@'+m['snapshot'])}
                available=remote.available() if remote else shutil.disk_usage(out).free
                require(available>sum(p['estimated_send_bytes'] for p in m['pools'])
                        +sum(p['size_bytes'] for p in m['disk']['partitions'] if p['kind'] in ('esp','bios_boot'))+GIB,
                        'Insufficient backup space after snapshot estimate')
                if remote:
                    require(shutil.disk_usage(out).free>sum(p['size_bytes'] for p in m['disk']['partitions'] if p['kind'] in ('esp','bios_boot'))+64*MIB,
                            'Insufficient local temporary space for EFI archives and metadata')
                raw={'disk/lsblk.json':['lsblk','-b','-O','-J'], 'disk/blkid.txt':['blkid'],
                     'disk/findmnt.json':['findmnt','-J'], 'disk/sgdisk.txt':['sgdisk','--print',m['disk']['device']],
                     'zfs/zpool-status.txt':['zpool','status','-LP'], 'zfs/zpool-properties.txt':['zpool','get','all'],
                     'zfs/zfs-list.txt':['zfs','list','-r','-t','filesystem,volume,snapshot'],
                     'zfs/zfs-properties.txt':['zfs','get','-r','all']}
                for path,argv in raw.items():
                    (out/path).write_text(run(*argv),encoding='utf-8',errors='surrogateescape')
                efi=run('efibootmgr','-v',check=False) if shutil.which('efibootmgr') else 'efibootmgr unavailable\n'
                (out/'efi/efibootmgr.txt').write_text(efi,encoding='utf-8',errors='surrogateescape')
                run('sgdisk',f'--backup={out/"disk/gpt.bin"}',m['disk']['device'])
                with open(m['disk']['device'],'rb') as disk:
                    (out/'disk/first-megabyte.bin').write_bytes(disk.read(MIB))
                for p in m['disk']['partitions']:
                    if p['kind']=='bios_boot':
                        with open(p['source_device'],'rb') as src, open(out/p['image'],'xb') as dst:
                            shutil.copyfileobj(src,dst,4*MIB)
                        require((out/p['image']).stat().st_size==p['size_bytes'], 'Short BIOS metadata read')
                    elif p['kind']=='esp':
                        pack_esp(p['source_device'],out/p['archive'])
                if not previous:
                    ensure_native_parent(m['native_root'],**remote_kw)
                storage_run('zfs','set','org.linux-os-backup:pending='+m['snapshot'],m['native_root'])
                totals=TransferTotals()
                totals.compression=compression or 'no override'
                for pool in m['pools']:
                    print(f'{diag_stamp()} Sending {pool["name"]}@{m["snapshot"]} ({pool.get("replication_type",m["backup_type"])} replication) | '
                          +dataset_size_text(saved_snapshot_sizes([pool],m['snapshot'])),flush=True)
                    pool['stream_bytes']=0
                    before=(transfer_snapshot_inventory(pool['native_dataset'],storage_run)
                            if pool.get('replication_type',m['backup_type'])!='full' else {})
                    progress={'bytes':0}
                    def transferred(count):
                        progress['bytes']+=count
                    with transfer_progress('Replicate '+pool['name'],lambda:progress['bytes'],pool['estimated_send_bytes']):
                        for stream in streams[pool['name']]:
                            receiver=native_receive(stream['destination'],volume=stream.get('volume',False),
                                                    compression=compression)
                            if remote:
                                remote.check_lock()
                                receiver=remote.command(*receiver)
                            pool['stream_bytes']+=pipe_transfer(
                                ['zfs','send',*stream['flags'],stream['source']+'@'+stream.get('snapshot',m['snapshot'])],
                                receiver,stream['estimate'],'Replicate '+stream['source'],on_bytes=transferred)
                    totals.record(pool['stream_bytes'],pool['native_dataset'],before,storage_run,raw=pool['encrypted'])
                    held=[pool['native_dataset']+n[len(pool['name']):]+'@'+m['snapshot']
                          for n in pool['datasets'] if '@' not in n]
                    for start in range(0,len(held),128):
                        storage_run('zfs','hold','linux_os_backup',*held[start:start+128])
                    pool.pop('stream',None)
                verify_native(out,m,**remote_kw)

                validate(m)
                (out/'manifest.json').write_text(json.dumps(m,indent=2)+'\n')
                LOG.close(); LOG=None
                lines=[f'{digest(p)}  {p.relative_to(out)}\n' for p in sorted(out.rglob('*')) if p.is_file()]
                temporary=out/'SHA256SUMS.pending'
                with open(temporary,'x') as sums:
                    sums.write(''.join(lines)); sums.flush(); os.fsync(sums.fileno())
                storage_run('zpool','sync',storage_dataset.split('/')[0])
                os.replace(temporary,out/'SHA256SUMS')
                directory_fd=os.open(out,os.O_RDONLY|os.O_DIRECTORY)
                try: os.fsync(directory_fd)
                finally: os.close(directory_fd)
                if remote:
                    remote.publish(out)
                storage_run('zfs','inherit','org.linux-os-backup:pending',m['native_root'])
                os.sync()
                report_destination_compression('Backup',[(p['name'],p['native_dataset']) for p in m['pools']],
                                               storage_run,compression=totals.compression)
                print(f'{diag_stamp()} Backup complete: {out.name}. Source snapshot retained: {m["snapshot"]}')
                return totals
            finally:
                if LOG:
                    LOG.close(); LOG=None


def beneath(root,relative):
    path=root/relative.lstrip('/')
    require(path.resolve().is_relative_to(root.resolve()),f'Restored path escapes installation: {relative}')
    return path


@contextlib.contextmanager
def recovery_directory(prefix='lllzorb-restore-'):
    path=Path(tempfile.mkdtemp(prefix=prefix))
    try:
        yield path
    finally:
        try:
            path.rmdir()
        except OSError:
            print(f'Recovery directory retained (check for remaining mounts): {path}',file=sys.stderr)


def validate_fstab(text):
    # Network mounts describe external storage, not partitions to reconstruct.
    # Preserve their configuration; their contents are not part of this backup.
    for line in text.splitlines():
        if line.strip() and not line.lstrip().startswith('#'):
            fields=line.split()
            require(len(fields)>=4 and fields[2] in ('zfs','vfat','fat','fat32','swap','tmpfs','proc','sysfs','devpts','cifs','nfs','nfs4'),
                    'Unsupported persistent fstab entry')


def rebuild_initramfs(root):
    # Inspect the installation, not the rescue host or its running kernel.
    # Ubuntu Dracut installations can also retain initramfs-tools utilities.
    def executable(name):
        for directory in ('/usr/bin/', '/usr/sbin/', '/bin/', '/sbin/'):
            path=beneath(root,directory+name)
            if path.is_file() and os.access(path,os.X_OK):
                return directory+name
        return None

    dracut=executable('dracut')
    update=executable('update-initramfs')
    require(dracut or update,'Restored installation has neither dracut nor update-initramfs')
    inspector=executable('lsinitrd' if dracut else 'lsinitramfs')
    require(inspector,'Restored installation lacks an initramfs inspection utility')
    kernels=sorted(p.name[len('vmlinuz-'):] for p in beneath(root,'/boot').glob('vmlinuz-*')
                   if beneath(root,'/boot/'+p.name).is_file())
    require(kernels,'No installed kernels found under /boot')
    # Check every kernel before replacing any image.
    for kernel in kernels:
        require(any(beneath(root,directory+kernel).is_dir()
                    for directory in ('/usr/lib/modules/','/lib/modules/')),
                'Missing kernel modules for '+kernel)
        beneath(root,'/boot/initrd.img-'+kernel)
    for kernel in kernels:
        image='/boot/initrd.img-'+kernel
        target=beneath(root,image)
        if dracut:
            # A chroot still sees the rescue host's /proc and device inventory.
            run('chroot',root,dracut,'--force','--no-hostonly',
                '--no-hostonly-cmdline',image,kernel)
        else:
            run('chroot',root,update,'-u' if target.is_file() else '-c','-k',kernel)
        require(target.is_file() and target.stat().st_size>0,
                'Missing or empty rebuilt initramfs: '+image)
        run('chroot',root,inspector,image)
    return 'dracut' if dracut else 'initramfs-tools'


def restored_executable(root,name):
    for directory in ('/usr/bin/','/usr/sbin/','/bin/','/sbin/'):
        path=beneath(root,directory+name)
        if path.is_file() and os.access(path,os.X_OK):
            return directory+name
    return None


def rebuild_restored_dracut(root):
    """Build cache-free images without invoking kernel/GRUB/EFI post-update hooks."""
    dracut=restored_executable(root,'dracut')
    if not dracut:
        print(f'{diag_stamp()} Installation does not use Dracut; preserving its saved initramfs.')
        return []
    inspector=restored_executable(root,'lsinitrd')
    require(inspector,'Dracut restore requires lsinitrd in the restored installation')
    kernels=sorted(p.name[8:] for p in beneath(root,'/boot').glob('vmlinuz-*')
                   if beneath(root,'/boot/'+p.name).is_file())
    require(kernels,'Dracut restore found no installed kernels')
    for kernel in kernels:
        require(any(beneath(root,d+kernel).is_dir() for d in ('/usr/lib/modules/','/lib/modules/')),
                'Missing restored kernel modules: '+kernel)
        beneath(root,'/boot/initrd.img-'+kernel)
    # Recreated vdevs have new GUIDs even though the pool GUID is preserved.
    # Without a cache, ZFS's Dracut units scan device labels at boot instead.
    cache=beneath(root,'/etc/zfs/zpool.cache')
    old_cache=cache.read_bytes() if cache.is_file() else None
    if cache.exists():cache.unlink()
    pending=[]
    try:
        for kernel in kernels:
            relative='/boot/.restore-initrd-'+uuid.uuid4().hex
            image=beneath(root,relative);pending.append((image,beneath(root,'/boot/initrd.img-'+kernel)))
            run('chroot',root,dracut,'--force','--no-hostonly','--no-hostonly-cmdline',
                '--no-uefi','--add','zfs','--add-drivers','zfs',
                '--tmpdir','/run',relative,kernel)
            require(image.is_file() and image.stat().st_size>0,'Dracut produced an empty initramfs: '+kernel)
            listing=run('chroot',root,inspector,relative)
            require(re.search(r'(?:^|/)zfs\.ko(?:\.(?:zst|xz|gz))?(?:\s|$)',listing,re.M),
                    'Rebuilt initramfs lacks the ZFS kernel module: '+kernel)
            require(re.search(r'(?:^|/)(?:sbin|bin)/zpool(?:\s|$)',listing,re.M),
                    'Rebuilt initramfs lacks zpool: '+kernel)
            require('zfs-import-scan.service' in listing or 'mount-zfs.sh' in listing,
                    'Rebuilt initramfs lacks ZFS boot import support: '+kernel)
            require('etc/zfs/zpool.cache' not in listing,
                    'Rebuilt initramfs still contains a stale ZFS pool cache: '+kernel)
            require(not cache.exists(),'Dracut unexpectedly recreated a pool cache')
        # Validate all images before replacing any of the backed-up images.
        for image,target in pending:
            os.replace(image,target)
        os.sync()
    except BaseException:
        if old_cache is not None:cache.write_bytes(old_cache)
        raise
    finally:
        for image,_ in pending:
            if image.exists():image.unlink()
    print(f'{diag_stamp()} Rebuilt and checked {len(kernels)} Dracut initramfs image(s) for restored ZFS devices.')
    return kernels


def rewrite_boot_pool_guids(root,changes,esp=False):
    """Update saved text configuration; leave signed EFI executables intact."""
    if not changes:return
    replacements={}
    for old,new in changes.items():
        require(old.isdecimal() and new.isdecimal() and 0<int(old)<2**64 and 0<int(new)<2**64,
                'Invalid restored pool identity')
        replacements[old]=new
        replacements[f'{int(old):016x}']=f'{int(new):016x}'
        replacements[f'{int(old):016X}']=f'{int(new):016X}'
    pattern=re.compile(r'(?<![0-9a-fA-F])(?:'+'|'.join(map(re.escape,replacements))+r')(?![0-9a-fA-F])')
    if esp:
        paths=[p for p in root.rglob('*') if p.suffix.lower() in ('.cfg','.conf')]
    else:
        paths=[beneath(root,p) for p in ('/etc/default/grub','/etc/default/zfs',
               '/etc/kernel/cmdline','/etc/dracut.conf')]
        for directory in ('/boot/grub','/etc/default/grub.d','/etc/grub.d',
                          '/etc/dracut.conf.d','/etc/initramfs-tools/conf.d'):
            parent=beneath(root,directory)
            paths.extend(p for p in parent.rglob('*') if directory!='/boot/grub' or p.suffix=='.cfg')
    for path in paths:
        path=beneath(root,str(path.relative_to(root)))
        if not path.is_file():continue
        data=path.read_bytes()
        require(b'\0' not in data,'Unexpected binary boot configuration: '+str(path))
        text=data.decode('utf-8',errors='surrogateescape')
        updated=pattern.sub(lambda match:replacements[match[0]],text)
        if updated!=text:path.write_bytes(updated.encode('utf-8',errors='surrogateescape'))


def rebuild_restored_initramfs_tools(root):
    """Use mkinitramfs directly so bootloader and ESP update hooks cannot run."""
    builder=restored_executable(root,'mkinitramfs')
    inspector=restored_executable(root,'lsinitramfs')
    require(builder and inspector,'Changed pool identities require mkinitramfs and lsinitramfs, or Dracut')
    kernels=sorted(p.name[8:] for p in beneath(root,'/boot').glob('vmlinuz-*') if p.is_file())
    require(kernels,'No installed kernels for restored boot preparation')
    cache=beneath(root,'/etc/zfs/zpool.cache')
    if cache.exists():cache.unlink()
    pending=[]
    runtime=beneath(root,'/run');runtime.mkdir(exist_ok=True)
    config=Path(tempfile.mkdtemp(prefix='restore-initramfs-',dir=runtime))
    try:
        original=beneath(root,'/etc/initramfs-tools')
        if original.is_dir():shutil.copytree(original,config,dirs_exist_ok=True,symlinks=True)
        fragments=beneath(root,str(config.relative_to(root))+'/conf.d')
        fragments.mkdir(exist_ok=True)
        override=max((p.name for p in fragments.iterdir()),default='zz')+'-restore'
        (fragments/override).write_text('MODULES=most\n')
        for kernel in kernels:
            require(any(beneath(root,d+kernel).is_dir() for d in ('/usr/lib/modules/','/lib/modules/')),
                    'Missing restored kernel modules: '+kernel)
            relative='/boot/.restore-initrd-'+uuid.uuid4().hex
            image=beneath(root,relative);pending.append((image,beneath(root,'/boot/initrd.img-'+kernel)))
            run('chroot',root,builder,'-d','/'+str(config.relative_to(root)),'-o',relative,kernel)
            require(image.is_file() and image.stat().st_size>0,'Empty rebuilt initramfs: '+kernel)
            listing=run('chroot',root,inspector,relative)
            require(re.search(r'(?:^|/)zfs\.ko(?:\.(?:zst|xz|gz))?(?:\s|$)',listing,re.M)
                    and re.search(r'(?:^|/)(?:sbin|bin)/zpool(?:\s|$)',listing,re.M)
                    and 'scripts/zfs' in listing,'Rebuilt initramfs lacks ZFS boot support: '+kernel)
            require('etc/zfs/zpool.cache' not in listing and not cache.exists(),
                    'Rebuilt initramfs contains a stale ZFS pool cache: '+kernel)
        for image,target in pending:os.replace(image,target)
    finally:
        for image,_ in pending:
            if image.exists():image.unlink()
        shutil.rmtree(config)
    print(f'{diag_stamp()} Rebuilt and checked {len(kernels)} initramfs-tools image(s) for restored pool identities.')
    return kernels


def rebuild_restored_bios(root,esp,device,esp_device,boot):
    """Embed a fresh core image using only the selected target's device nodes."""
    builder=restored_executable(root,'grub-mkimage')
    setup=restored_executable(root,'grub-bios-setup')
    if not setup:
        candidate='/usr/lib/grub/i386-pc/grub-bios-setup'
        if os.access(beneath(root,candidate),os.X_OK):setup=candidate
    require(builder and setup,'Changed pool identities require GRUB BIOS image/setup tools')
    require(beneath(root,'/boot/grub/grub.cfg').is_file(),'Restored GRUB configuration is missing')
    prefix=boot['prefix']
    require(re.fullmatch(r'/[A-Za-z0-9_./@+-]+',prefix),'Unsupported GRUB dataset path')
    binds=[]
    with tempfile.TemporaryDirectory(prefix='.restore-bios-',dir=esp) as directory:
        stage=Path(directory)
        shutil.copyfile(beneath(root,'/usr/lib/grub/i386-pc/boot.img'),stage/'boot.img')
        (stage/'load.cfg').write_text(f'search --no-floppy --fs-uuid --set=root {int(boot["guid"]):016x}\n'
                                     f'set prefix=($root){prefix}\n')
        (stage/'device.map').write_text('(hd0) '+device+'\n')
        target=beneath(root,'/run/restore-bios');target.mkdir()
        try:
            # GRUB resolves partition parents through kernel device paths.
            for source,dest in [(str(stage),target)]+[(d,beneath(root,os.path.realpath(d))) for d in (device,esp_device)]:
                if dest!=target:
                    require(stat.S_ISBLK(os.stat(source).st_mode),'BIOS target is no longer a block device')
                    dest.parent.mkdir(parents=True,exist_ok=True);dest.touch()
                run('mount','--bind',source,dest);binds.append(dest)
                if dest!=target and dest!=beneath(root,source):
                    link=beneath(root,source);link.parent.mkdir(parents=True,exist_ok=True)
                    link.symlink_to(os.path.relpath(dest,link.parent))
            run('chroot',root,builder,'-O','i386-pc','-d','/usr/lib/grub/i386-pc',
                '-p',prefix,'-c','/run/restore-bios/load.cfg','-o','/run/restore-bios/core.img',
                'biosdisk','part_gpt','zfs','search','search_fs_uuid','normal','configfile')
            require((stage/'core.img').is_file() and (stage/'core.img').stat().st_size>512,
                    'GRUB produced an invalid BIOS core image')
            run('chroot',root,setup,'--skip-fs-probe','--directory=/run/restore-bios',
                '--device-map=/run/restore-bios/device.map','(hd0)')
        finally:
            for dest in reversed(binds):run('umount',dest)


def restored_fstab_replacements(device,layout):
    replacements={}
    for part in layout:
        target=partition_device(device,part['number'])
        replacements[part['source_device']]=target
        partuuid=run('lsblk','-dn','-o','PARTUUID',target).strip()
        require(partuuid,'Missing destination partition UUID: '+target)
        for prefix in ('PARTUUID=','/dev/disk/by-partuuid/'):
            replacements[prefix+part['partuuid']]=prefix+partuuid
        if part['kind'] in ('esp','swap'):
            old=part['fat_uuid'] if part['kind']=='esp' else part['swap_uuid']
            labels=dict(line.split('=',1) for line in run('blkid','-p','-o','export',target).splitlines() if '=' in line)
            new=labels.get('UUID')
            require(new,'Missing destination filesystem UUID: '+target)
            for prefix in ('UUID=','/dev/disk/by-uuid/'):
                replacements[prefix+old]=prefix+new
    return replacements


def rewrite_restored_fstab(root,replacements):
    if not replacements:return False
    path=beneath(root,'/etc/fstab')
    text=path.read_text();validate_fstab(text)
    identities={k.lower():v for k,v in replacements.items()
                if k.startswith(('UUID=','PARTUUID=','/dev/disk/by-uuid/','/dev/disk/by-partuuid/'))}
    def replace(match):
        source=match[2]
        return match[1]+replacements.get(source,identities.get(source.lower(),source))
    updated=re.sub(r'^(\s*)([^#\s]+)',replace,text,flags=re.M)
    if updated==text:return False
    path.write_text(updated)
    return True


def refresh_restored_dracut_worker(payload):
    global DIAGNOSTIC_STARTED
    DIAGNOSTIC_STARTED=payload.get('timeline_started')
    # Called in a private mount namespace. Never expose host disks, /dev/zfs,
    # runtime sockets, or mounted ESPs to the image generator.
    mounts=payload['mounts']
    require(mounts and mounts[0]['target']=='/','Restore boot root mount missing')
    with recovery_directory() as root:
        mounted_paths=[]
        try:
            with timed_phase('Mount restored OS for boot preparation'):
                for item in mounts:
                    target=beneath(root,item['target']);target.mkdir(parents=True,exist_ok=True)
                    require(item['source'].split('/')[0] in payload['aliases'],
                            'Boot refresh attempted to mount a non-destination pool')
                    run('mount','-t','zfs','-o','zfsutil',item['source'],target)
                    mounted_paths.append(target)
            fstab_changed=rewrite_restored_fstab(root,payload.get('fstab_replacements',{}))
            changes=payload.get('guid_changes',{})
            dracut=bool(restored_executable(root,'dracut'))
            if not dracut and not changes and not fstab_changed:
                print(f'{diag_stamp()} Dracut boot preparation skipped: Dracut is not installed; saved initramfs preserved.',flush=True)
                return
            if changes:
                rewrite_boot_pool_guids(root,changes)
                cache=beneath(root,'/etc/zfs/zpool.cache')
                if cache.exists():cache.unlink()
            with timed_phase('Set up isolated boot preparation environment'):
                for entry,kind,options in (('dev','tmpfs','nosuid,mode=755'),
                                       ('proc','proc','nosuid,nodev,noexec'),
                                       ('sys','sysfs','ro,nosuid,nodev,noexec'),
                                       ('run','tmpfs','nosuid,nodev,mode=755'),
                                       ('tmp','tmpfs','nosuid,nodev,mode=1777')):
                    target=beneath(root,'/'+entry);target.mkdir(parents=True,exist_ok=True)
                    run('mount','-t',kind,'-o',options,kind,target);mounted_paths.append(target)
                for name in ('null','zero','random','urandom'):
                    target=beneath(root,'/dev/'+name);target.touch()
                    run('mount','--bind','/dev/'+name,target);mounted_paths.append(target)
                (root/'dev/fd').symlink_to('/proc/self/fd')
            with timed_phase('Rebuild and validate '+('Dracut' if dracut else 'initramfs-tools')+' initramfs'):
                kernels=rebuild_restored_dracut(root) if dracut else rebuild_restored_initramfs_tools(root)
            # Some boot managers load copies from FAT, not /boot. Update only
            # existing copies, using explicit destination partitions (never UUID
            # discovery or proxmox-boot-tool, which could select the live disk).
            copies=0;bios_done=False
            with timed_phase('Update and verify ESP initramfs copies'):
                for device in payload.get('esps',[]):
                    with mounted(device,'rw') as esp:
                        if changes:
                            rewrite_boot_pool_guids(esp,changes,esp=True)
                        if (changes and payload.get('bios') and not bios_done
                                and beneath(root,'/boot/grub/grub.cfg').is_file()):
                            rebuild_restored_bios(root,esp,payload['device'],device,payload['bios'])
                            bios_done=True
                        for path in esp.rglob('*'):
                            if not path.is_file():continue
                            kernel=next((k for k in kernels if path.name=='initrd.img-'+k or
                                         (path.name=='initrd.img' and path.parent.name==k)),None)
                            if kernel:
                                require(not path.is_symlink(),'Symlinked ESP initramfs')
                                shutil.copyfile(beneath(root,'/boot/initrd.img-'+kernel),path)
                                require(digest(path)==digest(beneath(root,'/boot/initrd.img-'+kernel)),
                                        'ESP initramfs verification failed: '+str(path))
                                copies+=1
                if not copies:
                    print(f'{diag_stamp()} No matching ESP initramfs copies to update.',flush=True)
            with timed_phase('Flush boot preparation writes'):
                os.sync()
        finally:
            with timed_phase('Unmount boot preparation filesystems'):
                failures=[]
                for target in reversed(mounted_paths):
                    try:run('umount',target)
                    except (Error,OSError) as exc:failures.append(str(exc))
                require(not failures,'Boot refresh mount cleanup failed: '+'; '.join(failures))
    print(f'{diag_stamp()} {"Dracut" if dracut else "ZFS"} boot preparation completed: {len(kernels)} initramfs image(s) rebuilt; '
          f'{copies} ESP copy/copies updated and verified.',flush=True)


def refresh_restored_dracut(m,restored,device,layout):
    aliases={pool['name']:alias for pool,alias in restored}
    mounts=[]
    for item in sorted(m['mounts'],key=lambda x:(len(Path(x['target']).parts),x['target'])):
        target=item['target']
        # Mount the OS and boot trees, not unrelated user/data filesystems.
        if target!='/' and not any(target==p or target.startswith(p+'/') for p in ('/usr','/etc','/var','/boot')):
            continue
        pool,_,suffix=item['source'].partition('/')
        mounts.append(dict(source=aliases[pool]+('/'+suffix if suffix else ''),target=target))
    payload=dict(mounts=mounts,aliases=list(aliases.values()),timeline_started=DIAGNOSTIC_STARTED,
                 esps=[partition_device(device,p['number']) for p in layout if p['kind']=='esp'])
    payload['fstab_replacements']=restored_fstab_replacements(device,layout)
    payload['guid_changes']={p['guid']:p['_restore_guid'] for p,_ in restored
                             if p.get('_restore_guid',p['guid'])!=p['guid']}
    if payload['guid_changes'] and any(p['kind']=='bios_boot' for p in layout):
        boot=max((item for item in m['mounts'] if item['target']=='/boot/grub'
                  or '/boot/grub'.startswith(item['target'].rstrip('/')+'/')),
                 key=lambda item:len(item['target']))
        name,_,dataset=boot['source'].partition('/')
        pool=next(p for p,_ in restored if p['name']==name)
        suffix='/boot/grub'[len(boot['target'].rstrip('/')):]
        payload['bios']=dict(guid=pool.get('_restore_guid',pool['guid']),prefix='/'+dataset+'@'+suffix)
        payload['device']=device
    for item in mounts:
        if run('zfs','get','-H','-o','value','keystatus',item['source']).strip()=='unavailable':
            encryptionroot=run('zfs','get','-H','-o','value','encryptionroot',item['source']).strip()
            require(encryptionroot.split('/')[0] in aliases.values(),
                    'Encryption root is outside the restored pools')
            print(f'{diag_stamp()} Unlock restored dataset {encryptionroot} for boot preparation.',flush=True)
            result=locked_run(['zfs','load-key','-L','prompt',encryptionroot])
            require(result.returncode==0,'Could not unlock restored OS dataset: '+encryptionroot)
    # runpy keeps this executable self-contained without adding a public command.
    worker="import json,runpy,sys; runpy.run_path(sys.argv[1])['refresh_restored_dracut_worker'](json.load(sys.stdin))"
    print(f'{diag_stamp()} Preparing restored Dracut boot images in a private mount namespace…',flush=True)
    # Inherit output and disable Python buffering so phase starts are visible
    # while work runs, rather than replaying timestamps after the worker exits.
    run('unshare','--mount','--propagation','private',sys.executable,'-u','-c',worker,
        Path(__file__).resolve(),input=json.dumps(payload).encode(),live=True)


def repair_boot(root,m,device,layout):
    # All commands come from the restored installation, including its signed EFI binaries.
    require(os.uname().machine=='x86_64','EFI repair currently supports x86_64 only')
    fstab=beneath(root,'/etc/fstab')
    text=fstab.read_text()
    validate_fstab(text)
    # UUIDs/PARTUUIDs are preserved, so existing UUID references stay valid. Repair direct paths.
    for p in layout:
        text=text.replace(p['source_device'],partition_device(device,p['number']))
    fstab.write_text(text)
    # A root pool GUID must never be copied. Refresh the cache for the newly created pools.
    cache=beneath(root,'/etc/zfs/zpool.cache'); cache.parent.mkdir(parents=True,exist_ok=True)
    for pool in m['pools']:
        run('zpool','set',f'cachefile={cache}',pool['name'])
    proxmox=m['boot'].get('manager')=='proxmox-grub'
    loader_id='proxmox' if proxmox else 'ubuntu'
    installer='grub-install.real' if proxmox else 'grub-install'
    esps=[p for p in layout if p['kind']=='esp']
    if proxmox:
        # Limit hooks to restored ESPs; never refresh unrelated host partitions.
        beneath(root,'/etc/kernel/proxmox-boot-uuids').write_text(''.join(p['fat_uuid']+'\n' for p in esps))
    binds=[]
    try:
        for entry in ('dev','proc','sys','run'):
            target=beneath(root,'/'+entry); target.mkdir(exist_ok=True)
            run('mount','--rbind','/'+entry,target); binds.append(target)
            run('mount','--make-rslave',target)
        generator=rebuild_initramfs(root)
        print(f'Rebuilt initramfs using {generator}')
        run('chroot',root,'update-grub')
        esps=[p for p in layout if p['kind']=='esp']
        if any(p['kind']=='bios_boot' for p in layout) and not proxmox:
            run('chroot',root,installer,'--target=i386-pc','--recheck',device)
        for p in esps:
            esp=beneath(root,f'/run/lllzorb-esp-{p["number"]}'); esp.mkdir(exist_ok=True)
            run('mount',partition_device(device,p['number']),esp)
            try:
                relative='/'+str(esp.relative_to(root))
                extra=[f'--boot-directory={relative}'] if proxmox else []
                if proxmox and any(x['kind']=='bios_boot' for x in layout):
                    run('chroot',root,installer,'--target=i386-pc',*extra,'--recheck',device)
                run('chroot',root,installer,'--target=x86_64-efi',f'--efi-directory={relative}',
                    f'--bootloader-id={loader_id}',*extra,'--no-nvram','--recheck','--uefi-secure-boot')
                # Preserve Secure Boot: prefer the installation's signed shim + GRUB.
                shim=beneath(root,'/usr/lib/shim/shimx64.efi.signed')
                grub=beneath(root,'/usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed')
                require(shim.is_file() and grub.is_file(),'Signed Ubuntu shim/GRUB packages must be installed')
                ubuntu=esp/f'EFI/{loader_id}'; ubuntu.mkdir(parents=True,exist_ok=True)
                fallback=esp/'EFI/BOOT'; fallback.mkdir(parents=True,exist_ok=True)
                shutil.copy2(shim,ubuntu/'shimx64.efi'); shutil.copy2(grub,ubuntu/'grubx64.efi')
                shutil.copy2(shim,fallback/'BOOTX64.EFI'); shutil.copy2(grub,fallback/'grubx64.efi')
                for name in ('grub.cfg','mmx64.efi'):
                    if (ubuntu/name).is_file():
                        shutil.copy2(ubuntu/name,fallback/name)
                require((ubuntu/'grub.cfg').is_file(),'Missing EFI GRUB configuration')
                if Path('/sys/firmware/efi/efivars').is_dir() and shutil.which('efibootmgr'):
                    result=locked_run(['efibootmgr','--create','--disk',device,'--part',str(p['number']),
                        '--label',loader_id,'--loader',f'\\EFI\\{loader_id}\\shimx64.efi'])
                    if result.returncode:
                        print('NVRAM update failed; fallback EFI loader is installed.',file=sys.stderr)
                require((fallback/'BOOTX64.EFI').stat().st_size>0,'Fallback EFI loader missing')
            finally:
                run('umount',esp)
                esp.rmdir()
        if proxmox:
            run('chroot',root,'proxmox-boot-tool','refresh')
            for p in esps:
                with mounted(partition_device(device,p['number'])) as esp:
                    require((esp/'grub/grub.cfg').is_file(), 'Missing synchronized Proxmox GRUB configuration')
    finally:
        for target in reversed(binds):
            run('umount','-R',target)


def pool_guid(name):
    return run('zpool','get','-H','-o','value','guid',name).strip()


def guid_conflicts(manifest):
    rows=run('zpool','list','-H','-o','name,guid').splitlines()
    imported=dict(line.split('\t') for line in rows)
    return [dict(name=name,guid=pool['guid']) for pool in manifest['pools']
            for name,guid in imported.items() if guid==pool['guid']]


def reject_guid_conflicts(conflicts):
    require(not conflicts,'Restore conflicts with an imported pool: '+
            ', '.join(c['name'] for c in conflicts)+
            '. Use a recovery environment without those pools imported; running pool identities will not be changed.')


def transfer_pool_guid(target,original,conflict,journal):
    with local_lock('restore-guid:'+original,wait=True):
        reject_guid_conflicts([conflict] if conflict else [])
        imported=run('zpool','list','-H','-o','name,guid').splitlines()
        require(not any(name!=target and guid==original for name,guid in
                        (line.split('\t') for line in imported)),
                'Restore pool identity is now in use; running pools were not changed')
        state=dict(target=target,target_guid=pool_guid(target),original_guid=original,
                   phase='prepared')
        def save(phase):
            state['phase']=phase
            pending=journal.with_suffix('.pending')
            with open(pending,'w') as f:
                json.dump(state,f,indent=2);f.flush();os.fsync(f.fileno())
            os.replace(pending,journal)
            fd=os.open(journal.parent,os.O_RDONLY)
            try: os.fsync(fd)
            finally: os.close(fd)
        save('prepared')
        run('zpool','reguid','-g',original,target)
        require(pool_guid(target)==original,'Destination GUID assignment failed')
        save('destination-guid-assigned')
        run('zpool','export',target)
        save('complete')


def prepare_restore_compression(pool,alias,existing):
    """Enable compression before receive, honoring saved settings where present."""
    run('zfs','set','compression=lz4',alias)
    for name,properties in sorted(pool['datasets'].items(),key=lambda item:item[0].count('/')):
        if '@' in name:continue
        relative=name[len(pool['name']):]
        if relative not in existing:continue  # New datasets get their properties from receive.
        value=val(properties,'compression')
        if value=='-':continue
        if relative and properties['compression'].get('source','').startswith('inherited from'):
            run('zfs','inherit','compression',alias+relative)
        else:
            run('zfs','set','compression='+value,alias+relative)


def clone_restore(base,m,device,plan,conflicts,remote=None,stack=True):
    with recovery_directory('lllzorb-target-') as altroot:
        return clone_restore_at_root(base,m,device,plan,conflicts,altroot,remote,stack)


def clone_restore_at_root(base,m,device,plan,conflicts,altroot,remote=None,stack=True):
    # Keep new target identities when the original pools are already imported.
    for pool in m['pools']:full_restore_streams(pool,m['snapshot'],remote,stack)
    active=[];restored=[];transferred=TransferTotals()
    try:
        with timed_phase('Create and verify target partition layout'):
            create_layout(device,plan['partitions'],m['disk']['entry_count'])
        for p in plan['partitions']:
            if p['kind']=='esp':
                run('mkfs.fat','-F',str(p['fat_bits']),'-i',p['fat_uuid'].replace('-',''),'-n',p['fat_label'],partition_device(device,p['number']))
                with mounted(partition_device(device,p['number']),'rw') as esp:
                    run('tar','--zstd','--no-same-owner','--no-same-permissions','-xf',base/p['archive'],'-C',esp)
            elif p['kind']=='bios_boot':
                with open(base/p['image'],'rb') as src,open(partition_device(device,p['number']),'r+b',buffering=0) as dst:
                    shutil.copyfileobj(src,dst);os.fsync(dst.fileno())
            elif p['kind']=='swap':
                # Recreate empty swap; never copy live swap contents or activate C.
                run('mkswap','--swapversion','1','--uuid',p['swap_uuid'],
                    '--label',p['swap_label'],partition_device(device,p['number']))
        # MBR executable bytes only: leave the reconstructed GPT/protective MBR intact.
        with open(base/'disk/first-megabyte.bin','rb') as src,open(device,'r+b',buffering=0) as dst:
            dst.write(src.read(440));os.fsync(dst.fileno())
        for pool in m['pools']:
            temporary='restore_'+uuid.uuid4().hex[:16]
            options=['-d','-t',temporary,'-R',str(altroot),'-o',f'ashift={pool["ashift"]}','-o','cachefile=none','-O','mountpoint=none']
            for key,item in pool['properties'].items():
                if key.startswith('feature@') and item['value'] in ('enabled','active'):
                    options+=['-o',key+'=enabled']
                elif key in ('autoexpand','delegation','listsnapshots','failmode'):
                    options+=['-o',key+'='+item['value']]
            run('zpool','create','-f',*options,pool['name'],*[partition_device(device,i) for i in pool['partitions']])
            active.append(temporary)
            if conflicts:
                pool['_restore_guid']=pool_guid(temporary)
                require(pool['_restore_guid']!=pool['guid'],'Destination pool must have a new identity')
            run('zfs','set','sync=disabled',temporary)
            compression=None if pool['name'] in boot_pool_names(m) else pool.get('_restore_compression')
            if pool['name'] not in boot_pool_names(m):
                run('zfs','set','compression='+(compression or 'lz4'),temporary)
            receiver=['zfs','receive','-u','-F','-x','sync','-o','canmount=off','-o','sharenfs=off','-o','sharesmb=off','-o','volmode=none',temporary]
            receive_compression(receiver,compression)
            if stack:
                count=pipe_transfer(native_send(pool,m['snapshot'],**({'remote':remote} if remote else {})),
                                    receiver,pool['estimated_send_bytes'],'Restore '+pool['name'])
            else:
                count=receive_full_restore(pool,m['snapshot'],receiver,False,remote)
            transferred.record(count,temporary,{},raw=pool['encrypted'])
            selected=dict(pool,native_dataset=temporary)
            require(native_dataset_names(selected)==native_expected_names(selected),
                    'Restored dataset inventory differs from selected recovery point')
            mapped=copy.deepcopy(pool)
            mapped['datasets']={temporary+name[len(pool['name']):]:properties for name,properties in pool['datasets'].items()}
            # Set source properties while restored filesystems remain unmounted.
            with timed_phase(f'Restore {pool["name"]} dataset properties'):
                restore_mount_properties(mapped)
            if pool['bootfs']!='-':
                run('zpool','set','bootfs='+temporary+pool['bootfs'][len(pool['name']):],temporary)
            require(run('zpool','list','-H','-o','health',temporary).strip()=='ONLINE','Restored pool is not ONLINE')
            with timed_phase(f'Flush restored {pool["name"]} pool'):
                run('zpool','sync',temporary)
            restored.append((pool,temporary))
        run('sgdisk','--verify',device)
        with timed_phase('Boot preparation total'):
            refresh_restored_dracut(m,restored,device,plan['partitions'])
        for pool,temporary in restored:
            finish_restore_writes(pool,temporary)
        report_destination_compression('Restore',[(pool['name'],temporary) for pool,temporary in restored])
        # Complete every receive before assigning destination identities.
        for pool,temporary in restored:
            autotrim=val(pool['properties'],'autotrim')
            if autotrim!='-':
                run('zpool','set','autotrim='+autotrim,temporary)
            if conflicts:
                require(pool_guid(temporary)==pool['_restore_guid'],'Destination pool identity changed during restore')
                run('zpool','export',temporary)
                active.remove(temporary)
                continue
            journal=remote.journal() if remote else Path(base)/('restore-guid-'+uuid.uuid4().hex+'.json')
            print(f'{diag_stamp()} GUID recovery journal for {pool["name"]}: {journal}')
            with timed_phase(f'Assign and export {pool["name"]} GUID'):
                transfer_pool_guid(temporary,pool['guid'],None,journal)
            active.remove(temporary)
    finally:
        cleanup=[]
        for temporary in reversed(active):
            try:
                if temporary in run('zpool','list','-H','-o','name').splitlines():
                    run('zpool','export',temporary)
            except (Error,OSError) as exc:
                cleanup.append(f'{temporary}: {exc}')
        require(not cleanup,'Restore cleanup needs attention: '+'; '.join(cleanup))
    print(f'{diag_stamp()} Clone restore complete. Destination exported.\n'
          f'{diag_stamp()} Disconnect the clone after completion; use it in place of the original disk when booting.')
    return transferred


def incremental_layout(manifest,device,node):
    """Check existing boot identities; retain all target geometry unchanged."""
    require(int(node['log-sec'])==manifest['disk']['logical_sector_size'],
            'Incremental restore: logical sector sizes do not match')
    actual=read_gpt(device,int(node['log-sec']),int(node['size']))
    expected=sorted(manifest['disk']['partitions'],key=lambda p:p['start_lba'])
    observed=actual['partitions']
    require([p['number'] for p in expected]==[p['number'] for p in observed],
            'Incremental restore: partition numbers/order do not match the backup')
    layout=[]
    for source,target in zip(expected,observed):
        for key in ('type_guid','partuuid','name','attributes'):
            a,b=source[key],target[key]
            if key in ('type_guid','partuuid'):a,b=a.lower(),b.lower()
            require(a==b,f'Incremental restore: partition {source["number"]} {key} differs from backup')
        part=dict(source,**{k:target[k] for k in ('start_lba','end_lba','size_bytes')})
        member=partition_device(device,part['number'])
        labels=dict(line.split('=',1) for line in run('blkid','-p','-o','export',member,check=False).splitlines() if '=' in line)
        if part['kind']=='zfs':
            pool=next(p for p in manifest['pools'] if p['name']==part['pool'])
            require(labels.get('TYPE')=='zfs_member' and labels.get('LABEL')==pool['name']
                    and labels.get('UUID','').isdecimal() and 0<int(labels['UUID'])<2**64,
                    f'Incremental restore: pool identity differs on {member}')
            require(pool.get('_restore_guid',labels['UUID'])==labels['UUID'],
                    'Incremental target pool identity changed during confirmation')
            pool['_restore_guid']=labels['UUID']
        elif part['kind'] in ('esp','swap'):
            prefix='fat' if part['kind']=='esp' else 'swap'
            require(labels.get('TYPE')==('vfat' if prefix=='fat' else 'swap') and
                    labels.get('UUID','').lower()==part[prefix+'_uuid'].lower() and
                    labels.get('LABEL','')==part[prefix+'_label'],
                    f'Incremental restore: filesystem identity differs on {member}')
        else:
            require(not signatures(member),f'Incremental restore: unexpected BIOS partition signature on {member}')
            require(target['start_lba']==source['start_lba'] and target['size_bytes']>=source['size_bytes'],
                    'Incremental restore: BIOS boot metadata requires its original start and sufficient space')
        layout.append(part)
    return layout


def incremental_inventory(root,remote=None):
    execute=remote.run if remote else run
    columns='name,type,guid,createtxg,origin,receive_resume_token,mounted,userrefs,clones'
    rows=execute('zfs','list','-H','-p','-r','-t','filesystem,volume,snapshot','-o',columns,root).splitlines()
    result={}
    for row in rows:
        fields=row.split('\t')
        require(len(fields)==9,'Invalid incremental dataset inventory')
        name,kind,guid,txg,origin,resume,mounted_at,holds,clones=fields
        require(name==root or name.startswith(root+'/') or name.startswith(root+'@'),
                'Incremental inventory escaped the selected pool')
        require(guid.isdigit() and txg.isdigit(),'Missing incremental dataset identity/order')
        relative=name[len(root):]
        require(relative not in result,'Duplicate incremental dataset identity')
        result[relative]=dict(type=kind,guid=guid,txg=int(txg),origin=origin[len(root):]
            if origin.startswith(root+'/') or origin.startswith(root+'@') else origin,
            resume=resume,mounted=mounted_at,holds=holds,
            clones=','.join(n[len(root):] if n.startswith(root+'/') else n for n in clones.split(',')))
    require('' in result,'Missing incremental pool root')
    return result


def incremental_pool_plan(pool,snapshot,source,target,stack=False):
    """Choose the newest shared checkpoint that covers every existing dataset."""
    expected={n[len(pool['native_dataset']):] for n in native_expected_names(pool)}
    datasets={n for n,p in target.items() if p['type']!='snapshot'}
    require(all(p['resume']=='-' and p['mounted']!='yes' for p in target.values()),
            'Incremental restore: target has mounted datasets or an incomplete receive')
    for relative in expected:
        tip=source.get(relative+'@'+snapshot)
        require(tip is not None,f'Missing selected backup snapshot for {pool["name"]+relative}')
        recorded=val(pool['datasets'].get(pool['name']+relative+'@'+snapshot,{}),'guid')
        require(recorded=='-' or tip['guid']==recorded,'Selected backup snapshot identity changed')
        if relative in datasets:
            a,b=source[relative]['origin'],target[relative]['origin']
            require((a==b=='-') or (a in source and b in target and source[a]['guid']==target[b]['guid']),
                    f'Incremental restore: clone origins differ for {pool["name"]+relative}; target unchanged')
    latest=source['@'+snapshot]['txg']
    candidates=sorted((n for n,p in source.items() if n.startswith('@') and p['txg']<=latest),
                      key=lambda n:source[n]['txg'],reverse=True)
    base=None;rollbacks={}
    for candidate in candidates:
        matches={};compatible=True
        for relative in expected:
            start=source.get(relative+candidate)
            if start is None:
                # Replication can seed newly added datasets, but must not
                # silently replace an existing unrelated dataset with a full send.
                if relative in datasets or source[relative]['txg']<=source[candidate]['txg']:
                    compatible=False;break
                continue
            shared=[n for n,p in target.items() if n.split('@',1)[0]==relative
                    and p['type']=='snapshot' and p['guid']==start['guid']]
            if len(shared)!=1 or relative not in datasets or target[relative]['type']!=source[relative]['type']:
                compatible=False;break
            if candidate=='@'+snapshot and relative+candidate in target and relative+candidate!=shared[0]:
                compatible=False;break
            matches[relative]=shared[0]
        if compatible and '' in matches:
            base=candidate[1:];rollbacks=matches;break
    require(base is not None,f'Incremental restore: no usable common snapshot for pool {pool["name"]}; target unchanged')
    extras=datasets-expected
    remove_datasets=sorted(n for n in extras if n.rsplit('/',1)[0] not in extras)
    remove_snapshots=[]
    allowed={p['guid'] for n,p in source.items() if p['type']=='snapshot'
             and n.split('@',1)[0] in expected and p['txg']<=source[n.split('@',1)[0]+'@'+snapshot]['txg']}
    if not stack:
        allowed={source[n+'@'+snapshot]['guid'] for n in expected}
        allowed.update(target[n]['guid'] for n in rollbacks.values())
        for relative in expected:
            origin=source[relative]['origin']
            require(origin=='-' or (origin in source and source[origin]['guid'] in allowed),
                    'Incremental restore needs an older clone origin; use --stack')
    for name,properties in target.items():
        if properties['type']!='snapshot':continue
        dataset=name.split('@',1)[0]
        removed=(dataset in extras or
                 (dataset in rollbacks and properties['txg']>target[rollbacks[dataset]]['txg']) or
                 ((not stack or base!=snapshot) and properties['guid'] not in allowed))
        if removed:
            require(properties['holds']=='0' and properties['clones']=='-',
                    f'Incremental restore: snapshot {pool["name"]+name} has holds or dependent clones; target unchanged')
            remove_snapshots.append(name)
    return dict(base=base,rollbacks=rollbacks,remove_datasets=remove_datasets,
                remove_snapshots=sorted(remove_snapshots),target=target)


@contextlib.contextmanager
def incremental_pools(manifest,device,readonly=True):
    """Import only the selected partitions, without mounting, under temporary names."""
    with contextlib.ExitStack() as stack:
        restored=[]
        targets=[dict(p,guid=p.get('_restore_guid',p['guid'])) for p in manifest['pools']]
        for guid in sorted({p['guid'] for p in targets}):
            stack.enter_context(local_lock('restore-guid:'+guid,description='Restore pool '+guid))
        require(not guid_conflicts(dict(pools=targets)),
                'Incremental target pool identity is already imported. Use full restore to create distinct target pools.')
        for pool in manifest['pools']:
            guid=pool.get('_restore_guid',pool['guid'])
            member=partition_device(device,pool['partitions'][0])
            directory=stack.enter_context(pool_search_directory(member))
            altroot=stack.enter_context(recovery_directory('lllzorb-target-'))
            alias='incremental_'+uuid.uuid4().hex[:16]
            run('zpool','import','-N','-t','-f','-o','cachefile=none','-o','readonly='+('on' if readonly else 'off'),
                '-R',str(altroot),'-d',directory,guid,alias)
            stack.callback(run,'zpool','export',alias)
            require(pool_guid(alias)==guid,'Incremental target pool GUID changed')
            require([os.path.realpath(p) for p in pool_leaves(alias)]==[os.path.realpath(member)],
                    'Incremental target pool is not confined to its selected partition')
            restored.append((pool,alias))
        yield restored


def incremental_send_argv(pool,snapshot,base,remote=None,stack=False):
    argv=native_send_argv(pool,snapshot,remote)
    argv[-1:-1]=['-I' if stack else '-i',pool['native_dataset']+'@'+base]
    return argv


def incremental_plans(manifest,restored,remote=None):
    plans={}
    execute=remote.run if remote else run
    for pool,alias in restored:
        source=incremental_inventory(pool['native_dataset'],remote)
        target=incremental_inventory(alias)
        plan=incremental_pool_plan(pool,manifest['snapshot'],source,target,manifest.get('_restore_stack',False))
        plan['source']=source
        plan['bytes']=0
        if plan['base']!=manifest['snapshot']:
            argv=incremental_send_argv(pool,manifest['snapshot'],plan['base'],remote,manifest.get('_restore_stack',False))
            estimate=execute(*argv[:2],'-n','-P',*argv[2:],combined=True)
            size=re.search(r'^size\s+(\d+)\s*$',estimate,re.M)
            require(size is not None,'Cannot estimate incremental restore stream')
            plan['bytes']=int(size[1])
        available=int(run('zfs','get','-H','-p','-o','value','available',alias).strip())
        require(available>=plan['bytes']+64*MIB,
                f'Incremental restore: insufficient free space in {pool["name"]} for incoming changes and boot preparation')
        current=props('zpool',alias)[alias]
        require(all(val(current,key) in ('enabled','active') for key,item in pool['properties'].items()
                    if key.startswith('feature@') and item['value'] in ('enabled','active')),
                f'Incremental restore: target pool {pool["name"]} lacks required features')
        plans[pool['name']]=plan
    return plans


def sync_boot_tree(source,target):
    """Replace only changed ESP files, and remove files absent from the backup."""
    source=Path(source);target=Path(target)
    for path in sorted(target.rglob('*'),key=lambda p:len(p.parts),reverse=True):
        require(not path.is_symlink(),'Unexpected link in target ESP')
        expected=source/path.relative_to(target)
        if not expected.exists() or path.is_dir()!=expected.is_dir():
            if path.is_dir():path.rmdir()
            else:path.unlink()
        elif path.is_file() and (path.stat().st_size!=expected.stat().st_size or digest(path)!=digest(expected)):
            # Free all replaced files before copying, so a nearly full ESP
            # need only hold the final tree, not both old and new kernels.
            path.unlink()
    for path in sorted(source.rglob('*'),key=lambda p:(len(p.parts),str(p))):
        dest=target/path.relative_to(source)
        if path.is_dir():dest.mkdir(exist_ok=True)
        elif not dest.exists() or path.stat().st_size!=dest.stat().st_size or digest(path)!=digest(dest):
            shutil.copyfile(path,dest)


@contextlib.contextmanager
def incremental_boot_files(base,device,layout):
    with tempfile.TemporaryDirectory(prefix='lllzorb-incremental-efi-') as tmp:
        staged={}
        for part in layout:
            if part['kind']!='esp':continue
            directory=Path(tmp)/str(part['number']);directory.mkdir()
            run('tar','--zstd','--no-same-owner','--no-same-permissions','-xf',Path(base)/part['archive'],'-C',directory)
            # Use a conservative allowance for FAT allocation units and directory
            # entries. Staging and the capacity check do not modify the target.
            needed=sum(align(p.stat().st_size,64*1024) for p in directory.rglob('*') if p.is_file())+MIB
            with mounted(partition_device(device,part['number'])) as esp:
                require(shutil.disk_usage(esp).total>=needed,'Incremental restore: target ESP is too small')
            staged[part['number']]=directory
        yield staged


def update_incremental_boot(base,device,layout,staged):
    for part in layout:
        member=partition_device(device,part['number'])
        if part['kind']=='esp':
            with mounted(member,'rw') as esp:sync_boot_tree(staged[part['number']],esp)
        elif part['kind']=='bios_boot':
            with open(Path(base)/part['image'],'rb') as src,open(member,'r+b',buffering=0) as dst:
                while True:
                    block=src.read(MIB)
                    if not block:break
                    position=dst.tell()
                    if dst.read(len(block))!=block:
                        dst.seek(position);dst.write(block)
                os.fsync(dst.fileno())
    with open(Path(base)/'disk/first-megabyte.bin','rb') as src,open(device,'r+b',buffering=0) as dst:
        boot=src.read(440)
        if dst.read(440)!=boot:dst.seek(0);dst.write(boot)
        os.fsync(dst.fileno())


def apply_incremental_restore(base,manifest,device,layout,restored,plans,staged,remote=None):
    transferred=TransferTotals()
    for pool,alias in restored:
        plan=plans[pool['name']]
        compression=None if pool['name'] in boot_pool_names(manifest) else pool.get('_restore_compression')
        for relative,properties in plan['target'].items():
            if properties['type']!='snapshot':run('zfs','set','sync=disabled',alias+relative)
        autotrim=val(pool['properties'],'autotrim')
        if autotrim!='-':
            run('zpool','set','autotrim=off',alias)
        for relative in plan['remove_datasets']:
            run('zfs','destroy','-r',alias+relative)
        # Roll back each existing dataset separately: rollback -r removes newer
        # snapshots, but does not recursively roll back descendant datasets.
        for relative,snapshot in sorted(plan['rollbacks'].items(),key=lambda p:p[0].count('/'),reverse=True):
            run('zfs','rollback','-r',alias+snapshot)
            desired=relative+'@'+manifest['snapshot']
            if plan['base']==manifest['snapshot'] and snapshot!=desired:
                run('zfs','rename',alias+snapshot,alias+desired)
        remaining=incremental_inventory(alias)
        for snapshot in plan['remove_snapshots']:
            if snapshot in remaining:
                run('zfs','destroy',alias+snapshot)
        if compression:
            current=incremental_inventory(alias)
            datasets=sorted(alias+n for n,p in current.items() if p['type']!='snapshot')
            for start in range(0,len(datasets),128):
                run('zfs','set','compression='+compression,*datasets[start:start+128])
        if plan['base']!=manifest['snapshot']:
            sender=incremental_send_argv(pool,manifest['snapshot'],plan['base'],remote,manifest.get('_restore_stack',False))
            if remote:remote.check_lock();sender=remote.command(*sender)
            run('zfs','set','sync=disabled',alias)
            if pool['name'] not in boot_pool_names(manifest):
                run('zfs','set','compression='+(compression or 'lz4'),alias)
            receiver=['zfs','receive','-u','-F','-x','sync','-o','canmount=off','-o','sharenfs=off',
                      '-o','sharesmb=off','-o','volmode=none',alias]
            receive_compression(receiver,compression)
            before=transfer_snapshot_inventory(alias)
            count=pipe_transfer(sender,receiver,plan['bytes'],'Incremental restore '+pool['name'])
            transferred.record(count,alias,before,raw=pool['encrypted'])
        actual=incremental_inventory(alias)
        if not manifest.get('_restore_stack',False):
            keep={plan['source'][n+'@'+manifest['snapshot']]['guid'] for n in plan['rollbacks']}
            keep.update(plan['target'][n]['guid'] for n in plan['rollbacks'].values())
            keep.update(p['guid'] for n,p in actual.items() if n.endswith('@'+manifest['snapshot']))
            for name,properties in actual.items():
                if properties['type']=='snapshot' and properties['guid'] not in keep:
                    require(properties['holds']=='0' and properties['clones']=='-',
                            'Cannot remove restored history with holds or dependent clones: '+alias+name)
                    run('zfs','destroy',alias+name)
        expected={n[len(pool['native_dataset']):] for n in native_expected_names(pool)}
        require({n for n,p in actual.items() if p['type']!='snapshot'}==expected,
                'Incremental restore dataset inventory differs from selected backup')
        for relative in expected:
            name=relative+'@'+manifest['snapshot']
            require(name in actual and actual[name]['guid']==plan['source'][name]['guid'],
                    'Incremental restore snapshot identity mismatch: '+pool['name']+name)
        mapped=copy.deepcopy(pool)
        mapped['datasets']={alias+n[len(pool['name']):]:ps for n,ps in pool['datasets'].items()}
        restore_mount_properties(mapped)
        if pool['bootfs']!='-':run('zpool','set','bootfs='+alias+pool['bootfs'][len(pool['name']):],alias)
        if autotrim!='-':
            run('zpool','set','autotrim='+autotrim,alias)
        run('zpool','sync',alias)
    update_incremental_boot(base,device,layout,staged)
    with timed_phase('Boot preparation total'):
        refresh_restored_dracut(manifest,restored,device,layout)
    for pool,alias in restored:
        require(run('zpool','list','-H','-o','health',alias).strip()=='ONLINE',
                'Incrementally restored pool is not ONLINE')
        finish_restore_writes(pool,alias)
    report_destination_compression('Restore',[(pool['name'],alias) for pool,alias in restored])
    return transferred


def incremental_restore_from_storage(args,base,manifest,remote=None):
    require(manifest.get('storage')=='native','Incremental restore requires native backup storage')
    require(os.uname().machine=='x86_64','Only x86_64 EFI restoration is supported')
    protected=protected_path(base)
    device=stable_device(args.target or choose_destination('Incremental restore destination',protected))
    with restore_target_lock(device):
        cleanup_orphan_restore_pools(device)
        node=target_idle(device,protected)
        layout=incremental_layout(manifest,device,node)
        print_existing_layout(device,node)
        with incremental_pools(manifest,device) as restored:
            for pool,alias in restored:
                if pool.get('_restore_compression'):
                    check_compression_pool(pool['_restore_compression'],alias)
            plans=incremental_plans(manifest,restored,remote)
        print(f'{diag_stamp()} Incremental restore to {device}: {manifest["snapshot"]}')
        print(f'{diag_stamp()} Existing partition sizes, GPT, swap, and pool identities will be preserved.')
        for pool in manifest['pools']:
            plan=plans[pool['name']]
            print(f'  {pool["name"]}: common snapshot {plan["base"]}; estimated transfer {plan["bytes"]/GIB:.3f} GiB')
            print('    Saved snapshot '+dataset_size_text(saved_snapshot_sizes([pool],manifest['snapshot'])))
            print('    Unsnapshotted target changes will be rolled back.')
            for name in plan['remove_snapshots']:print('    Remove target snapshot: '+pool['name']+name)
            for name in plan['remove_datasets']:print('    Remove target dataset tree: '+pool['name']+name)
        with incremental_boot_files(base,device,layout) as staged:
            phrase=f'INCREMENTAL RESTORE {device}'
            if args.dry_run:
                print(f'Dry run complete. A real incremental restore requires typing: {phrase}')
                return
            if not getattr(args,'unattended',False):
                require(input(f'Target data will be replaced with the selected recovery point.\nType {phrase}: ').strip()==phrase,
                        'Confirmation did not match; aborted')
            start_restore_timeline()
            if getattr(args,'unattended',False):
                print(f'{diag_stamp()} Unattended mode: '+phrase)
            fresh=target_idle(device,protected)
            require(all(fresh.get(k)==node.get(k) for k in ('size','log-sec','phy-sec','serial','wwn','maj:min')),
                    'Incremental target identity changed during confirmation')
            require(incremental_layout(manifest,device,fresh)==layout,'Incremental target layout changed during confirmation')
            # Recheck every pool while still read-only before enabling writes to any.
            with incremental_pools(manifest,device) as restored:
                require(incremental_plans(manifest,restored,remote)==plans,
                        'Incremental target or backup snapshots changed during confirmation')
            with incremental_pools(manifest,device,readonly=False) as restored:
                # Temporary import aliases vary; inventories and plans use relative names.
                require(incremental_plans(manifest,restored,remote)==plans,
                        'Incremental target or backup changed before receive')
                transferred=apply_incremental_restore(base,manifest,device,layout,restored,plans,staged,remote)
        print(f'{diag_stamp()} Incremental restore complete. Target pools exported; partition sizes and swap preserved.')
        return transferred


def restore(args):
    global RESTORE_LOCKS
    previous=RESTORE_LOCKS
    with contextlib.ExitStack() as locks:
        RESTORE_LOCKS=locks
        try:
            target=getattr(args,'target',None)
            if target:locks.enter_context(device_lock(target))
            return restore_locked(args)
        finally:
            RESTORE_LOCKS=previous


def restore_locked(args):
    require(not (getattr(args,'incremental',False) and getattr(args,'swap',None) is not None),
            '--swap applies only to full restore')
    require(not (getattr(args,'incremental',False) and getattr(args,'allow_small_target',False)),
            '--allow-small-target applies only to full restore')
    require(not (getattr(args,'incremental',False) and getattr(args,'discard',None)=='on'),
            '--discard on cannot be used with incremental restore')
    require(not getattr(args,'confirm',False) or getattr(args,'unattended',False),
            '--confirm requires --unattended')
    if getattr(args,'unattended',False):
        require(getattr(args,'backup',None) and getattr(args,'target',None) and getattr(args,'confirm',False),
                '--unattended restore requires --source, --destination, and --confirm')
    commands('lsblk blkid findmnt zpool zfs wipefs zstd tar udevadm mount umount')
    if not getattr(args,'incremental',False):
        commands('sgdisk partprobe mkfs.fat')
    if getattr(args,'remote',None):
        with remote_storage(args) as (base,remote):
            return restore_from_storage(args,base,remote=remote)
    storage=args.backup or choose_backup_storage(for_restore=True)
    with management_storage(storage) as base:
        with repository_reader(base,getattr(args,'host',None),getattr(args,'unattended',False)) as hostdir:
            return restore_from_storage(args,hostdir)


def verify(args):
    commands('lsblk blkid findmnt zpool zfs zstream zstd tar mount umount')
    if getattr(args,'remote',None):
        with remote_storage(args) as (base,remote):
            selected=select_backup(base,args.snapshot,args.list_snapshots,args.host,show_sizes=True,remote=remote)
            if selected is None:return
            print('Verifying remote hashes, complete ZFS data streams, and ESP archives…')
            chain=verify_chain(selected,remote=remote)
            print(f'Verification complete: {chain[-1][1]["snapshot"]}')
        return
    storage=args.backup or choose_backup_storage()
    with management_storage(storage) as base:
        with repository_reader(base,args.host) as base:
            selected=select_backup(base,args.snapshot,args.list_snapshots,args.host)
            if selected is None:
                return
            print('Verifying hashes, complete ZFS data streams, and ESP archives…')
            chain=verify_chain(selected)
            print(f'Verification complete: {chain[-1][1]["snapshot"]}')


def restore_from_storage(args,base,remote=None):
    remote_kw={'remote':remote} if remote else {}
    print('Checking backup metadata, snapshot identities, and ESP archives…')
    selected=select_backup(base,getattr(args,'snapshot',None),getattr(args,'list_snapshots',False),getattr(args,'host',None),show_sizes=True,
                           snapshot_index=getattr(args,'snapshot_index',None),unattended=getattr(args,'unattended',False),
                           stack=getattr(args,'stack',False),**remote_kw)
    if selected is None:
        return
    base=selected
    chain=verify_chain(base,read_native=False,**remote_kw)
    m=copy.deepcopy(chain[-1][1])
    restore_compression(m,getattr(args,'compression',None))
    if getattr(args,'stack',False):m['_restore_stack']=True
    if getattr(args,'unattended',False):
        require(not any(p['encrypted'] for p in m['pools']),
                'Unattended restore of encrypted pools is unsupported: boot preparation may require a key prompt')
    commands('unshare chroot')
    run('unshare','--mount','--propagation','private','true')
    if getattr(args,'incremental',False):
        return incremental_restore_from_storage(args,base,m,remote)
    if any(p['kind']=='swap' for p in m['disk']['partitions']):
        commands('mkswap')
    # Capacity must also cover the largest intermediate state during replay.
    for pool in m['pools']:
        history=[next(p for p in item['pools'] if p['name']==pool['name']) for _,item in chain]
        for key in ('allocated_bytes','used_bytes','logicalused_bytes','estimated_send_bytes'):
            pool[key]=max(p[key] for p in history)
        pool['stream_bytes']=sum(p['stream_bytes'] for p in history)
    if m.get('storage')=='native':
        print('Estimating full restore stream size…')
        for pool in m['pools']:
            pool['estimated_send_bytes']=estimate_native_send(pool,m['snapshot'],stack=getattr(args,'stack',False),**remote_kw)
            pool['stream_bytes']=pool['estimated_send_bytes']
    protected=protected_path(base)
    device=stable_device(args.target or choose_destination('Restore destination',protected))
    with restore_target_lock(device):
        try:
            n=target_idle(device,protected)
        except Error as exc:
            if 'Target belongs to an imported pool' not in str(exc):
                raise
            cleanup_orphan_restore_pools(device)
            n=target_idle(device,protected)
        conflicts=guid_conflicts(m)
        if conflicts:
            print(f'{diag_stamp()} Original pools are imported; using new identities on the restore destination. '
                  'Destination boot files will be updated.')
        require(os.uname().machine=='x86_64','Only x86_64 EFI restoration is supported')
        swap_sizes={} if getattr(args,'swap',None) is not None or getattr(args,'unattended',False) else choose_restore_swap_sizes(m)
        if getattr(args,'swap',None) is not None:
            require(not getattr(args,'incremental',False),'--swap applies only to full restore')
            swap_parts=[p for p in m['disk']['partitions'] if p['kind']=='swap']
            require(len(swap_parts)==1,'--swap requires exactly one swap partition in the backup')
            require(args.swap>0,'--swap must be a positive MB value')
            swap_sizes[swap_parts[0]['number']]=args.swap*MIB
        plan=solve(m,int(n['size']),int(n['log-sec']),swap_sizes=swap_sizes,allow_estimated_overflow=True)
        for part in plan['partitions']:
            if part['kind']=='bios_boot':
                original=next(p for p in m['disk']['partitions'] if p['number']==part['number'])
                start,end=original['start_lba'],original['end_lba']
                require(all(other is part or end<other['start_lba'] or start>other['end_lba'] for other in plan['partitions']),
                        'Original BIOS boot area overlaps reconstructed partitions')
                part['start_lba']=start;part['end_lba']=end

        for p in m['pools']:
            require(2**p['ashift']>=int(n['phy-sec']), 'Target physical sector size exceeds source ashift')
        # Feature compatibility must be established before destruction.
        features=run('zpool','upgrade','-v')
        for pool in m['pools']:
            for key,item in pool['properties'].items():
                if key.startswith('feature@') and item['value'] in ('enabled','active'):
                    require(key[8:] in features, f'Host OpenZFS lacks feature {key}')
        print(f'Recovery host: {m.get("hostname","not recorded")}')
        print(f'Recovery snapshot: {m["snapshot"]} ({len(chain)} backup(s) in chain)')
        print(f'\nSOURCE\n  {m["disk"]["size_bytes"]/GIB:.2f} GiB, {len(m["disk"]["partitions"])} partitions')
        for pool in m['pools']:
            print(f'  {pool["name"]}: saved snapshot '+dataset_size_text(saved_snapshot_sizes([pool],m['snapshot'])))
        print(f'TARGET\n  {device}  {n.get("model") or ""}  {int(n["size"])/GIB:.2f} GiB')
        print_existing_layout(device,n)
        print('\nPROPOSED TARGET LAYOUT')
        for p in plan['partitions']:
            print(f'  p{p["number"]}: {p.get("pool",p["kind"]) } {p["size_bytes"]/GIB:.3f} GiB, LBA {p["start_lba"]}–{p["end_lba"]}')
        for name,estimate in plan['pools'].items():
            size=sum(p['size_bytes'] for p in plan['partitions'] if p.get('pool')==name)
            difference=size-estimate['allocation_bytes']
            space=(f'free before pool overhead {difference/GIB:.2f} GiB' if difference>=0 else
                   f'estimated shortfall {-difference/GIB:.2f} GiB before pool overhead')
            print(f'  {name}: estimated allocation {estimate["allocation_bytes"]/GIB:.2f} GiB; '
                  f'{space}')
        print(f'Estimated minimum target: {plan["minimum_bytes"]/GIB:.2f} GiB')
        require(m.get('storage')=='native','Clone restore requires native backup storage')
        if not conflicts:
            helptext=run('zpool','reguid','-?',check=False,combined=True)
            require('-g' in helptext,'Clone restore requires zpool reguid -g support')
            version=run('zfs','version')
            kernel=re.search(r'zfs-kmod[- ](\d+)\.(\d+)',version)
            require(kernel is not None and tuple(map(int,kernel.groups()))>=(2,3),
                    'Clone restore requires OpenZFS kernel module 2.3 or newer for explicit GUID assignment')
        for p in plan['partitions']:
            if p['kind']=='bios_boot':
                original=next(x for x in m['disk']['partitions'] if x['number']==p['number'])
                require(p['start_lba']==original['start_lba'],'Unchanged BIOS boot metadata requires its original partition position')
        confirm_restore_capacity(plan,args)
        if args.dry_run:
            print(f'Dry run complete. A real restore requires typing: DESTROY')
            return
        discard=choose_restore_discard(args)
        if not getattr(args,'confirm',False):
            confirm(device)
        start_restore_timeline()
        if getattr(args,'confirm',False):
            print(f'{diag_stamp()} Unattended mode: confirmed destruction of {destruction_target(device,n)}')
        fresh=target_idle(device,protected)
        require(all(fresh.get(k)==n.get(k) for k in ('size','log-sec','phy-sec','serial','wwn','maj:min')),
                'Target identity changed during confirmation')
        conflicts=conflicts or guid_conflicts(m)
        if discard:
            discard_restore_target(device)
        else:
            print(f'{diag_stamp()} Discard target blocks: skipped',flush=True)
        return clone_restore(base,m,device,plan,conflicts,stack=getattr(args,'stack',False),**remote_kw)


def snapshot_groups(namespace):
    if isinstance(namespace,(list,tuple)):
        merged={}
        for pool in namespace:
            for group in snapshot_groups(pool):
                previous=merged.get(group['name'])
                if previous is None:
                    merged[group['name']]=group
                else:
                    previous['created']=min(previous['created'],group['created'])
                    previous['snapshots'].extend(group['snapshots'])
        return sorted(merged.values(),key=lambda group:(group['created'],group['name']))
    raw=run('zfs','list','-H','-p','-r','-t','snapshot','-o','name,creation,guid',namespace)
    groups={}
    for line in raw.splitlines():
        fullname,created,guid=line.split('\t')
        dataset,name=fullname.split('@',1)
        require(dataset==namespace or dataset.startswith(namespace+'/'), 'Snapshot outside selected namespace')
        group=groups.setdefault(name,dict(name=name,created=int(created),snapshots=[]))
        group['created']=min(group['created'],int(created))
        group['snapshots'].append((fullname,guid))
    return sorted(groups.values(),key=lambda group:(group['created'],group['name']))


def estimate_snapshot_groups(groups):
    for group in groups:
        datasets={name.split('@',1)[0] for name,_ in group['snapshots']}
        # Compare the same uncompressed, single-snapshot format on both sides.
        # Omit -w/-c and -p: encrypted property-preserving sends require raw
        # mode, which would retain compression and defeat this comparison.
        # Individual sends exclude older history and do not count children twice.
        try:
            total=0
            for dataset in sorted(datasets):
                output=run('zfs','send','-n','-P',dataset+'@'+group['name'],combined=True)
                match=re.search(r'^size\s+(\d+)\s*$',output,re.M)
                require(match is not None,'Could not parse uncompressed snapshot estimate')
                total+=int(match[1])
            group['restore_bytes']=total
        except (Error,OSError):
            group['restore_bytes']=None


def snapshot_size_text(group,backup=False):
    size=group.get('restore_bytes')
    label='Uncompressed ZFS stream'
    return ('  |  '+dataset_size_text(group.get('dataset_sizes',{}))+
            (f'  |  {label}: ~{size/GIB:.3f} GiB' if size is not None
             else f'  |  {label} size unavailable'))


def purge_range(value,count):
    match=re.fullmatch(r'(\d+)-(\d+)',value.strip())
    require(match is not None, 'Enter a range such as 1-3 (use 2-2 for one snapshot)')
    first,last=map(int,match.groups())
    require(1<=first<=last<=count, 'Snapshot range is outside the displayed list')
    return first-1,last


def inspect_purge(selected,backup=False):
    for group in selected:
        for snapshot,guid in group['snapshots']:
            actual=run('zfs','get','-H','-o','value','guid',snapshot).strip()
            require(actual==guid,'Snapshot changed since listing: '+snapshot)
            require(run('zfs','get','-H','-o','value','clones',snapshot).strip()=='-',
                    'Snapshot has dependent clones; cannot purge: '+snapshot)
            require(run('zfs','get','-H','-o','value','defer_destroy',snapshot).strip()=='off',
                    'Snapshot is pending deferred destruction: '+snapshot)
            holds=run('zfs','holds','-H',snapshot).splitlines()
            tags=[line.split('\t')[1] for line in holds]
            allowed={'linux_os_backup'} if backup else set()
            require(set(tags)<=allowed,'Snapshot has another hold; cannot purge: '+snapshot)


def retire_recovery_points(hostdir,selected,native_namespace):
    names={group['name'] for group in selected}
    points=[]
    for directory,m in catalog(hostdir):
        if m['snapshot'] not in names:
            continue
        require(m.get('storage')=='native' and m['native_root'].startswith(native_namespace+'/'),
                'Recovery metadata does not match the selected native host namespace')
        verify_backup(directory,read_native=False)
        points.append(directory)
    return points


def purge_snapshots(groups,range_text,backup=False,hostdir=None,namespace=None,dry_run=False):
    first,last=purge_range(range_text,len(groups));selected=groups[first:last]
    print('Snapshots selected for deletion:')
    for group in selected:
        print(f'  {group["name"]}  {local_snapshot_time(group["created"])} ({len(group["snapshots"])} dataset snapshots){snapshot_size_text(group,backup)}')
    print('This deletes the selected snapshot names on all datasets listed in these groups.')
    print('Sizes are full stream estimates, not space that deletion will reclaim.')
    external=[g for g in selected if not re.fullmatch(SNAPSHOT_PATTERN,g['name'])]
    for group in external:
        print('WARNING: Deleting externally named snapshot '+group['name']+
              ' removes its recovery history, which may contain changes absent from backup checkpoints.')
        for snapshot,_ in group['snapshots']:
            dataset=snapshot.split('@',1)[0]
            checkpoints=[g['created'] for g in groups if re.fullmatch(SNAPSHOT_PATTERN,g['name'])
                         and any(n.split('@',1)[0]==dataset for n,_ in g['snapshots'])]
            if any(t<group['created'] for t in checkpoints) and any(t>group['created'] for t in checkpoints):
                print('WARNING: '+group['name']+' is an intermediate snapshot between backup checkpoints.')
                break
    if not backup:
        print('The next backup will use an older common snapshot if available, otherwise start a full backup.')
    else:
        print('Matching recovery points will be removed from restore selection; metadata is retained for audit.')
        print('Deleting the current base may require a new full backup; automatic backup branches are unsupported.')
    inspect_purge(selected,backup)
    points=retire_recovery_points(hostdir,selected,namespace) if backup else []
    if dry_run:
        print('Dry run: no snapshots, holds, or recovery-point metadata changed.')
        return
    phrase='PURGE '+range_text.strip()
    require(input(f'Type {phrase} to delete these snapshots: ').strip()==phrase,'Purge cancelled')
    # Recheck GUIDs, holds, and clones after the operator confirms the fixed list.
    inspect_purge(selected,backup)
    if backup:
        latest={}
        for group in groups:
            for snapshot,_ in group['snapshots']:
                latest[snapshot.split('@',1)[0]]=snapshot
        selected_names={snapshot for group in selected for snapshot,_ in group['snapshots']}
        invalidated=set()
        for dataset,snapshot in latest.items():
            if namespace and snapshot in selected_names and dataset.startswith(namespace+'/'):
                relative=dataset[len(namespace)+1:].split('/')
                if len(relative)>=2:
                    invalidated.add(namespace+'/'+relative[0])
        for generation in sorted(invalidated):
            run('zfs','set','org.linux-os-backup:pending=purged-latest-snapshot',generation)
    for directory in points:
        os.replace(directory/'SHA256SUMS',directory/'SHA256SUMS.purged')
    destroyed=0
    try:
        for group in selected:
            # Exact names: never recursive deletion that could reach unlisted snapshots/clones.
            for snapshot,guid in sorted(group['snapshots'],key=lambda item:item[0].count('/'),reverse=True):
                holds=run('zfs','holds','-H',snapshot).splitlines() if backup else []
                ours=any(line.split('\t')[1]=='linux_os_backup' for line in holds)
                if ours:
                    run('zfs','release','linux_os_backup',snapshot)
                try:
                    run('zfs','destroy',snapshot)
                except BaseException:
                    if ours:
                        run('zfs','hold','linux_os_backup',snapshot,check=False)
                    raise
                destroyed+=1
    except BaseException:
        print(f'Purge stopped after deleting {destroyed} dataset snapshots. Recovery metadata already retired stays retired.',file=sys.stderr)
        raise
    print(f'Purged {len(selected)} snapshot groups ({destroyed} dataset snapshots). Datasets remain intact.')


def manage_snapshot_list(namespace,range_text=None,backup=False,hostdir=None,dry_run=False):
    groups=snapshot_groups(namespace)
    if groups:
        print('Estimating uncompressed ZFS streams for each snapshot…')
        estimate_snapshot_groups(groups)
        for group in groups:
            group['dataset_sizes']=snapshot_dataset_sizes(name for name,_ in group['snapshots'])
    display=', '.join(namespace) if isinstance(namespace,(list,tuple)) else namespace
    print(f'\nSnapshots in {display} (oldest first):')
    for number,group in enumerate(groups,1):
        created=local_snapshot_time(group['created'])
        print(f'{number}. {group["name"]}  {created}  {len(group["snapshots"])} dataset(s){snapshot_size_text(group,backup)}')
    if not groups:
        print('No snapshots found.');return
    print('Sizes use the same uncompressed stream format on source and backup; older snapshot history is excluded.')
    print('Dataset sizes sum referenced and logicalreferenced bytes at each snapshot; shared blocks may be counted more than once.')
    print('All copies in each group are counted. EFI/BIOS data and filesystem overhead are additional.')
    print('These are comparison estimates; actual transfer sizes depend on the send options used.')
    print('These are not estimates of space reclaimed by purging.')
    answer=range_text if range_text is not None else input('Range to purge (e.g. 1-3; Enter to leave unchanged): ').strip()
    if not answer:
        return
    purge_snapshots(groups,answer,backup,hostdir,namespace,dry_run)


def management_host(repository,host=None):
    repository=Path(repository).expanduser().resolve()
    if repository.parent.name=='hosts':
        require(host is None or host==repository.name,'Host does not match directory')
        host=repository.name;repository=repository.parent.parent
    hosts=repository/'hosts'
    require(hosts.is_dir() and not hosts.is_symlink(),'No safe hosts directory in this repository')
    choices=sorted(p.name for p in hosts.iterdir() if p.is_dir() and not p.is_symlink())
    require(choices,'No backup hosts found')
    if host is None:
        for i,name in enumerate(choices,1):print(f'{i}. {name}')
        if len(choices)==1:
            host=choices[0]
            print(f'Automatically selected host: {host}')
        else:
            answer=input('Host (name or number): ').strip()
            host=choices[int(answer)-1] if answer.isdigit() and 1<=int(answer)<=len(choices) else answer
    valid_hostname(host);require(host in choices,'Host not found')
    dataset,_=zfs_repository(repository)
    mounted_at=json.loads(run('findmnt','-J','-T',str(repository)))['filesystems'][0]['target']
    relative=str(repository.relative_to(Path(mounted_at).resolve()))
    key=hashlib.sha256(relative.encode()).hexdigest()[:16]
    namespace=f'{dataset}/linux_os_backup/{key}/{host}'
    require(run('zfs','get','-H','-o','value','org.linux-os-backup:managed',namespace).strip()=='on',
            'Host native namespace is not managed by this utility')
    return repository,hosts/host,namespace


@contextlib.contextmanager
def management_storage(path):
    path=Path(path).expanduser()
    if path.exists() and stat.S_ISBLK(path.stat().st_mode):
        with existing_store(stable_device(path),None) as mounted_path:
            yield mounted_path
    else:
        raise Error('Backup storage must be a whole disk device; directory inputs are not supported')


def choose_backup_storage(*,for_restore=False):
    while True:
        disks=[]
        for disk in inventory()['blockdevices']:
            if disk['type']!='disk' or is_zvol(disk):
                continue
            labels=sorted({node.get('label') for node in tree_nodes([disk])
                           if node.get('fstype')=='zfs_member' and
                           (node.get('label') or '').startswith(('linux_os_backup_','baremetal_store_'))})
            if labels:
                disks.append((disk,labels))
            else:
                try:
                    target_idle(disk['path'])
                except (Error,OSError):
                    continue
                disks.append((disk,[]))
        disks.sort(key=lambda item:(not bool(item[1]),item[0]['path']))
        backups=[disk for disk,labels in disks if labels]
        default=backups[0]['path'] if len(backups)==1 else None
        if disks:
            print('\nAvailable backup sources:' if for_restore else '\nAvailable backup targets:')
            choices=[]
            for disk,labels in disks:
                if labels:
                    status='Existing backup disk; '+', '.join(labels)
                else:
                    nonempty=bool(disk.get('children') or signatures(disk['path']))
                    status='Other disk; '+('contains data' if nonempty else 'empty')
                if disk['path']==default:status+=' (default)'
                choices.append((disk,status))
            print_disk_choices(choices)
        if backups:
            break
        print('No recognized backup sources found. Attach a backup disk.' if for_restore else
              'No recognized backup disks found. Other disks are shown as optional targets. Attach a backup disk.')
        while True:
            answer=input('Press Enter to refresh, or q to quit (or select a displayed backup disk): ').strip().lower()
            if answer=='q':
                raise Cancelled('Backup disk selection cancelled.')
            if not answer:
                break
            if answer.isdigit():
                require(1<=int(answer)<=len(disks),'Backup disk number is outside the displayed list')
                require(disks[int(answer)-1][1],'Selected disk has no backups to read')
                return disks[int(answer)-1][0]['path']
            print('Press Enter to refresh, or type q to quit (or select a displayed backup disk).')
    if len(disks)==1 or (for_restore and len(backups)==1):
        selected=backups[0]['path']
        print(f'Automatically selected backup {"source" if for_restore else "disk"}: {selected}')
        return selected
    default_number=next((i for i,(disk,_) in enumerate(disks,1) if disk['path']==default),None)
    prompt='Backup source disk number or device' if for_restore else 'Existing backup disk number or device'
    answer=input(prompt+(f' [{default_number}]' if default_number else '')+': ').strip()
    if not answer and default:
        return default
    if answer.isdigit():
        require(1<=int(answer)<=len(disks),'Backup disk number is outside the displayed list')
        require(disks[int(answer)-1][1],'Selected disk has no backups to read')
        return disks[int(answer)-1][0]['path']
    require(bool(answer),'No backup storage selected')
    return answer


def source_snapshot_pools(rootpool):
    boot=json.loads(run('findmnt','-J','-T','/boot'))['filesystems'][0]
    if boot['fstype']!='zfs' or boot['source'].split('/')[0]==rootpool:
        return rootpool
    require('[' not in boot['source'],'ZFS bind mounts require manual recovery')
    bootpool=boot['source'].split('/')[0]
    rootleaves=pool_leaves(rootpool);bootleaves=pool_leaves(bootpool)
    require(len(rootleaves)==len(bootleaves)==1 and
            disk_for(rootleaves[0])==disk_for(bootleaves[0]),
            'Source snapshot management requires root and boot pools on the same disk')
    return [rootpool,bootpool]


def snapshots_main(args):
    try:
        require(os.geteuid()==0,'Run as root')
        commands('zfs zpool findmnt')
        if not args.source and args.backup is None:
            print('Manage snapshots:\n1. source disk\n2. backup disk')
            choice=input('Choice (1 or 2): ').strip()
            require(choice in ('1','2'),'Choose 1 or 2')
            args.source=choice=='1'
            if not args.source:
                args.backup=''
        if args.source:
            commands('lsblk')
            require(args.host is None,'--host applies only to backup snapshot management')
            mount=json.loads(run('findmnt','-J','-T','/'))['filesystems'][0]
            require(mount['fstype']=='zfs','Running root filesystem is not ZFS')
            pool=mount['source'].split('/')[0]
            manage_snapshot_list(source_snapshot_pools(pool),args.purge,dry_run=args.dry_run)
        else:
            commands('lsblk blkid mount umount')
            if not args.backup:
                args.backup=choose_backup_storage()
            with management_storage(args.backup) as storage:
                repository,hostdir,namespace=management_host(storage,args.host)
                with repository_lock(repository),repository_lock(hostdir,name='.host.lock'):
                    manage_snapshot_list(namespace,args.purge,True,hostdir,args.dry_run)
    except (Error,OSError,ValueError,KeyError,TypeError,EOFError) as exc:
        print(f'ERROR: {exc}',file=sys.stderr);return 1
    except KeyboardInterrupt:
        print('Snapshot management interrupted; review any partial purge reported above.',file=sys.stderr);return 130
    return 0


def clone_layout(size,sector,required):
    require(sector in (512,4096),'Unsupported target sector size')
    start=MIB//sector;end=(size-MIB)//sector-1
    capacity=(end-start+1)*sector
    require(capacity>=max(128*MIB,required+64*MIB),
            f'Target too small for estimated backup contents ({required/GIB:.2f} GiB plus metadata)')
    return [dict(number=1,start_lba=start,end_lba=end,size_bytes=capacity,type_guid=ZFS,
                 name='ZFS backup storage',partuuid=str(uuid.uuid4()),attributes=0)]


def backup_manifests(repository):
    return sorted(Path(repository).glob('**/hosts/*/backup-*/manifest.json'))


def rebase_manifest(m,old_pool,new_pool,new_guid):
    result=copy.deepcopy(m)
    if result.get('storage')!='native':
        return result
    def mapped(dataset):
        require(dataset.startswith(old_pool+'/'),'Manifest refers to native data outside the source pool')
        return new_pool+dataset[len(old_pool):]
    result['native_root']=mapped(result['native_root'])
    for pool in result['pools']:
        pool['native_dataset']=mapped(pool['native_dataset'])
    result['storage_pool_guid']=new_guid
    return result


def rebase_clone_metadata(root,old_pool,new_pool,new_guid):
    points=[]
    for manifest in backup_manifests(root):
        require(not manifest.is_symlink(),'Symlinked clone manifest')
        m=json.loads(manifest.read_text());validate(m)
        updated=rebase_manifest(m,old_pool,new_pool,new_guid)
        if updated.get('storage')=='native' and 'parent' in updated:
            parent_name=safe_rel(updated['parent'])
            require(len(parent_name.parts)==1,'Unsafe cloned parent reference')
            parent_manifest=manifest.parent.parent/parent_name/'manifest.json'
            if parent_manifest.is_file():
                updated['parent_manifest_sha256']=digest(parent_manifest)
        manifest.write_text(json.dumps(updated,indent=2)+'\n')
        # Preserve all recorded artifact hashes except the intentionally changed manifest.
        for filename in ('SHA256SUMS','SHA256SUMS.purged','SHA256SUMS.pending'):
            sums=manifest.parent/filename
            if not sums.is_file():
                continue
            require(not sums.is_symlink(),'Symlinked checksum file')
            lines=sums.read_text().splitlines();new=[];found=False
            for line in lines:
                match=re.fullmatch(r'([0-9a-f]{64})  (.+)',line)
                require(match is not None,'Malformed checksum file in cloned metadata')
                if match[2]=='manifest.json':
                    new.append(digest(manifest)+'  manifest.json');found=True
                else:
                    new.append(line)
            require(found,'Cloned manifest missing its checksum')
            sums.write_text('\n'.join(new)+'\n')
        if (manifest.parent/'SHA256SUMS').is_file():
            points.append(manifest.parent)
    return points


def snapshot_guid_map(pool,skip_snapshot=None):
    rows=run('zfs','list','-H','-r','-t','snapshot','-o','name,guid',pool).splitlines()
    result={}
    for row in rows:
        name,guid=row.split('\t')
        if skip_snapshot and name.endswith('@'+skip_snapshot):
            continue
        require(name.startswith(pool+'/') or name.startswith(pool+'@'),'Snapshot outside clone pool')
        result[name[len(pool):]]=guid
    return result


def clone_snapshot_holds(pool,snapshots):
    result={}
    for relative in snapshots:
        rows=run('zfs','holds','-H',pool+relative).splitlines()
        result[relative]=sorted(line.split('\t')[1] for line in rows)
    return result


def clone_backup(args):
    commands('lsblk blkid findmnt wipefs zfs zpool sgdisk partprobe udevadm mount umount')
    source=stable_device(args.source or choose_backup_storage())
    source_node=node_for(source)
    require(source_node['type']=='disk','Clone source must be a whole backup disk')
    target=stable_device(args.target or choose_destination('Clone target',[source]))
    target_node=target_idle(target,[source])
    new_pool='linux_os_backup_'+uuid.uuid4().hex[:10]
    with device_lock(target),management_storage(source) as repository,repository_lock(repository), \
         repository_lock(repository,name='.readers.lock'):
        old_pool,old_guid=zfs_repository(repository)
        require('/' not in old_pool,'Clone source must mount the backup pool root dataset')
        properties=props('zpool',old_pool)[old_pool]
        require(val(properties,'health')=='ONLINE','Source backup pool is not ONLINE')
        dataset_props=props('zfs',old_pool,True)
        # -w preserves compression/encryption. Full replication also includes old snapshots.
        required=max(int(val(properties,'allocated')),int(val(dataset_props[old_pool],'used')),
                     int(val(dataset_props[old_pool],'logicalused')))
        layout=clone_layout(int(target_node['size']),int(target_node['log-sec']),required)
        originals=snapshot_guid_map(old_pool)
        original_holds=clone_snapshot_holds(old_pool,originals)
        for name in dataset_props:
            if '@' not in name and name!=old_pool:
                require(name==old_pool+'/linux_os_backup' or name.startswith(old_pool+'/linux_os_backup/'),
                        'Clone source contains datasets outside the managed backup namespace')
        for manifest in backup_manifests(repository):
            m=json.loads(manifest.read_text());validate(m)
            rebase_manifest(m,old_pool,new_pool,'0')
            if (manifest.parent/'SHA256SUMS').is_file():
                verify_backup(manifest.parent,read_native=False)
        print(f'CLONE SOURCE: {source} ({old_pool}), {int(source_node["size"])/GIB:.2f} GiB')
        print(f'CLONE TARGET: {target} ({target_node.get("model") or ""}), {int(target_node["size"])/GIB:.2f} GiB')
        print_existing_layout(target,target_node)
        print(f'Estimated contents: {required/GIB:.2f} GiB; new pool: {new_pool}')
        print('All hosts, native datasets, snapshots, snapshot holds, and repository files will be copied.')
        if args.dry_run:
            print('Dry run: no source snapshot or destination writes. Actual cloning requires DESTROY.')
            return
        # Snapshot the whole storage pool, including its metadata filesystem, before copying.
        checkpoint='backup-copy-'+uuid.uuid4().hex
        created=False;target_mounted=False
        run('zfs','snapshot','-r',old_pool+'@'+checkpoint)
        try:
            estimate=run('zfs','send','-n','-P','-R','-w','-h',old_pool+'@'+checkpoint,combined=True)
            match=re.search(r'^size\s+(\d+)\s*$',estimate,re.M)
            require(match is not None,'Cannot estimate clone replication stream')
            stream_size=int(match[1])
            clone_layout(int(target_node['size']),int(target_node['log-sec']),max(required,stream_size))
            print(f'Estimated replication stream: {stream_size/GIB:.2f} GiB')
            confirm(target)
            current=target_idle(target,[source])
            require(all(current.get(k)==target_node.get(k) for k in ('size','log-sec','phy-sec','serial','wwn','maj:min')),
                    'Clone target identity changed during confirmation')
            with recovery_directory('lllzorb-clone-') as root:
                try:
                    create_layout(target,layout,128)
                    options=['-d','-o','cachefile=none','-o',f'ashift={max(12,int(target_node["phy-sec"]).bit_length()-1)}']
                    for key,item in properties.items():
                        if key.startswith('feature@') and item['value'] in ('enabled','active'):
                            options+=['-o',key+'=enabled']
                    run('zpool','create','-f',*options,'-O','mountpoint=none','-O','volmode=none',
                        new_pool,partition_device(target,1))
                    created=True
                    pipe_transfer(['zfs','send','-R','-w','-h',old_pool+'@'+checkpoint],
                        ['zfs','receive','-F','-u','-x','mountpoint','-x','sharenfs','-x','sharesmb','-x','volmode',new_pool],
                        stream_size,'Clone backup disk')
                    new_guid=run('zpool','get','-H','-o','value','guid',new_pool).strip()
                    require(new_guid!=old_guid,'Clone must have a distinct pool GUID')
                    require(snapshot_guid_map(new_pool,checkpoint)==originals,'Cloned snapshot GUID inventory does not match source')
                    require(clone_snapshot_holds(new_pool,originals)==original_holds,'Cloned snapshot holds do not match source')
                    run('zfs','destroy','-r',new_pool+'@'+checkpoint)
                    run('zfs','set','readonly=off','canmount=noauto','mountpoint=legacy',new_pool)
                    mount_zfs_at(new_pool,root);target_mounted=True
                    points=rebase_clone_metadata(root,old_pool,new_pool,new_guid)
                    for point in points:
                        verify_backup(point,read_native=False)
                    run('zpool','sync',new_pool)
                    require(run('zpool','list','-H','-o','health',new_pool).strip()=='ONLINE','Clone pool is not ONLINE')
                    run('sgdisk','--verify',target)
                finally:
                    cleanup=[]
                    if target_mounted:
                        try: run('umount',root);target_mounted=False
                        except Error as exc: cleanup.append(str(exc))
                    if created:
                        try: run('zpool','export',new_pool);created=False
                        except Error as exc: cleanup.append(str(exc))
                    require(not cleanup,'Clone cleanup needs attention: '+'; '.join(cleanup))
        finally:
            run('zfs','destroy','-r',old_pool+'@'+checkpoint)
        print(f'Backup clone complete: {target}, pool {new_pool} (exported). Source backups retained.')


